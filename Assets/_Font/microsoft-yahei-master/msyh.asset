      = \u4E09\u5934\u5DE8\u517D\uFF0C\u7531\u9AA8\u9ABC\u3001\u8840\u8089\u548C\u65E0\u60C5\u7684\u94A2\u94C1\u953B\u9020\u800C\u6210\uFF0C\u5DCD\u7136\u8038\u7ACB\u3002\u6BCF\u4E2A\u5934\u9885\u90FD\u8BC9\u8BF4\u7740\u4E0D\u540C\u7684\u771F\u76F8\uFF1A\u6124\u6012\u3001\u667A\u6167\u548C\u610F\u5FD7\u2014\u2014\u5B83\u4EEC\u6C38\u4E0D\u8A00\u548C\uFF0C\u5374\u53C8\u59CB\u7EC8\u56E2\u7ED3\u4E00\u81F4\uFF0C\u5171\u540C\u6BC1\u706D\u3002\u5B83\u66FE\u662F\u8106\u5F31\u7684\u5E7C\u4F53\uFF0C\u5982\u4ECA\u5DF2\u5316\u8EAB\u4E3A\u4E00\u53F0\u6D3B\u751F\u751F\u7684\u6218\u4E89\u673A\u5668\uFF0C\u7531\u8150\u5316\u7684\u5143\u7D20\u6838\u5FC3\u548C\u8FDC\u53E4\u79D1\u6280\u9A71\u52A8\uFF0C\u540E\u8005\u65E9\u5DF2\u88AB\u4EBA\u4EEC\u89C6\u4E3A\u5931\u843D\u3002\u4F20\u8BF4\u53EA\u6709\u610F\u5FD7\u575A\u5B9A\u7684\u540E\u88D4\u624D\u80FD\u63A7\u5236\u5B83\u7684\u6124\u6012\u2026\u2026\u6216\u5728\u5B83\u7684\u80CC\u53DB\u4E2D\u5E78\u5B58\u4E0B\u6765\u3002\nmonster3_des
      = \u5E03\u9C81\u897F\u514B\u66FE\u662F\u4E00\u53EA\u666E\u901A\u7684\u6797\u5730\u5E7C\u5D3D\uFF0C\u540E\u6765\u88AB\u4E00\u7FA4\u6D41\u6C13\u70BC\u91D1\u672F\u58EB\u6293\u8D70\uFF0C\u7528\u6765\u8BD5\u9A8C\u6325\u53D1\u6027\u5143\u7D20\u8840\u6E05\u3002\u6CE8\u5C04\u7684\u5143\u7D20\u8840\u6E05\u5728\u5B83\u7684\u8840\u7BA1\u4E2D\u6D8C\u52A8\u7740\u5947\u5F02\u7684\u7EFF\u5149\uFF0C\u91CA\u653E\u51FA\u8FDC\u8D85\u5176\u5C0F\u5C0F\u8EAB\u8EAF\u7684\u51F6\u731B\u529B\u91CF\u3002\u867D\u7136\u5E03\u9C81\u897F\u514B\u4ECD\u7136\u4FDD\u7559\u7740\u597D\u5947\u5E7C\u5D3D\u7684\u672C\u80FD\uFF0C\u4F46\u73B0\u5728\u5B83\u7206\u53D1\u51FA\u8D85\u4E4E\u5BFB\u5E38\u7684\u529B\u91CF\u2014\u2014\u5B83\u5904\u4E8E\u66FE\u7ECF\u7684\u91CE\u517D\u548C\u672A\u6765\u53EF\u80FD\u53D8\u6210\u7684\u602A\u7269\u4E4B\u95F4\u3002\nmonster4_des
      = \u968F\u7740\u5E03\u9C81\u897F\u514B\u8FDB\u5316\u4E3A\u5E03\u62C9\u8FEA\u4E9A\u7279\uFF0C\u7A81\u53D8\u6108\u6F14\u6108\u70C8\u2014\u2014\u5B83\u878D\u5408\u4E86\u539F\u59CB\u7684\u808C\u8089\u3001\u88F8\u9732\u7684\u9AA8\u9ABC\u548C\u5267\u6BD2\u7684\u72C2\u6012\uFF0C\u4EE4\u4EBA\u6050\u60E7\u3002\u5728\u4E24\u7F50\u4E0D\u7A33\u5B9A\u8840\u6E05\u7684\u9A71\u52A8\u4E0B\uFF0C\u5E03\u62C9\u8FEA\u4E9A\u7279\u7684\u8EAB\u4F53\u5982\u4ECA\u6E17\u51FA\u7EFF\u8272\u80FD\u91CF\uFF0C\u6BCF\u8D70\u4E00\u6B65\u90FD\u4F1A\u707C\u70E7\u5730\u9762\u3002\u5B83\u7684\u5486\u54EE\u6563\u64AD\u6050\u614C\uFF0C\u5B83\u7684\u653B\u51FB\u7559\u4E0B\u8150\u8680\u7684\u75D5\u8FF9\u3002\u5E7C\u5D3D\u66FE\u7ECF\u62E5\u6709\u7684\u7EAF\u771F\u5DF2\u88AB\u5C42\u5C42\u75DB\u82E6\u63A9\u57CB\uFF0C\u53EA\u5269\u4E0B\u4E00\u4E2A\u7531\u70BC\u91D1\u672F\u548C\u75DB\u82E6\u5851\u9020\u7684\u65E0\u60C5\u6355\u98DF\u8005\u3002\nmonster5_des
      = \u5E03\u9C81\u6258\u514B\u8428\u662F\u8086\u610F\u5B9E\u9A8C\u7684\u7EC8\u6781\u4EA7\u7269\uFF0C\u5B83\u5982\u540C\u4E00\u5934\u7531\u91D1\u5C5E\u3001\u6BD2\u7D20\u548C\u72C2\u6012\u7EC4\u6210\u7684\u5E9E\u7136\u5DE8\u517D\u3002\u5B83\u88C5\u7532\u7684\u5934\u9AA8\u4E0A\u957F\u7740\u4E00\u53EA\u5F3A\u5316\u7684\u7284\u89D2\uFF0C\u952F\u9F7F\u72B6\u7684\u94A2\u94C1\u7360\u7259\u5219\u80FD\u6495\u788E\u6321\u8DEF\u7684\u4E00\u5207\u3002\u5B83\u80CC\u4E0A\u7684\u7F50\u5B50\u5C06\u6E90\u6E90\u4E0D\u65AD\u7684\u6325\u53D1\u6027\u8840\u6E05\u6CF5\u5165\u8840\u6DB2\uFF0C\u4F7F\u5176\u6301\u7EED\u5904\u4E8E\u72C2\u66B4\u7684\u53D8\u5F02\u72B6\u6001\u3002\u5E03\u9C81\u6258\u514B\u8428\u4E0D\u518D\u611F\u5230\u6050\u60E7\uFF0C\u4E5F\u4E0D\u518D\u611F\u5230\u75DB\u82E6\u3002\u5B83\u7684\u5B58\u5728\u53EA\u4E3A\u72C2\u66B4\uFF0C\u5982\u540C\u4E00\u4EF6\u51E0\u4E4E\u65E0\u6CD5\u6291\u5236\u7684\u6D3B\u751F\u751F\u7684\u6B66\u5668\u3002\nmonster6_des
      = \u522B\u88AB\u540D\u5B57\u9A97\u4E86\u2014\u2014\u6BDB\u6BDB\u725B\uFF0C\u6D51\u8EAB\u62AB\u7740\u6BDB\uFF0C\u610F\u5FD7\u575A\u5F3A\u3002\u8FD9\u4F4D\u5F3A\u58EE\u7684\u89D2\u6597\u58EB\u51FA\u751F\u4E8E\u98CE\u66B4\u4FB5\u8680\u7684\u9AD8\u5730\uFF0C\u4ECE\u5C0F\u5C31\u63A5\u53D7\u6B8B\u9177\u7684\u4EEA\u5F0F\u8BAD\u7EC3\uFF0C\u78E8\u7EC3\u529B\u91CF\u548C\u8010\u529B\u3002\u6BDB\u6BDB\u725B\u62F3\u5982\u5DE8\u77F3\uFF0C\u5FC3\u810F\u6BD4\u5DE8\u77F3\u5927\u4E00\u500D\uFF0C\u4ED6\u52C7\u5F80\u76F4\u524D\uFF0C\u8FCE\u63A5\u4EFB\u4F55\u6311\u6218\uFF0C\u6E34\u671B\u8BC1\u660E\u5373\u4F7F\u662F\u6700\u5F31\u5C0F\u7684\u6218\u58EB\u4E5F\u80FD\u64BC\u52A8\u5927\u5730\u3002\u4ED6\u5FE0\u8BDA\u3001\u4EFB\u6027\uFF0C\u800C\u4E14\u7B56\u7565\u6027\u60CA\u4EBA\uFF0C\u662F\u6240\u6709\u52C7\u6562\u8D62\u5F97\u4ED6\u5C0A\u656C\u7684\u540E\u88D4\u7684\u575A\u5B9A\u4F19\u4F34\u3002\nmonster7_des
      = \u5386\u7ECF\u6218\u706B\u78E8\u783A\uFF0C\u5E03\u62C9\u65AF\u624E\u592B\u662F\u5F17\u6D1B\u6CD5\u7F57\u4E0D\u5C48\u610F\u5FD7\u7684\u5316\u8EAB\u3002\u5982\u4ECA\uFF0C\u4ED6\u7684\u8EAB\u8EAF\u808C\u8089\u53D1\u8FBE\uFF0C\u76D4\u7532\u4E0A\u954C\u523B\u7740\u90E8\u843D\u7684\u80DC\u5229\u6807\u5FD7\uFF0C\u5C3E\u5DF4\u5C16\u71C3\u8D77\u4E00\u56E2\u706B\u7130\uFF0C\u968F\u7740\u4ED6\u6012\u706B\u7684\u5347\u817E\u800C\u6108\u53D1\u660E\u4EAE\u3002\u5E03\u62C9\u65AF\u624E\u592B\u4E0D\u518D\u53EA\u662F\u4E00\u4E2A\u610F\u5FD7\u575A\u5B9A\u7684\u6597\u58EB\uFF0C\u4ED6\u4EE5\u8363\u8A89\u4E3A\u5148\uFF0C\u4EE5\u96EA\u5D29\u822C\u7684\u529B\u91CF\u548C\u7ECF\u9A8C\u4E30\u5BCC\u7684\u6218\u58EB\u822C\u7684\u7CBE\u51C6\u51FA\u51FB\u3002\u5F53\u4ED6\u6218\u6597\u65F6\uFF0C\u4ED6\u4E0D\u4EC5\u662F\u4E3A\u4E86\u80DC\u5229\uFF0C\u4E5F\u662F\u4E3A\u4E86\u4F20\u627F\u3002\nmonster8_des
      = \u8EAB\u62AB\u6218\u7532\u7684\u706B\u9F99\uFF0C\u5982\u540C\u6D3B\u751F\u751F\u7684\u70C8\u7130\uFF0C\u662F\u5F17\u6D1B\u6CD5\u7F57\u70C8\u7130\u8840\u7EDF\u7684\u5DC5\u5CF0\u3002\u4ED6\u7684\u9B03\u6BDB\u5982\u540C\u91CE\u706B\u822C\u718A\u718A\u71C3\u70E7\uFF0C\u6BCF\u4E00\u6B21\u79FB\u52A8\u90FD\u7559\u4E0B\u4E00\u7F15\u7F15\u707C\u70E7\u7684\u4F59\u70EC\u3002\u6124\u6012\u4E0E\u51B3\u5FC3\u9A71\u4F7F\u7740\u4ED6\uFF0C\u4ED6\u62E5\u6709\u7194\u5CA9\u822C\u7684\u529B\u91CF\uFF0C\u8DB3\u4EE5\u51FB\u6E83\u54EA\u6015\u662F\u6700\u5F3A\u5927\u7684\u654C\u4EBA\u3002\u4ED6\u7684\u5B58\u5728\u672C\u8EAB\u5C31\u8DB3\u4EE5\u70B9\u71C3\u6218\u573A\u2014\u2014\u65E2\u71C3\u8D77\u70C8\u7130\uFF0C\u4E5F\u71C3\u8D77\u52C7\u6C14\u3002\u4E0E\u4ED6\u5E76\u80A9\u4F5C\u6218\uFF0C\u5982\u540C\u4E0E\u706B\u5C71\u822C\u7684\u6012\u706B\u5E76\u80A9\u524D\u884C\u3002\nmonster9_des
      = \u514B\u62C9\u683C\u7C73\u7279\u6F5C\u4F0F\u5728\u5E72\u71E5\u9F9F\u88C2\u7684\u5730\u8868\u4E4B\u4E0B\uFF0C\u4F53\u578B\u867D\u5C0F\uFF0C\u4F46\u8EAB\u62AB\u539A\u91CD\u94E0\u7532\uFF0C\u4EE5\u4F0F\u51FB\u5730\u4E0B\u800C\u95FB\u540D\u3002\u5B83\u952F\u9F7F\u72B6\u7684\u7532\u58F3\u4E0E\u5CA9\u77F3\u5730\u5F62\u6D51\u7136\u4E00\u4F53\uFF0C\u800C\u5B83\u90A3\u5C16\u9510\u7684\u817F\u90E8\u5219\u80FD\u8F7B\u677E\u7A7F\u51FF\u77F3\u58C1\u3002\u5C3D\u7BA1\u4F53\u578B\u5E9E\u5927\uFF0C\u77FF\u5DE5\u548C\u62FE\u8352\u8005\u5374\u90FD\u5BF9\u5B83\u5FC3\u751F\u754F\u60E7\u2014\u2014\u5B83\u7684\u54AC\u5408\u529B\u80FD\u5728\u51E0\u79D2\u949F\u5185\u7834\u574F\u5730\u52BF\u3002\u5C0F\u5FC3\u811A\u4E0B\uFF0C\u5927\u5730\u98A4\u6296\u4E4B\u5904\uFF0C\u6216\u8BB8\u6F5C\u4F0F\u7740\u514B\u62C9\u683C\u7C73\u7279\u3002\nmonster10_des
      = \u8428\u8BFA\u514B\u662F\u514B\u62C9\u683C\u7C73\u7279\u7684\u602A\u517D\u8FDB\u5316\u7248\u2014\u2014\u5B83\u4E0D\u518D\u662F\u6F5C\u4F0F\u7684\u722C\u884C\u8005\uFF0C\u800C\u662F\u4E00\u5EA7\u7531\u5CA9\u77F3\u548C\u9AA8\u9ABC\u7EC4\u6210\u7684\u79FB\u52A8\u5821\u5792\u3002\u5B83\u516D\u6761\u950B\u5229\u7684\u957F\u817F\u5728\u51B2\u950B\u65F6\u78BE\u788E\u5730\u9762\uFF0C\u5DE8\u5927\u7684\u8840\u76C6\u5927\u53E3\u4E2D\u5E03\u6EE1\u952F\u9F7F\u72B6\u7684\u5229\u9F7F\uFF0C\u968F\u65F6\u51C6\u5907\u6495\u788E\u94A2\u94C1\u3002\u575A\u786C\u5982\u77F3\u7684\u7532\u58F3\u4E0A\u4F38\u51FA\u7684\u5C16\u523A\uFF0C\u5982\u540C\u5927\u81EA\u7136\u96D5\u523B\u7684\u8B66\u793A\u6807\u5FD7\u3002\u8428\u8BFA\u514B\u66FE\u662F\u9690\u533F\u7684\u5A01\u80C1\uFF0C\u5982\u4ECA\u5374\u4EE5\u65E0\u60C5\u7684\u5730\u751F\u63A0\u98DF\u8005\u4E4B\u59FF\u7EDF\u6CBB\u7740\u6218\u573A\uFF0C\u5C31\u8FDE\u7ECF\u9A8C\u4E30\u5BCC\u7684\u63A0\u98DF\u8005\u4E5F\u5BF9\u5176\u5FC3\u751F\u754F\u60E7\u3002\nmonster11_des
      = \u4F20\u8A00\u79F0\uFF0C\u8D1D\u5FB7\u62C9\u5E93\u5C14\u662F\u81EA\u7B2C\u4E00\u6B21\u5D29\u584C\u4EE5\u6765\u5C31\u88AB\u57CB\u846C\u7684\u8FDC\u53E4\u6050\u6016\u751F\u7269\uFF0C\u8BDE\u751F\u4E8E\u76D6\u4E9A\u7684\u6124\u6012\uFF0C\u5E76\u5728\u5CA9\u77F3\u4E4B\u4E0B\u5386\u7ECF\u6570\u4E2A\u4E16\u7EAA\u7684\u78E8\u783A\u3002\u5B83\u9AD8\u5927\u65E0\u60C5\uFF0C\u5982\u4ECA\u51ED\u501F\u516B\u6761\u952F\u9F7F\u72B6\u7684\u80A2\u4F53\u548C\u4E24\u67C4\u5DE8\u5927\u7684\u9AA8\u9570\u633A\u7ACB\u4E8E\u4E16\uFF0C\u8DB3\u4EE5\u6495\u88C2\u5927\u5730\u548C\u8840\u8089\u3002\u5B83\u8986\u76D6\u7684\u94E0\u7532\u4E0A\u8109\u52A8\u7740\u8574\u85CF\u7740\u5143\u7D20\u80FD\u91CF\u7684\u7EFF\u8272\u88C2\u9699\uFF0C\u5355\u662F\u5B83\u7684\u5B58\u5728\u5C31\u80FD\u9707\u98A4\u5927\u5730\u3002\u8D1D\u5FB7\u62C9\u5E93\u5C14\u5E76\u975E\u730E\u98DF\uFF0C\u800C\u662F\u51C0\u5316\uFF0C\u7559\u4E0B\u7684\u53EA\u6709\u5C18\u571F\u548C\u5BC2\u9759\u3002\u4E0E\u5B83\u5BF9\u6297\uFF0C\u4FBF\u662F\u5BF9\u5927\u5730\u610F\u5FD7\u7684\u6311\u6218\u3002\nmonster2000_des
      = \u65AF\u83AB\u5361\u5947\u8BDE\u751F\u4E8E\u88AB\u9057\u5FD8\u7684\u6218\u573A\u7070\u70EC\u4E4B\u4E2D\uFF0C\u5982\u540C\u4E00\u9053\u8FC5\u6377\u65E0\u58F0\u7684\u706B\u7130\uFF0C\u7B3C\u7F69\u5728\u9634\u5F71\u4E4B\u4E2D\u3002\u4ED6\u8EAB\u62AB\u7126\u9ED1\u7684\u6218\u888D\uFF0C\u624B\u6301\u707C\u70ED\u7684\u5229\u5203\uFF0C\u884C\u8E2A\u9690\u79D8\uFF0C\u5982\u540C\u98CE\u4E2D\u5F25\u6F2B\u7684\u785D\u70DF\uFF0C\u7A7F\u68AD\u4E8E\u6218\u573A\u4E4B\u95F4\u3002\u4ED6\u7684\u6BCF\u4E00\u4E2A\u4E3E\u52A8\u90FD\u7559\u4E0B\u4F59\u70EC\uFF0C\u4ED6\u70BD\u70ED\u7684\u76EE\u5149\u575A\u5B9A\u4E0D\u79FB\uFF0C\u7A7F\u900F\u9ED1\u6697\u3002\u540E\u88D4\u4EEC\u4F4E\u58F0\u8BF4\uFF0C\u4ED6\u662F\u5815\u843D\u6218\u58EB\u7075\u9B42\u7684\u6B8B\u4F59\uFF0C\u88AB\u8BC5\u5492\u5728\u6C38\u6052\u7684\u5BC2\u9759\u4E2D\u6218\u6597\u2014\u2014\u51FA\u51FB\u901F\u5EA6\u5FEB\uFF0C\u6D88\u5931\u5F97\u4E5F\u66F4\u5FEB\u3002\nmonster2001_des
      = \u6208\u5229\u514B\u65AF\u7531\u7194\u5316\u7684\u5408\u91D1\u548C\u53E4\u8001\u7684\u7535\u8DEF\u94F8\u5C31\uFF0C\u5F62\u4F3C\u4E00\u5934\u5E9E\u7136\u5927\u7269\uFF0C\u5728\u88AB\u9057\u5FD8\u7684\u7194\u7089\u5E9F\u589F\u4E2D\u7F13\u6162\u524D\u884C\u3002\u5B83\u90A3\u53EA\u4E00\u7728\u4E0D\u7728\u7684\u72EC\u773C\uFF0C\u9ED8\u9ED8\u5730\u95EA\u70C1\u7740\u76EE\u5149\uFF0C\u641C\u5BFB\u7740\u5165\u4FB5\u8005\u548C\u5931\u843D\u7684\u9057\u7269\u3002\u5B83\u8EAB\u62AB\u7126\u707C\u7684\u6A59\u8272\u91D1\u5C5E\u94E0\u7532\uFF0C\u80F8\u524D\u6709\u4E00\u4E2A\u5706\u5F62\u6838\u5FC3\uFF0C\u636E\u4FE1\u53EF\u4EE5\u8C03\u8282\u5176\u5185\u90E8\u538B\u529B\u548C\u529B\u91CF\u3002\u6208\u5229\u514B\u65AF\u7684\u624B\u81C2\u6C89\u91CD\u5982\u94C1\u7827\uFF0C\u53CC\u817F\u5219\u7EAF\u7CB9\u4E3A\u4E86\u4FDD\u6301\u7A33\u5B9A\uFF0C\u5B83\u7684\u653B\u51FB\u5982\u540C\u4E00\u6839\u574D\u584C\u7684\u67F1\u5B50\u2014\u2014\u7F13\u6162\u3001\u6C89\u7A33\uFF0C\u5374\u53C8\u6781\u5177\u7834\u574F\u529B\u3002\nmonster2002_des
      = \u5854\u7D22\u514B\u7F13\u6162\u3001\u9759\u8C27\u3001\u6C38\u4E0D\u6D88\u901D\uFF0C\u662F\u4E00\u4F4D\u4ECE\u6D77\u5E95\u5347\u8D77\u7684\u6DF1\u6D77\u6D41\u6D6A\u8005\u3002\u5B83\u539A\u5B9E\u7684\u87BA\u65CB\u5F62\u5916\u58F3\u4E0A\u9576\u5D4C\u7740\u952F\u9F7F\u72B6\u7684\u73CA\u745A\uFF0C\u90A3\u662F\u5B83\u4E00\u751F\u6F02\u6D41\u4E8E\u73CA\u745A\u7901\u5893\u5730\u548C\u6D77\u5E95\u6D77\u6C9F\u7684\u9057\u8FF9\u3002\u5B83\u7684\u52A8\u4F5C\u5982\u540C\u51B0\u5DDD\u822C\u7F13\u6162\uFF0C\u4F46\u6BCF\u4E00\u6B65\u90FD\u627F\u8F7D\u7740\u6570\u4E2A\u4E16\u7EAA\u7684\u91CD\u91CF\u3002\u5854\u7D22\u514B\u62E5\u6709\u4E00\u53EA\u95EA\u95EA\u53D1\u5149\u7684\u773C\u775B\uFF0C\u4EE5\u53CA\u968F\u7740\u6F6E\u6C50\u80FD\u91CF\u8109\u52A8\u7684\u8EAB\u8EAF\uFF0C\u5B83\u4F53\u73B0\u4E86\u5927\u6D77\u672C\u8EAB\u7684\u8010\u5FC3\u548C\u6BC1\u706D\u6027\u529B\u91CF\u2014\u2014\u4E00\u65E6\u88AB\u6FC0\u6012\uFF0C\u4FBF\u52BF\u4E0D\u53EF\u6321\u3002\nmonster2003_des
      = \u62C9\u7EF4\u5C14\u662F\u4E00\u4F4D\u795E\u79D8\u7684\u5B58\u5728\uFF0C\u4F18\u96C5\u800C\u53C8\u5145\u6EE1\u5A01\u80C1\uFF0C\u4ED6\u5982\u540C\u4E00\u5339\u6697\u5F71\u953B\u9020\u7684\u9A8F\u9A6C\uFF0C\u53CC\u7FFC\u6536\u62E2\uFF0C\u65E0\u58F0\u5730\u53CD\u6297\u7740\u3002\u4ED6\u8EAB\u5F62\u4F18\u96C5\uFF0C\u4F46\u771F\u6B63\u7684\u529B\u91CF\u9690\u85CF\u4E8E\u5176\u4E0B\u2014\u2014\u7531\u5BCC\u542B\u91D1\u5C5E\u7CBE\u534E\u7684\u9AA8\u9ABC\u953B\u9020\u800C\u6210\uFF0C\u5200\u5251\u706B\u7130\u7686\u4E0D\u5C48\u670D\u3002\u62C9\u7EF4\u5C14\u53CC\u773C\u5982\u7194\u5316\u7684\u9EC4\u91D1\uFF0C\u7284\u89D2\u53D1\u51FA\u5143\u7D20\u5171\u9E23\u7684\u55E1\u9E23\uFF0C\u4ED6\u4EE5\u4EE4\u4EBA\u96BE\u4EE5\u5FD8\u6000\u7684\u6C89\u7740\u59FF\u6001\u6ED1\u7FD4\u4E8E\u6218\u573A\u3002\u9C9C\u6709\u4EBA\u6562\u4E0E\u4ED6\u6B63\u9762\u4EA4\u950B\uFF0C\u56E0\u4E3A\u4ED6\u7684\u6BCF\u4E00\u6B65\u90FD\u5982\u540C\u94E0\u7532\u822C\u56DE\u54CD\u4E8E\u6218\u706B\u5E73\u539F\u3002\nmonster2004_des
      = \u7EF4\u8BFA\u6885\u62C9\u662F\u72C2\u91CE\u5929\u7A7A\u4E2D\u8FC5\u6377\u65E0\u60C5\u7684\u6355\u98DF\u8005\uFF0C\u5B83\u98DE\u901F\u63A0\u8FC7\u7A7A\u4E2D\uFF0C\u8EAB\u5F71\u95EA\u70C1\u7740\u7D2B\u91D1\u8272\u7684\u5149\u8292\u3002\u8FD9\u53EA\u5F62\u4F3C\u9EC4\u8702\u7684\u56DE\u58F0\uFF0C\u6709\u7740\u534A\u900F\u660E\u7684\u9EC4\u8272\u7FC5\u8180\uFF0C\u5C16\u7AEF\u6BD2\u523A\u6563\u53D1\u7740\u5982\u540C\u7194\u5316\u7684\u7425\u73C0\u822C\u7684\u5149\u8292\uFF0C\u7F8E\u4E3D\u800C\u81F4\u547D\u3002\u5B83\u5149\u6ED1\u7684\u8EAB\u8EAF\u4E0B\u9690\u85CF\u7740\u7531\u73CD\u7A00\u690D\u7269\u917F\u9020\u7684\u5F3A\u529B\u6BD2\u7D20\uFF0C\u5373\u4F7F\u662F\u8F7B\u8F7B\u4E00\u523A\uFF0C\u4E5F\u8DB3\u4EE5\u4F7F\u4EBA\u762B\u75EA\u3002\u5F88\u5C11\u6709\u4EBA\u80FD\u9884\u89C1\u5B83\u7684\u5230\u6765\u2014\u2014\u80FD\u591F\u6D3B\u7740\u8BB2\u8FF0\u8FD9\u4E00\u5207\u7684\u4EBA\u66F4\u662F\u51E4\u6BDB\u9E9F\u89D2\u3002\nmonster2005_des
      = \u5361\u5229\u592B\u62C9\u662F\u5929\u7A7A\u4E0E\u6D77\u6D0B\u4E2D\u7F55\u89C1\u7684\u5947\u89C2\uFF0C\u5B83\u4EE5\u5B81\u9759\u4F18\u96C5\u7684\u59FF\u6001\u98D8\u6D6E\u4E8E\u7A7A\u4E2D\uFF0C\u51B0\u84DD\u4E0E\u767D\u8272\u7684\u7FBD\u7FFC\u5728\u6708\u5149\u4E0B\u95EA\u8000\uFF0C\u5B9B\u5982\u6CE2\u5149\u7CBC\u7CBC\u3002\u867D\u7136\u8BDE\u751F\u4E8E\u6C34\u5143\u7D20\uFF0C\u5B83\u5374\u5F88\u5C11\u63A5\u89E6\u5730\u9762\u2014\u2014\u66F4\u559C\u6B22\u5728\u6D77\u98CE\u548C\u8FF7\u96FE\u5F25\u6F2B\u7684\u6D0B\u6D41\u4E2D\u76D8\u65CB\u3002\u5B83\u90A3\u72EC\u7279\u7684\u773C\u775B\u6563\u53D1\u7740\u51B7\u9759\u7684\u667A\u6167\uFF0C\u800C\u5B83\u90A3\u53D1\u5149\u7684\u89E6\u89D2\u5219\u80FD\u611F\u77E5\u5929\u6C14\u548C\u6F6E\u6C50\u7684\u53D8\u5316\u3002\u5361\u5229\u592B\u62C9\u6027\u60C5\u6E29\u548C\u5374\u96BE\u4EE5\u6349\u6478\uFF0C\u5E38\u5E38\u88AB\u8BEF\u8BA4\u4E3A\u662F\u98CE\u66B4\u4E4B\u7075\u3002\nmonster2006_des
      = \u5FB7\u96F7\u683C\u7C73\u5C14\u8BDE\u751F\u4E8E\u8150\u70C2\u9B54\u8109\u7684\u6E83\u70C2\u9634\u5F71\u4E4B\u4E2D\uFF0C\u662F\u5143\u7D20\u6DF7\u6C8C\u7684\u7578\u5F62\u5E7D\u7075\u3002\u5B83\u90A3\u5B64\u96F6\u96F6\u3001\u4E00\u7728\u4E0D\u7728\u7684\u773C\u775B\u71C3\u70E7\u7740\u975E\u540C\u5BFB\u5E38\u7684\u610F\u8BC6\uFF0C\u7EFF\u8272\u7684\u706B\u7130\u4ECE\u5B83\u7684\u624B\u81C2\u548C\u5934\u90E8\u55B7\u6D8C\u800C\u51FA\uFF0C\u5982\u540C\u5267\u6BD2\u610F\u5FD7\u7684\u5316\u8EAB\u3002\u5FB7\u96F7\u683C\u7C73\u5C14\u62E5\u6709\u7626\u957F\u7684\u56DB\u80A2\u548C\u4EFF\u4F5B\u5728\u4E0D\u540C\u7EF4\u5EA6\u95F4\u62BD\u6410\u7684\u8EAB\u8EAF\uFF0C\u98D8\u8361\u4E8E\u8BC5\u5492\u4E4B\u5730\u4E4B\u95F4\uFF0C\u88AB\u8150\u673D\u4E0E\u7EDD\u671B\u6240\u5438\u5F15\u3002\u4E00\u4E9B\u540E\u88D4\u8BF4\u5B83\u4F1A\u4F4E\u8BED\u2014\u2014\u4F46\u6240\u6709\u8046\u542C\u8FC7\u7684\u4EBA\u90FD\u4ECE\u672A\u6539\u53D8\u8FC7\u3002\nmonster2007_des
      = \u5965\u5E03\u897F\u6D1B\u514B\u94F8\u4E8E\u76D6\u4E9A\u6C34\u6676\u6D1E\u7A74\u6700\u6DF1\u5904\u7684\u8109\u7EDC\uFF0C\u5982\u540C\u5CA9\u77F3\u4E0E\u95EA\u8000\u6012\u706B\u7684\u5B88\u536B\u3002\u5B83\u7D27\u51D1\u7684\u8EAB\u8EAF\u8986\u4EE5\u952F\u9F7F\u72B6\u7684\u7D2B\u8272\u5CA9\u77F3\uFF0C\u6DF1\u7EA2\u8272\u7684\u6C34\u6676\u5982\u540C\u5929\u7136\u7684\u5229\u5203\u822C\u4ECE\u56DB\u80A2\u4F38\u51FA\u3002\u4E00\u53EA\u95EA\u95EA\u53D1\u5149\u7684\u773C\u775B\u51B7\u5CFB\u800C\u575A\u5B9A\u5730\u5BA1\u89C6\u7740\u5468\u56F4\u3002\u867D\u7136\u9759\u9ED8\u65E0\u58F0\uFF0C\u4E00\u52A8\u4E0D\u52A8\uFF0C\u4F46\u5F53\u5927\u5730\u98A4\u6296\u65F6\uFF0C\u5965\u5E03\u897F\u6D1B\u514B\u4FBF\u4F1A\u82CF\u9192\u2014\u2014\u5E26\u7740\u5730\u58F3\u7684\u6124\u6012\u53D1\u8D77\u653B\u51FB\uFF0C\u5B88\u62A4\u5730\u8868\u4E4B\u4E0B\u7684\u5E73\u8861\u3002\nmonster2008_des
