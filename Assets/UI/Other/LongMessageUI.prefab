      m_Calls: []
  m_text: "<b><sprite name=\"icon_might_flat\">Might:</b> Determines the hero\u2019s
    base damage output in battle.\r\n<b><sprite name=\"icon_str_flat\">Attack:</b>
    Enhances the team\u2019s attack power, increasing damage dealt.\r\n<b><sprite
    name=\"icon_def_flat\">Defense:</b> Bolsters the team\u2019s defense, reducing
    damage taken.\r\n<b><sprite name=\"icon_hp_flat\">Health:</b> Increases the team\u2019s
    maximum health, helping them endure longer.\r\n<b><sprite name=\"icon_spd_flat\">Speed:</b>
    Improves the team\u2019s speed, allowing them to act first in combat.\r\n\r\n<b><size=80%>**Attack,
    Defense, Health, and Speed are shared with all monsters in the lineup, empowering
    the entire team.**</size></b>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1ad401891b3d96c42b4d00a02b43cd43, type: 2}
