  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Centuries ago, during the final days of the Astral Alliance, the largest
    and only Astral Gate on Gaia was destroyed to prevent the Dark Element from consuming
    the planet\u2019s elemental core. When the gate shattered, its crystal fragments
    rained across Gaia.\r\nFor generations, these shards \u2014 now known as Gate
    Crystals \u2014 were sealed within treasure chests or left untouched, believed
    to be cursed remnants of the Collapse. But as the year turns and Gaia\u2019s
    light renews, the crystals have begun to resonate once more, humming faintly
    with restored energy. Merchants across the world now seek these relics, offering
    rare treasures in exchange for any Scion that happens to recover them.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4bd810f1cbcb0f446a8f5a31453e243f, type: 2}
