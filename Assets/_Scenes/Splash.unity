  - Name: skill_passive_detail_17
    Text: "T\u0103ng {0}% ATK, {1}% CRT, {2}% CRD"
  - Name: skill_passive_name_18
    Text: "Ph\xE9p thu\u1EADt Echo"
  - Name: skill_passive_detail_18
    Text: "T\u0103ng {0}% DEF, {1} SPD"
  - Name: skill_passive_name_19
    Text: "Ph\xF2ng Ng\u1ECDn L\u1EEDa"
  - Name: skill_passive_detail_19
    Text: "G\xE2y th\xEAm {0}% s\xE1t th\u01B0\u01A1ng l\xEAn k\u1EBB \u0111\u1ECBch
      b\u1ECB \u0111\xF3ng b\u0103ng"
  - Name: skill_passive_name_20
    Text: Shadow Tap
  - Name: skill_passive_detail_20
    Text: "T\u0103ng ATK th\xEAm {0}%, DEF th\xEAm {1}%, T\u1EF7 l\u1EC7 ch\xED m\u1EA1ng
      th\xEAm {2}% v\xE0 S\xE1t th\u01B0\u01A1ng ch\xED m\u1EA1ng th\xEAm {3}%."
  - Name: skill_passive_name_21
    Text: "C\u1EA3m gi\xE1c kho b\xE1u"
  - Name: skill_passive_detail_21
    Text: "HP +{0}%, Gi\u1EA3m s\xE1t th\u01B0\u01A1ng k\u1EF9 n\u0103ng +{1}%."
  - Name: skill_passive_name_22
    Text: "Ch\xE2n nhanh"
  - Name: skill_passive_detail_22
    Text: "V\xE0o cu\u1ED1i m\u1ED7i hi\u1EC7p, h\u1ED3i m\xE1u cho {0} \u0111\u1ED3ng
      minh c\xF3 ATK cao nh\u1EA5t v\u1EDBi {1}% ATK v\xE0 c\xF3 {2}% c\u01A1 h\u1ED9i
      t\u0103ng ATK c\u1EE7a h\u1ECD th\xEAm {3}% trong {4} hi\u1EC7p."
  - Name: skill_passive_name_23
    Text: "Ch\u1EA1m tay c\u1EE7a nh\xE0 gi\u1EA3 kim"
  - Name: skill_passive_detail_23
    Text: "Khi b\u1EAFt \u0111\u1EA7u tr\u1EADn chi\u1EBFn, c\u1EA5p cho t\u1EA5t
      c\u1EA3 \u0111\u1ED3ng minh {0}% DR"
  - Name: skill_passive_name_24
    Text: "Nh\u1EEFng b\u01B0\u1EDBc ch\xE2n im l\u1EB7ng"
  - Name: skill_passive_detail_24
    Text: "C\xE1c \u0111\xF2n t\u1EA5n c\xF4ng c\u01A1 b\u1EA3n t\u0103ng CRT {0}%
      trong {1} v\xF2ng"
  - Name: skill_passive_name_25
    Text: "B\xF9a may m\u1EAFn"
  - Name: skill_passive_detail_25
    Text: "Khi k\u1EBB \u0111\u1ECBch ch\u1EBFt, nh\u1EADn \u0111\u01B0\u1EE3c {0}%
      t\u1EA5n c\xF4ng trong tr\u1EADn chi\u1EBFn n\xE0y"
  - Name: skill_passive_name_26
    Text: "D\u1EF1 tr\u1EEF s\u1EE9c b\u1EC1n"
  - Name: skill_passive_detail_26
    Text: "\u0110\u1EA7u ti\xEAn d\u01B0\u1EDBi {1}% HP gi\u1EA3m {2} SPD v\xE0 g\xE2y
      th\xEAm {3}% s\xE1t th\u01B0\u01A1ng cho k\u1EBB \u0111\u1ECBch \u0111ang ch\u1EA3y
      m\xE1u trong {4} v\xF2ng"
  - Name: skill_passive_name_27
    Text: "Ph\u1EE5c h\u1ED3i nhanh ch\xF3ng"
  - Name: skill_passive_detail_27
    Text: "Khi ch\u1EBFt, c\xF3 {0}% c\u01A1 h\u1ED9i \u0111\xF3ng b\u0103ng t\u1EA5t
      c\u1EA3 k\u1EBB \u0111\u1ECBch trong {1} v\xF2ng v\xE0 ph\u1EE5c h\u1ED3i HP
      b\u1EB1ng {2}% ATK cho t\u1EA5t c\u1EA3 \u0111\u1ED3ng minh."
  - Name: skill_passive_name_28
    Text: "Ng\u01B0\u1EDDi th\u1EE3 th\u1EE7 c\xF4ng th\xE1o v\xE1t"
  - Name: skill_passive_detail_28
    Text: "Khi b\u1EAFt \u0111\u1EA7u tr\u1EADn chi\u1EBFn, t\u0103ng {0}% ATK."
  - Name: skill_passive_name_29
    Text: "M\u1EAFt tinh t\u01B0\u1EDDng"
  - Name: skill_passive_detail_29
    Text: "Khi b\u1ECB \u1EA3nh h\u01B0\u1EDFng b\u1EDFi hi\u1EC7u \u1EE9ng DoT,
      nh\u1EADn \u0111\u01B0\u1EE3c L\xE1 ch\u1EAFn d\u1EF1a tr\xEAn {0}% MaxHP"
  - Name: skill_passive_name_30
    Text: "\u01AFu \u0111\xE3i c\u1EE7a th\u01B0\u01A1ng gia"
  - Name: skill_passive_detail_30
    Text: "Khi ch\u1EBFt, h\u1ED3i m\xE1u cho t\u1EA5t c\u1EA3 \u0111\u1ED3ng minh
      {0}% ATK v\xE0 t\u0103ng Gi\u1EA3m s\xE1t th\u01B0\u01A1ng c\u1EE7a h\u1ECD
      th\xEAm {1}% trong {2} hi\u1EC7p."
  - Name: skill_passive_name_31
    Text: "L\u01B0\u1EE1i li\u1EC1m g\xE2y t\xEA c\xF3ng"
  - Name: skill_passive_detail_31
