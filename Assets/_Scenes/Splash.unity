  - Name: clan_noti_clan_02
    Text: "\u5B9D\u77F3\u4E0D\u591F\uFF0C\u65E0\u6CD5\u7F16\u8F91\u6C0F\u65CF\uFF01"
  - Name: clan_noti_clan_03
    Text: "\u6C0F\u65CF\u540D\u79F0\u4E0D\u80FD\u4E3A\u7A7A\uFF01"
  - Name: clan_noti_clan_04
    Text: "\u6C0F\u65CF\u540D\u79F0\u5FC5\u987B\u81F3\u5C11\u5305\u542B 4 \u4E2A\u5B57\u6BCD\u3002"
  - Name: clan_noti_clan_05
    Text: "\u6C0F\u65CF\u540D\u79F0\u4E0D\u5F97\u8D85\u8FC7 20 \u4E2A\u5B57\u7B26\u3002"
  - Name: clan_noti_clan_06
    Text: "\u63CF\u8FF0\u4E0D\u80FD\u4E3A\u7A7A\uFF01"
  - Name: clan_noti_clan_07
    Text: "\u63CF\u8FF0\u5B57\u6570\u4E0D\u5F97\u8D85\u8FC7200\u4E2A\u5B57\u7B26\u3002"
  - Name: clan_noti_clan_08
    Text: "\u4F60\u6CA1\u6709\u6C0F\u65CF\uFF01"
  - Name: clan_noti_limit_donate
    Text: "\u6BCF\u65E5\u6350\u8D60\u989D\u5EA6\u5DF2\u8FBE\u4E0A\u9650\u3002\u60A8\u4ECD\u7136\u53EF\u4EE5\u901A\u8FC7\u5176\u4ED6\u65B9\u5F0F\u652F\u6301\u60A8\u7684\u6218\u961F\uFF01"
  - Name: clan_noti_clan_10
    Text: "\u60A8\u8981\u79FB\u9664\u6B64\u6210\u5458\u5417\uFF1F"
  - Name: clan_noti_clan_11
    Text: "\u6B64\u64CD\u4F5C\u5C06\u6C38\u4E45\u79FB\u9664\u8BE5\u6C0F\u65CF\u5E76\u89E3\u6563\u6240\u6709\u6210\u5458\u3002\u4ED6\u4EEC\u5C06\u518D\u6B21\u5B64\u8EAB\u6D41\u6D6A\u4E8E\u4E16\u3002\u662F\u5426\u7EE7\u7EED\uFF1F"
  - Name: clan_noti_clan_12
    Text: "\u4F60\u786E\u5B9A\u8981\u79BB\u5F00\u5BB6\u65CF\u5417\uFF1F"
  - Name: clan_noti_clan_13
    Text: "\u4E00\u4E2A\u6C0F\u65CF\u4E0D\u80FD\u7FA4\u9F99\u65E0\u9996\u3002\u4E34\u884C\u524D\u52A1\u5FC5\u6307\u5B9A\u7EE7\u4EFB\u8005\u3002"
  - Name: clan_noti_clan_14
    Text: "\u4FEE\u6539\u4F60\u7684\u516C\u4F1A\u4FE1\u606F\u3002\r\n\uFF084-200\u4E2A\u5B57\u7B26\uFF09"
  - Name: clan_noti_clan_15
    Text: "\u4FEE\u6539\u4F60\u7684\u6C0F\u65CF\u63CF\u8FF0\u3002\r\n\uFF084-200\u4E2A\u5B57\u7B26\uFF09"
  - Name: clan_noti_clan_16
    Text: "\u8BF7\u9009\u62E9\u60A8\u60F3\u8981\u6350\u8D60\u7684\u6570\u91CF\u3002"
  - Name: clan_noti_clan_17
    Text: "\u60A8\u662F\u5426\u8981\u5C06\u516C\u4F1A\u4F1A\u957F\u804C\u52A1\u8F6C\u79FB\u7ED9\u8BE5\u6210\u5458\uFF1F\u5982\u679C\u7EE7\u7EED\uFF0C\u60A8\u5C06\u6210\u4E3A\u526F\u4F1A\u957F\uFF0C\u5E76\u5931\u53BB\u6240\u6709\u516C\u4F1A\u4F1A\u957F\u6743\u9650\u3002"
  - Name: clan_noti_clan_18
    Text: "\u964D\u804C\u662F\u4E0D\u53EF\u80FD\u7684\uFF1A\u8BE5\u6210\u5458\u76EE\u524D\u5DF2\u662F\u6700\u4F4E\u804C\u4F4D\u3002"
  - Name: clan_noti_clan_19
    Text: "\u60A8\u7684\u89D2\u8272\u6CA1\u6709\u4F7F\u7528\u6B64\u529F\u80FD\u7684\u6743\u9650\u3002"
  - Name: clan_noti_clan_20
    Text: "\u60A8\u4E0D\u80FD\u5BF9\u89D2\u8272\u4E0E\u60A8\u76F8\u540C\u6216\u66F4\u9AD8\u7684\u6210\u5458\u6267\u884C\u6B64\u64CD\u4F5C\u3002"
  - Name: clan_noti_clan_21
    Text: "\u81EA\u5B9A\u4E49\u60A8\u7684\u516C\u4F1A\u6B22\u8FCE\u4FE1\u606F\u3002"
  - Name: clan_noti_clan_22
    Text: "\u60A8\u5DF2\u8FBE\u5230\u6BCF\u65E5\u6350\u6B3E\u9650\u989D\u3002"
  - Name: clan_create_sucsessfully
    Text: "\u516C\u4F1A\u521B\u5EFA\u6210\u529F\uFF01"
  - Name: clan_edit_sucsessfully
    Text: "\u6C0F\u65CF\u7F16\u8F91\u6210\u529F\uFF01"
  - Name: clan_boss_rank
    Text: "\u79E9"
  - Name: clan_boss_rank_empty
    Text: "\u81F3\u4ECA\u65E0\u4EBA\u6562\u6311\u6218\u6C0F\u65CF\u9996\u9886\u3002\u4F60\u4F1A\u662F\u7B2C\u4E00\u4E2A\u5417\uFF1F"
  - Name: clan_boss_total
    Text: "<color=blue>\u603B\u6218\u529B</color>\uFF1A\u60A8\u7684\u516C\u4F1A\u5FC5\u987B\u5B8C\u6210\u4E00\u5B9A\u6570\u91CF\u7684\u9996\u9886\u6218\u624D\u80FD\u83B7\u5F97\u76F8\u5E94\u7684\u5956\u52B1\uFF0C\u5956\u52B1\u6570\u91CF\u53D6\u51B3\u4E8E\u60A8\u516C\u4F1A\u5B8C\u6210\u7684\u6218\u6597\u6B21\u6570\u3002\u5956\u52B1\u5C06\u4E8E\u6B21\u65E5\u53D1\u9001\u81F3\u60A8\u7684\u90AE\u7BB1\u3002"
  - Name: clan_boss_rewards
    Text: "<color=blue>\u5956\u52B1</color>\uFF1A\u6BCF\u8FBE\u5230\u4E00\u4E2A\u4F24\u5BB3\u91CC\u7A0B\u7891\uFF0C\u60A8\u90FD\u5C06\u83B7\u5F97\u4E00\u4E2A\u5956\u52B1\u7BB1\u3002\u6BCF\u4E2A\u7BB1\u5B50\u5305\u542B\u5404\u79CD\u5956\u52B1\uFF0C\u6389\u843D\u7387\u5404\u4E0D\u76F8\u540C\u3002\u60A8\u9020\u6210\u7684\u4F24\u5BB3\u8D8A\u591A\uFF0C\u83B7\u5F97\u7684\u5956\u52B1\u5C31\u8D8A\u591A\u3002"
  - Name: clan_boss_Key
    Text: "\u94A5\u5319\uFF1A\u7528\u4E8E\u89E3\u9501 Boss \u6218\u3002\u6BCF\u5929\u60A8\u5C06\u83B7\u5F97\u4E00\u5B9A\u6570\u91CF\u7684\u94A5\u5319\u3002\u5F53\u94A5\u5319\u7528\u5B8C\u65F6\uFF0C\u60A8\u53EF\u4EE5\u901A\u8FC7\u89C2\u770B\u5E7F\u544A\u6765\u83B7\u5F97\u66F4\u591A\u94A5\u5319\uFF0C\u5E76\u83B7\u5F97\u5956\u52B1\u3002"
  - Name: summon_info_text
    Text: "***\u4F60\u53EA\u80FD\u53EC\u5524\u5C1A\u672A\u89E3\u9501\u7684\u602A\u7269\u3002\u5982\u679C\u4F60\u89E3\u9501\u4E86\u5DF2\u7ECF\u62E5\u6709\u7684\u602A\u7269\uFF0C\u5B83\u5C06\u88AB\u8F6C\u5316\u4E3A100\u4E2A\u788E\u7247\u3002\u788E\u7247\u53EF\u4EE5\u7528\u6765\u5347\u7EA7\u8BE5\u602A\u7269\uFF01***"
