    Text: "\u5F71\u5B50\u8F7B\u51FB"
  - Name: skill_passive_detail_20
    Text: "\u653B\u51FB\u529B\u63D0\u5347{0}%\uFF0C\u9632\u5FA1\u529B\u63D0\u5347{1}%\uFF0C\u66B4\u51FB\u7387\u63D0\u5347{2}%\uFF0C\u66B4\u51FB\u4F24\u5BB3\u63D0\u5347{3}%\u3002"
  - Name: skill_passive_name_21
    Text: "\u5BFB\u5B9D\u611F"
  - Name: skill_passive_detail_21
    Text: "\u751F\u547D\u503C+0%\uFF0C\u6280\u80FD\u4F24\u5BB3\u51CF\u514D+1%\u3002"
  - Name: skill_passive_name_22
    Text: "\u8F7B\u5FEB\u7684\u811A\u6B65"
  - Name: skill_passive_detail_22
    Text: "\u6BCF\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u4E3A\u653B\u51FB\u529B\u6700\u9AD8\u7684{0}\u540D\u53CB\u519B\u56DE\u590D{1}%\u7684\u653B\u51FB\u529B\uFF0C\u5E76\u6709{2}%\u7684\u51E0\u7387\u4F7F\u5176\u653B\u51FB\u529B\u63D0\u5347{3}%\uFF0C\u6301\u7EED{4}\u56DE\u5408\u3002"
  - Name: skill_passive_name_23
    Text: "\u70BC\u91D1\u672F\u58EB\u4E4B\u89E6"
  - Name: skill_passive_detail_23
    Text: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u4F7F\u6240\u6709\u53CB\u519B\u83B7\u5F97{0}%\u4F24\u5BB3\u51CF\u514D\u3002"
  - Name: skill_passive_name_24
    Text: "\u5BC2\u9759\u7684\u811A\u6B65"
  - Name: skill_passive_detail_24
    Text: "\u666E\u901A\u653B\u51FB\u5728 1 \u56DE\u5408\u5185\u589E\u52A0\u66B4\u51FB\u7387
      0%\u3002"
  - Name: skill_passive_name_25
    Text: "\u5E78\u8FD0\u7B26"
  - Name: skill_passive_detail_25
    Text: "\u672C\u6218\u4E2D\uFF0C\u5F53\u654C\u4EBA\u6B7B\u4EA1\u65F6\uFF0C\u653B\u51FB\u529B\u63D0\u5347{0}%\u3002"
  - Name: skill_passive_name_26
    Text: "\u4F53\u529B\u50A8\u5907"
  - Name: skill_passive_detail_26
    Text: "\u9996\u5148\uFF0C\u4F4E\u4E8E{1}%\u751F\u547D\u503C\u7684\u654C\u4EBA\u901F\u5EA6\u964D\u4F4E{2}%\uFF0C\u5E76\u5728\u7B2C{4}\u56DE\u5408\u5BF9\u6D41\u8840\u654C\u4EBA\u9020\u6210{3}%\u989D\u5916\u4F24\u5BB3\u3002"
  - Name: skill_passive_name_27
    Text: "\u5FEB\u901F\u6062\u590D"
  - Name: skill_passive_detail_27
    Text: "\u6B7B\u4EA1\u65F6\uFF0C\u6709{0}%\u7684\u51E0\u7387\u51BB\u7ED3\u6240\u6709\u654C\u4EBA{1}\u56DE\u5408\uFF0C\u5E76\u4E3A\u6240\u6709\u53CB\u519B\u6062\u590D\u76F8\u5F53\u4E8E\u653B\u51FB\u529B{2}%\u7684\u751F\u547D\u503C\u3002"
  - Name: skill_passive_name_28
    Text: "\u8DB3\u667A\u591A\u8C0B\u7684\u624B\u5DE5\u827A\u8005"
  - Name: skill_passive_detail_28
    Text: "\u6218\u6597\u5F00\u59CB\u65F6\uFF0C\u83B7\u5F97{0}%\u653B\u51FB\u529B\u3002"
  - Name: skill_passive_name_29
    Text: "\u654F\u9510\u7684\u76EE\u5149"
  - Name: skill_passive_detail_29
    Text: "\u53D7\u5230\u6301\u7EED\u4F24\u5BB3\u6548\u679C\u5F71\u54CD\u65F6\uFF0C\u83B7\u5F97\u57FA\u4E8E\u6700\u5927\u751F\u547D\u503C{0}%\u7684\u62A4\u76FE\u3002"
  - Name: skill_passive_name_30
    Text: "\u5546\u4EBA\u7684\u6069\u60E0"
  - Name: skill_passive_detail_30
    Text: "\u6B7B\u4EA1\u65F6\uFF0C\u4E3A\u6240\u6709\u53CB\u519B\u6062\u590D{0}%\u7684\u653B\u51FB\u529B\uFF0C\u5E76\u4F7F\u5176\u4F24\u5BB3\u51CF\u514D\u63D0\u9AD8{1}%\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_31
    Text: "\u51BB\u4F24\u9570\u5200"
  - Name: skill_passive_detail_31
    Text: "\u666E\u901A\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u6709{1}%\u7684\u51E0\u7387\u4F7F\u76EE\u6807\u51BB\u7ED3{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_32
    Text: "\u51B7\u8840\u730E\u624B"
  - Name: skill_passive_detail_32
    Text: "\u5BF9\u5904\u4E8E\u51B0\u51BB\u72B6\u6001\u7684\u654C\u4EBA\u9020\u6210\u989D\u5916{0}%\u4F24\u5BB3\u3002"
  - Name: skill_passive_name_33
    Text: "\u6708\u5149\u6D8C\u52A8"
  - Name: skill_passive_detail_33
    Text: "\u653B\u51FB\u529B+0%\uFF0C\u901F\u5EA6+1\u3002"
  - Name: skill_passive_name_34
    Text: "\u672C\u80FD\u6740\u624B"
  - Name: skill_passive_detail_34
    Text: "\u653B\u51FB\u529B+0%\uFF0C\u66B4\u51FB\u7387+1%\uFF0C\u66B4\u51FB\u4F24\u5BB3+2%\u3002"
  - Name: skill_passive_name_35
    Text: "\u6B7B\u4EA1\u8FFD\u730E\u8005"
  - Name: skill_passive_detail_35
    Text: "\u666E\u901A\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u81EA\u52A8\u653B\u51FB\u751F\u547D\u503C\u6700\u4F4E\u7684\u654C\u4EBA\u3002"
  - Name: skill_passive_name_36
    Text: "\u8346\u68D8\u6218\u9524"
  - Name: skill_passive_detail_36
    Text: "\u666E\u901A\u653B\u51FB\u9020\u6210\u6D41\u8840\uFF0C\u6BCF\u56DE\u5408\u989D\u5916\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u6301\u7EED{1}\u56DE\u5408\u3002"
  - Name: skill_passive_name_37
    Text: "\u85E4\u58F6\u5821\u5792"
  - Name: skill_passive_detail_37
    Text: "\u751F\u547D\u503C+0%\uFF0C\u653B\u51FB\u529B+1%\uFF0C\u683C\u6321+2%\u3002"
  - Name: skill_passive_name_38
    Text: "\u73CA\u745A\u9AA8\u536B\u58EB"
  - Name: skill_passive_detail_38
    Text: "\u51CF\u5C11\u53D7\u5230\u7684\u6240\u6709\u4F24\u5BB3{0}%\u3002\u6B64\u5916\uFF0C\u964D\u4F4E\u653B\u51FB\u8005\u7684\u653B\u51FB\u529B{1}%\uFF0C\u6301\u7EED2\u56DE\u5408\u3002"
  - Name: skill_passive_name_39
    Text: "\u7834\u6D6A\u8005\u7684\u8010\u529B"
  - Name: skill_passive_detail_39
    Text: "\u6BCF\u6B21\u666E\u901A\u653B\u51FB\u9020\u6210\u653B\u51FB\u529B\u7684{0}%\u4F5C\u4E3A\u4F24\u5BB3\uFF0C\u5E76\u6062\u590D\u653B\u51FB\u529B\u7684{1}%\u7684\u751F\u547D\u503C\u3002"
  - Name: skill_passive_name_40
    Text: "\u7126\u75D5"
  - Name: skill_passive_detail_40
    Text: "\u666E\u901A\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u5E76\u6709{1}%\u7684\u51E0\u7387\u707C\u70E7\u76EE\u6807\uFF0C\u4F7F\u5176\u9677\u5165\u707C\u70E7\u72B6\u6001\uFF0C\u6301\u7EED{2}\u56DE\u5408\uFF0C\u6BCF\u56DE\u5408\u9020\u6210{3}%\u653B\u51FB\u529B\u4F24\u5BB3\u3002"
  - Name: skill_passive_name_41
    Text: "\u7126\u707C\u9057\u4EA7"
  - Name: skill_passive_detail_41
    Text: "HP +{0}%, DEF+{1}%\r\n\u6B7B\u4EA1\u65F6\uFF0C\u91CA\u653E\u707C\u70ED\u8BC5\u5492\uFF0C\u707C\u70E7\u6240\u6709\u654C\u4EBA\uFF0C\u6BCF\u56DE\u5408\u9020\u6210{2}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u6301\u7EED{3}\u56DE\u5408\u3002"
  - Name: skill_passive_name_42
    Text: "\u4F59\u70EC\u590D\u4EC7"
  - Name: skill_passive_detail_42
    Text: "\u88AB\u51FB\u4E2D\u65F6\uFF0C\u6709{0}%\u7684\u51E0\u7387\u70B9\u71C3\u653B\u51FB\u8005\uFF0C\u4F7F\u5176\u5728{2}\u56DE\u5408\u5185\u6BCF\u56DE\u5408\u53D7\u5230{1}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\u3002"
  - Name: skill_passive_name_43
    Text: "\u6355\u98DF\u8005\u7684\u672C\u80FD"
  - Name: skill_passive_detail_43
    Text: "\u666E\u901A\u653B\u51FB\u603B\u662F\u4F18\u5148\u653B\u51FB\u751F\u547D\u503C\u6700\u4F4E\u7684\u654C\u4EBA\uFF0C\u9020\u6210\u653B\u51FB\u529B0%\u7684\u4F24\u5BB3\uFF0C\u5E76\u4E14\u65E0\u89C6\u683C\u6321\u3002"
  - Name: skill_passive_name_44
    Text: "\u94C1\u7532\u6355\u98DF\u8005"
  - Name: skill_passive_detail_44
    Text: "\u751F\u547D\u503C\u63D0\u9AD8{0}%\uFF0C\u4F24\u5BB3\u63D0\u9AD8{1}%\uFF0C\u901F\u5EA6\u63D0\u9AD8{2}%\uFF0C\u7729\u6655\u6297\u6027\u63D0\u9AD8{3}%\u3002"
  - Name: skill_passive_name_45
    Text: "\u541E\u566C\u5815\u843D\u8005"
  - Name: skill_passive_detail_45
    Text: "\u6BCF\u5F53\u654C\u4EBA\u6B7B\u4EA1\uFF0C\u6062\u590D{0}\u70B9\u80FD\u91CF\u5E76\u56DE\u590D{1}%\u7684\u653B\u51FB\u529B\u3002\u540C\u65F6\u83B7\u5F97{2}%\u7684\u4F24\u5BB3\u63D0\u5347\uFF0C\u6301\u7EED3\u56DE\u5408\u3002"
  - Name: skill_passive_name_46
    Text: "\u7099\u70E4\u7834\u788E"
  - Name: skill_passive_detail_46
    Text: "\u666E\u901A\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u65E0\u89C6\u683C\u6321\uFF0C\u5E76\u5077\u53D6\u76EE\u6807\u5F53\u524D{1}%\u7684\u62A4\u7532\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_47
    Text: "\u706B\u7130\u6CF0\u5766"
  - Name: skill_passive_detail_47
    Text: "\u589E\u52A0\u751F\u547D\u503C{0}%\uFF0C\u653B\u51FB\u529B{1}%\uFF0C\u62A4\u7532{2}%\u3002"
  - Name: skill_passive_name_48
    Text: "\u72C2\u66B4\u7194\u7089"
  - Name: skill_passive_detail_48
    Text: "\u5728\u6218\u6597\u7684\u524D{0}\u56DE\u5408\u4E2D\uFF0C\u6BCF\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u81EA\u8EAB\u66B4\u51FB\u7387\u63D0\u9AD8{1}%\uFF0C\u66B4\u51FB\u4F24\u5BB3\u63D0\u9AD8{2}%\uFF0C\u7834\u7532\u7387\u63D0\u9AD8{3}%\uFF0C\u6301\u7EED{4}\u56DE\u5408\u3002"
  - Name: skill_passive_name_49
    Text: "\u6BD2\u76AE"
  - Name: skill_passive_detail_49
    Text: "\u5267\u6BD2\u4E4B\u529B\u6E17\u5165\u5176\u4F53\u5185\uFF0C\u5F3A\u5316\u5176\u8840\u8089\u548C\u7532\u58F3\uFF0C\u4F7F\u751F\u547D\u503C\u63D0\u5347{0}%\uFF0C\u62A4\u7532\u63D0\u5347{1}%\u3002"
  - Name: skill_passive_name_50
    Text: "\u761F\u75AB\u5951\u7EA6"
  - Name: skill_passive_detail_50
    Text: "\u718A\u7684\u6BD2\u6DB2\u5F25\u6F2B\u5728\u6218\u573A\u4E0A\u3002\u6BCF\u5F53\u53CB\u519B\u66B4\u51FB\u65F6\uFF0C\u718A\u4F1A\u901A\u8FC7\u6BD2\u96FE\u5438\u53D6\u751F\u547D\u529B\uFF0C\u6062\u590D\u76F8\u5F53\u4E8E\u5176\u653B\u51FB\u529B{0}%\u7684\u751F\u547D\u503C\u3002"
  - Name: skill_passive_name_51
    Text: "\u8150\u8680\u6027\u7532\u58F3"
  - Name: skill_passive_detail_51
    Text: "\u53D7\u5230\u653B\u51FB\u65F6\uFF0C\u718A\u7684\u6BD2\u6DB2\u4F1A\u91CA\u653E\u6BD2\u6027\u53CD\u566C\uFF0C\u4F7F\u653B\u51FB\u8005\u7684\u7834\u7532\u6548\u679C\u964D\u4F4E{0}%\uFF0C\u5E76\u4F7F\u5176\u4E2D\u6BD2\uFF0C\u6BCF\u56DE\u5408\u9020\u6210{1}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_52
    Text: "\u94C1\u9AA8\u9707\u8361"
  - Name: skill_passive_detail_52
    Text: "\u5DE8\u9F99\u7684\u9AA8\u94A2\u5229\u722A\u88F9\u631F\u7740\u567C\u556A\u4F5C\u54CD\u7684\u96F7\u9706\uFF0C\u5176\u666E\u901A\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u5E76\u6709{1}%\u7684\u51E0\u7387\u4F7F\u76EE\u6807\u7729\u6655{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_53
    Text: "\u98CE\u66B4\u964D\u751F\u8840\u7EDF"
  - Name: skill_passive_detail_53
    Text: "\u9F99\u65CF\u8840\u7EDF\u8BDE\u751F\uFF0C\u8EAB\u62AB\u96F7\u9706\u6C38\u6052\u6012\u706B\uFF0C\u9F99\u7EE7\u627F\u4E86+{0}%\u751F\u547D\u503C\u3001+{1}%\u6280\u80FD\u4F24\u5BB3\u548C+{2}\u901F\u5EA6\u3002"
  - Name: skill_passive_name_54
    Text: "\u8BC5\u5492\u4E4B\u529B\u91CA\u653E"
  - Name: skill_passive_detail_54
    Text: "\u5F53\u5DE8\u9F99\u7684\u751F\u547D\u503C\u9996\u6B21\u4F4E\u4E8E1%\u65F6\uFF0C\u5B83\u4F1A\u653E\u5F03\u9632\u5FA1\uFF0C\u727A\u72722%\u7684\u9632\u5FA1\u529B\uFF0C\u83B7\u5F973%\u7684\u653B\u51FB\u529B\u63D0\u5347\uFF0C\u6301\u7EED4\u56DE\u5408\uFF0C\u91CA\u653E\u5176\u539F\u59CB\u98CE\u66B4\u4E4B\u529B\u3002"
  - Name: skill_passive_name_55
    Text: "\u5730\u72F1\u4E4B\u5FC3"
  - Name: skill_passive_detail_55
    Text: "\u751F\u547D\u503C\u589E\u52A0{0}%\uFF0C\u653B\u51FB\u529B\u589E\u52A0{1}%\uFF0C\u66B4\u51FB\u7387\u589E\u52A0{2}%\u3002"
  - Name: skill_passive_name_56
    Text: "\u70BD\u70ED\u53F7\u89D2"
  - Name: skill_passive_detail_56
    Text: "\u6BCF\u6B21\u666E\u901A\u653B\u51FB\u90FD\u4F1A\u4F34\u968F\u7740\u71C3\u70E7\u7684\u6012\u706B\uFF0C\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\u5E76\u65BD\u52A0\u707C\u70E7\u6548\u679C\uFF0C\u707C\u70E7\u6548\u679C\u6BCF\u56DE\u5408\u5BF9\u76EE\u6807\u9020\u6210{1}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_passive_name_57
    Text: "\u5730\u72F1\u5486\u54EE"
  - Name: skill_passive_detail_57
    Text: "\u6BCF\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u91CA\u653E\u51FA\u707C\u70ED\u7684\u706B\u7130\u6CE2\uFF0C\u711A\u70E7\u6240\u6709\u654C\u4EBA\uFF0C\u6BCF\u56DE\u5408\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u6301\u7EED{1}\u56DE\u5408\u3002\u6218\u573A\u5728\u5176\u6012\u706B\u4E0B\u5316\u4E3A\u4E00\u7247\u70BC\u72F1\u3002"
  - Name: skill_passive_name_58
    Text: "\u91CE\u7FFC\u8A93\u8A00"
  - Name: skill_passive_detail_58
    Text: "\u589E\u52A0\u751F\u547D\u503C{0}%\uFF0C\u653B\u51FB\u529B{1}%\uFF0C\u5E76\u83B7\u5F97{2}%\u7684\u751F\u547D\u503C\u56DE\u590D\u3002"
  - Name: skill_passive_name_59
    Text: "\u68EE\u6797\u4E4B\u5149"
  - Name: skill_passive_detail_59
    Text: "\u8FDB\u884C\u666E\u901A\u653B\u51FB\u65F6\uFF0C\u5BF91\u540D\u968F\u673A\u53CB\u65B9\u5355\u4F4D\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u56DE\u590D\u76F8\u5F53\u4E8E\u65BD\u6CD5\u8005{1}%\u653B\u51FB\u529B\u7684\u751F\u547D\u503C\uFF0C\u540C\u65F6\u8D4B\u4E88\u8BE5\u5355\u4F4D\u6301\u7EED{2}\u56DE\u5408\u7684\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\u6548\u679C\u3002\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\uFF1A\u5F53\u62E5\u6709\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\u6548\u679C\u7684\u82F1\u96C4\u53D7\u5230\u66B4\u51FB\u4F24\u5BB3\u65F6\uFF0C\u56DE\u590D\u76F8\u5F53\u4E8E\u65BD\u6CD5\u8005{3}%\u653B\u51FB\u529B\u7684\u751F\u547D\u503C\u3002\u6B64\u6548\u679C\u5728\u6FC0\u6D3B\u540E\u7ACB\u5373\u6D88\u5931\uFF0C\u4F46\u53EF\u4EE5\u53E0\u52A0\u3002"
  - Name: skill_passive_name_60
    Text: "\u68EE\u6797\u4E4B\u6012"
  - Name: skill_passive_detail_60
    Text: "\u5F53\u751F\u547D\u503C\u5728\u6218\u6597\u4E2D\u9996\u6B21\u964D\u81F3{0}%\u4EE5\u4E0B\u65F6\uFF0C\u53EC\u5524\u53E4\u4EE3\u68EE\u6797\u4E4B\u529B\uFF0C\u4F7F\u653B\u51FB\u529B\u5728{2}\u56DE\u5408\u5185\u63D0\u5347{1}%\uFF0C\u5E76\u6062\u590D\u76F8\u5F53\u4E8E\u653B\u51FB\u529B{3}%\u7684\u751F\u547D\u503C\u3002"
  - Name: skill_passive_name_1001
    Text: "\u4E0D\u673D"
  - Name: skill_passive_detail_1001
    Text: "Boss\u91CD\u751F\u540E\uFF0C\u6B7B\u4EA1\u65F6\u4F1A\u83B7\u5F97\u66F4\u9AD8\u7684\u751F\u547D\u503C\u548C\u653B\u51FB\u529B\u3002"
  - Name: skill_active_name_0
    Text: "\u57FA\u5730\u653B\u51FB"
  - Name: skill_active_detail_0
    Text: "\u57FA\u5730\u653B\u51FB"
  - Name: skill_active_name_1
    Text: "\u706B\u7130\u7206\u53D1"
  - Name: skill_active_detail_1
    Text: "\u5BF9\u968F\u673A\u654C\u4EBA\u9020\u62100%\u4F24\u5BB3\uFF0C\u5E76\u5728\u7B2C3\u56DE\u5408\u63D0\u5347\u6240\u6709\u53CB\u519B\u7684\u901F\u5EA62\u500D\u3002"
  - Name: skill_active_name_2
    Text: "\u96F7\u9E23"
  - Name: skill_active_detail_2
    Text: "\u5BF9\u540E\u6392\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\u3002"
  - Name: skill_active_name_3
    Text: "\u795E\u5723\u4E4B\u76FE"
  - Name: skill_active_detail_3
    Text: "\u5728{3}\u56DE\u5408\u5185\u5BF9{1}\u4E2A\u968F\u673A\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u5E76\u964D\u4F4E\u5176{2}\u901F\u5EA6\u3002"
  - Name: skill_active_name_4
    Text: "\u6BD2\u6DB2\u5C04\u51FB"
  - Name: skill_active_detail_4
    Text: "\u5BF9\u751F\u547D\u503C\u6700\u4F4E\u7684\u76EE\u6807\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u65BD\u52A0\u6D41\u8840\u6548\u679C\uFF0C\u5728{2}\u56DE\u5408\u5185\u9020\u6210{1}%\u4F24\u5BB3\u3002"
  - Name: skill_active_name_5
    Text: "\u7728\u6B65"
  - Name: skill_active_detail_5
    Text: "\u5BF9{0}%\u4F24\u5BB3\uFF0C\u968F\u673A\u964D\u4F4E{1}\u4E2A\u654C\u4EBA\u7684\u901F\u5EA6\uFF0C\u6301\u7EED{3}\u56DE\u5408\uFF0C\u540C\u65F6\u964D\u4F4E\u6240\u6709\u53CB\u519B{4}%\u7684\u6700\u5927\u751F\u547D\u503C\u3002"
  - Name: skill_active_name_6
    Text: "\u7075\u9B42\u6C72\u53D6"
  - Name: skill_active_detail_6
    Text: "\u5BF9\u540E\u6392\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u5E76\u6709{1}%\u7684\u51E0\u7387\u4F7F\u5176\u6C89\u9ED8{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_7
    Text: "\u971C\u94FE"
  - Name: skill_active_detail_7
    Text: "\u5BF9\u540E\u6392\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u5E76\u5728{2}\u56DE\u5408\u5185\u6709{1}%\u7684\u51E0\u7387\u4F7F\u5176\u6C89\u9ED8\u3002"
  - Name: skill_active_name_8
    Text: "\u6D41\u661F\u8DF3\u4F1E"
  - Name: skill_active_detail_8
    Text: "\u5BF9\u540E\u6392\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u5E76\u964D\u4F4E{2}\u4E2A\u968F\u673A\u654C\u4EBA\u7684{1}\u70B9\u6012\u6C14\u3002"
  - Name: skill_active_name_9
    Text: "\u7597\u6108\u6CE2"
  - Name: skill_active_detail_9
    Text: "\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u5E76\u6709{1}%\u7684\u51E0\u7387\u4F7F\u5176\u51BB\u7ED3{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_10
    Text: "\u65F6\u95F4\u626D\u66F2"
  - Name: skill_active_detail_10
    Text: "\u5BF9\u653B\u51FB\u529B\u6700\u9AD8\u7684\u654C\u4EBA\u9020\u6210{0}%\u7684\u4F24\u5BB3\u3002\u53E0\u52A0\u4E00\u5C42\u9F99\u65A9\u6548\u679C\uFF0C\u6BCF\u5C42\u6548\u679C\u63D0\u5347{1}%\u7684\u4F24\u5BB3\u3002"
  - Name: skill_active_name_11
    Text: "\u9ED1\u6697\u568E\u53EB"
  - Name: skill_active_detail_11
    Text: "\u5BF9\u751F\u547D\u503C\u6700\u9AD8\u7684\u654C\u4EBA\u9020\u62100%\u7684\u4F24\u5BB3\uFF0C\u5916\u52A0\u76F8\u5F53\u4E8E\u5176\u6700\u5927\u751F\u547D\u503C1%\u7684\u771F\u5B9E\u4F24\u5BB3\uFF08\u6700\u9AD8\u53EF\u8FBE\u653B\u51FB\u529B\u76842\u70B9\uFF09\u3002\u4F7F\u5176\u57284\u56DE\u5408\u5185\u6301\u7EED\u707C\u70E7\uFF0C\u9020\u6210\u76F8\u5F53\u4E8E\u5176\u6700\u5927\u751F\u547D\u503C3%\u7684\u771F\u5B9E\u4F24\u5BB3\u3002"
  - Name: skill_active_name_12
    Text: "\u5200\u950B\u65CB\u98CE"
  - Name: skill_active_detail_12
    Text: "\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u4F24\u5BB3\uFF0C\u4E3A\u751F\u547D\u503C\u6700\u4F4E\u7684\u53CB\u519B\u56DE\u590D\u76F8\u5F53\u4E8E\u653B\u51FB\u529B{1}%\u7684\u751F\u547D\u503C\uFF0C\u5E76\u6709{2}%\u7684\u51E0\u7387\u4F7F{3}\u4E2A\u654C\u4EBA\u7729\u6655{4}\u56DE\u5408\u3002"
  - Name: skill_active_name_13
    Text: "\u98CE\u66B4\u4E4B\u7259\u65A9"
  - Name: skill_active_detail_13
    Text: "\u7528\u9570\u5200\u65A9\u6740\u4E00\u6392\u654C\u4EBA\uFF0C\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\u3002\u6709{1}%\u7684\u51E0\u7387\u4F7F\u53D7\u5F71\u54CD\u7684\u654C\u4EBA\u51B0\u51BB{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_14
    Text: "\u53CC\u7259\u731B\u6251"
  - Name: skill_active_detail_14
    Text: "\u7A81\u88AD\u540E\u6392\uFF0C\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\u3002\u65E0\u89C6\u683C\u6321\u3002\u9644\u52A0\u6D41\u8840\u8346\u68D8\u6548\u679C\uFF0C\u4F7F\u76EE\u6807\u5728\u63A5\u4E0B\u6765\u76842\u56DE\u5408\u5185\u6BCF\u56DE\u5408\u989D\u5916\u53D7\u5230{1}%\u653B\u51FB\u529B\u4F24\u5BB3\u3002"
  - Name: skill_active_name_15
    Text: "\u6D77\u6218"
  - Name: skill_active_detail_15
    Text: "\u53EC\u5524\u5E7D\u7075\u6218\u65A7\u98CE\u66B4\uFF0C\u91CA\u653E\u51FA\u51B0\u971C\u4E4B\u529B\u3002\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\uFF0C\u5E76\u6709{1}%\u7684\u51E0\u7387\u4F7F\u5176\u51B0\u51BB{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_16
    Text: "\u706B\u7130\u62F3\u649E\u51FB"
  - Name: skill_active_detail_16
    Text: "\u53CC\u624B\u71C3\u8D77\u707C\u70ED\u7684\u706B\u7130\uFF0C\u5411\u5916\u731B\u51FB\uFF0C\u91CA\u653E\u51FA\u4E00\u80A1\u706B\u7130\u6CE2\uFF0C\u707C\u70E7\u6240\u6709\u654C\u4EBA\uFF0C\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u4F7F\u5176\u6BCF\u56DE\u5408\u71C3\u70E7{1}%\u653B\u51FB\u529B\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_17
    Text: "\u5730\u7259\u65AD\u5934\u53F0"
  - Name: skill_active_detail_17
    Text: "\u5BF9\u751F\u547D\u503C\u6700\u4F4E\u7684\u4E24\u540D\u654C\u4EBA\u53D1\u52A8\u653B\u51FB\uFF0C\u9020\u6210\u653B\u51FB\u529B{0}%\u7684\u4F24\u5BB3\u3002\u65E0\u89C6\u683C\u6321\u3002\u9020\u6210\u76F8\u5F53\u4E8E\u76EE\u6807\u5DF2\u635F\u5931\u751F\u547D\u503C{1}%\u7684\u989D\u5916\u4F24\u5BB3\uFF08\u6700\u9AD8\u4E0D\u8D85\u8FC7\u653B\u51FB\u529B{2}%\uFF09\u3002\u5982\u679C\u76EE\u6807\u751F\u547D\u503C\u4F4E\u4E8E\u8718\u86DB\uFF0C\u5219\u6709{3}%\u7684\u51E0\u7387\u4F7F\u5176\u7729\u6655{4}\u56DE\u5408\u3002"
  - Name: skill_active_name_18
    Text: "\u516C\u725B\u706B\u7C89\u788E"
  - Name: skill_active_detail_18
    Text: "\u5BF9\u524D\u6392\u65BD\u653E\u70C8\u7130\u4E4B\u9524\uFF0C\u9020\u6210\u653B\u51FB\u529B{0}%\u7684\u4F24\u5BB3\u3002\u653B\u51FB\u529B\u63D0\u5347{1}%\uFF0C\u7834\u7532\u7387\u63D0\u5347{2}%\uFF0C\u6301\u7EED{3}\u56DE\u5408\u3002\u540C\u65F6\u9020\u6210\u76F8\u5F53\u4E8E\u76EE\u6807\u6700\u5927\u751F\u547D\u503C{4}%\u7684\u989D\u5916\u4F24\u5BB3\uFF08\u4F24\u5BB3\u4E0A\u9650\u4E3A\u653B\u51FB\u529B{5}%\uFF09\u3002"
  - Name: skill_active_name_19
    Text: "\u70BC\u72F1\u730E\u6740"
  - Name: skill_active_detail_19
    Text: "\u91CA\u653E\u707C\u70ED\u706B\u7130\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u964D\u4F4E\u5176\u901F\u5EA6{1}\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_20
    Text: "\u9AA8\u9707\u5486\u54EE"
  - Name: skill_active_detail_20
    Text: "\u91CA\u653E\u8574\u542B\u98CE\u66B4\u4E4B\u5149\u7684\u96F7\u9706\u5486\u54EE\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\u3002\u6BCF\u4E2A\u76EE\u6807\u6709{1}%\u7684\u6982\u7387\u88AB\u7729\u6655{2}\u56DE\u5408\uFF0C\u5E76\u6709{3}%\u7684\u6982\u7387\u635F\u5931{4}\u70B9\u80FD\u91CF\u3002"
  - Name: skill_active_name_21
    Text: "\u70BC\u72F1\u730E\u6740"
  - Name: skill_active_detail_21
    Text: "\u91CA\u653E\u707C\u70ED\u706B\u7130\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u964D\u4F4E\u5176\u901F\u5EA6{1}\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002"
  - Name: skill_active_name_22
    Text: "\u68EE\u6797\u795D\u798F"
  - Name: skill_active_detail_22
    Text: "\u91CA\u653E\u68EE\u6797\u4E4B\u795E\u7684\u795D\u798F\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210\u76F8\u5F53\u4E8E\u81EA\u8EAB\u653B\u51FB\u529B{0}%\u7684\u4F24\u5BB3\uFF0C\u5E76\u4E3A\u6240\u6709\u53CB\u65B9\u56DE\u590D\u76F8\u5F53\u4E8E\u81EA\u8EAB\u653B\u51FB\u529B{1}%\u7684\u751F\u547D\u503C\u3002\u8D4B\u4E88\u6240\u6709\u53CB\u65B9\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\u6548\u679C\uFF0C\u6301\u7EED{2}\u56DE\u5408\u3002\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\uFF1A\u5F53\u62E5\u6709\u201C\u7FE0\u7EFF\u6069\u6CFD\u201D\u6548\u679C\u7684\u82F1\u96C4\u53D7\u5230\u66B4\u51FB\u4F24\u5BB3\u65F6\uFF0C\u56DE\u590D\u76F8\u5F53\u4E8E\u65BD\u6CD5\u8005\u653B\u51FB\u529B{3}%\u7684\u751F\u547D\u503C\u3002\u6B64\u6548\u679C\u5728\u53D1\u52A8\u540E\u7ACB\u5373\u6D88\u5931\uFF0C\u4F46\u53EF\u4EE5\u53E0\u52A0\u3002"
  - Name: gear_skill_active_name_1
    Text: "\u94A2\u94C1\u98CE\u66B4\u5B89\u9B42\u66F2"
  - Name: gear_skill_active_detail_1
    Text: "\u53EC\u5524\u5E7D\u7075\u5251\u98CE\u66B4\uFF0C\u91CA\u653E\u91D1\u5C5E\u80FD\u91CF\u51B2\u51FB\u6CE2\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u4F24\u5BB3\u3002"
  - Name: gear_skill_active_name_2
    Text: "\u5730\u7206"
  - Name: gear_skill_active_detail_2
    Text: "\u91CA\u653E\u9707\u5929\u52A8\u5730\u7684\u7206\u70B8\uFF0C\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210\u571F\u5C5E\u6027{0}%\u653B\u51FB\u529B\u4F24\u5BB3\u3002"
  - Name: gear_skill_active_name_3
    Text: "\u5730\u72F1\u6536\u5272"
  - Name: gear_skill_active_detail_3
    Text: "\u7528\u71C3\u70E7\u7684\u9570\u5200\u65A9\u6740\u654C\u4EBA\uFF0C\u5C06\u4ED6\u4EEC\u5305\u88F9\u5728\u706B\u7130\u4E2D\uFF0C\u5E76\u5BF9\u6240\u6709\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u706B\u7130\u4F24\u5BB3\u3002"
  - Name: gear_skill_passive_name_1
    Text: "\u7834\u7532"
  - Name: gear_skill_passive_detail_1
    Text: "\u589E\u52A0\u7834\u7532\u51E0\u7387{0}%"
  - Name: gear_skill_passive_name_2
    Text: "\u4F24\u5BB3\u51CF\u514D"
  - Name: gear_skill_passive_detail_2
    Text: "\u589E\u52A0\u4F24\u5BB3\u51CF\u514D{0}%"
  - Name: gear_skill_passive_name_3
    Text: "\u5835\u585E"
  - Name: gear_skill_passive_detail_3
    Text: "\u589E\u52A0\u65B9\u5757\u6570\u91CF {0}%"
  - Name: gear_skill_passive_name_4
    Text: "\u62A4\u7532\u7834\u635F\u6297\u6027"
  - Name: gear_skill_passive_detail_4
    Text: "\u62A4\u7532\u7834\u7532\u6297\u6027\u63D0\u9AD8{0}%\u3002"
  - Name: gear_skill_passive_name_5
    Text: "\u6279\u5224"
  - Name: gear_skill_passive_detail_5
    Text: "\u66B4\u51FB\u7387\u63D0\u9AD8{0}%\u3002"
  - Name: gear_skill_passive_name_6
    Text: "\u963B\u503C"
  - Name: gear_skill_passive_detail_6
    Text: "\u589E\u52A0\u65B9\u5757\u6297\u6027 {0}%"
  - Name: gear_skill_passive_name_7
    Text: "\u6280\u80FD\u4F24\u5BB3"
  - Name: gear_skill_passive_detail_7
    Text: "\u6280\u80FD\u4F24\u5BB3\u63D0\u9AD8{0}%\u3002"
  - Name: gear_skill_passive_name_8
    Text: "\u66B4\u51FB\u6297\u6027"
  - Name: gear_skill_passive_detail_8
    Text: "\u66B4\u51FB\u6297\u6027\u63D0\u9AD8{0}%\u3002"
  - Name: gear_skill_passive_name_9
    Text: "\u635F\u5BB3"
  - Name: gear_skill_passive_detail_9
