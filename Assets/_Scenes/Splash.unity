    Text: "\u94A2\u94C1\u610F\u5FD7"
  - Name: skill_passive_detail_2
    Text: "\u964D\u4F4E\u524D\u5217\u654C\u4EBA\u7684{0}%\u9632\u5FA1\u529B\uFF0C\u6301\u7EED{1}\u56DE\u5408\u3002"
