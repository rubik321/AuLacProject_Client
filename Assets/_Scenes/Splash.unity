    Text: "\u8FDB\u5316\u56DE\u58F0"
  - Name: evolve_confirm_content
    Text: "\u4F60\u7684\u56DE\u54CD\u5373\u5C06\u8FDB\u5316\u5230\u66F4\u9AD8\u5F62\u6001\u3002\u8FD9\u6B21\u8FDB\u5316\u662F\u4E0D\u53EF\u9006\u7684\u3002\u4F60\u662F\u5426\u613F\u610F\u7EE7\u7EED\uFF1F"
  - Name: location_service_title
    Text: "\u91CA\u653E\u4F60\u7684\u5192\u9669\u7CBE\u795E\uFF01"
  - Name: location_service_detail
    Text: "\u8E0F\u4E0A\u5145\u6EE1\u523A\u6FC0\u6218\u6597\u548C\u9690\u85CF\u5B9D\u85CF\u7684\u53F2\u8BD7\u5192\u9669\u4E4B\u65C5\uFF01\u4E3A\u4E86\u63D0\u5347\u60A8\u7684\u6E38\u620F\u4F53\u9A8C\uFF0C\u6211\u4EEC\u9700\u8981\u60A8\u6388\u4E88\u6211\u4EEC\u8BBF\u95EE\u60A8\u4F4D\u7F6E\u4FE1\u606F\u7684\u6743\u9650\u3002\u8FD9\u5C06\u4F7F\u6211\u4EEC\u80FD\u591F\u91CA\u653E\u9644\u8FD1\u7684\u602A\u7269\u5E76\u63ED\u793A\u795E\u79D8\u7684\u661F\u754C\u3002\u51C6\u5907\u597D\u4E0E\u6F5C\u4F0F\u5728\u60A8\u9644\u8FD1\u7684\u602A\u7269\u5C55\u5F00\u6FC0\u70C8\u7684\u6218\u6597\u5427\uFF01\u4F7F\u7528\u661F\u754C\u524D\u5F80\u6FC0\u52A8\u4EBA\u5FC3\u7684\u65B0\u9886\u57DF\uFF0C\u8FCE\u63A5\u65B0\u7684\u6311\u6218\uFF01\u542F\u7528\u6B64\u529F\u80FD\u5373\u53EF\u5F00\u542F\u8FD9\u6BB5\u96BE\u5FD8\u7684\u5192\u9669\u4E4B\u65C5\u3002\u60A8\u4E4B\u540E\u53EF\u4EE5\u968F\u65F6\u8C03\u6574\u60A8\u7684\u4F4D\u7F6E\u8BBE\u7F6E\u3002"
  - Name: adv_reach_cap
    Text: "\u60A8\u5DF2\u8FBE\u5230\u6BCF\u65E5\u5E7F\u544A\u9650\u989D\uFF01"
