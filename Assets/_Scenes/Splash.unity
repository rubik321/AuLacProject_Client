  - Name: gear_16_name
    Text: "\u51B2\u51FB\u4E4B\u51A0"
  - Name: gear_17_name
    Text: "\u6A61\u5FC3\u76FE"
  - Name: gear_18_name
    Text: "\u91D1\u90A6\u5FB7"
  - Name: gear_19_name
    Text: "\u683C\u96F7\u592B\u8FC8\u5C14\u4E4B\u73AF"
  - Name: gear_20_name
    Text: "\u7EF4\u91CC\u8FEA\u4E9A\u65AF\u5377\u8F74"
  - Name: gear_0_des
    Text: "\u91D1\u8272\u7684\u53D1\u4E1D\u5728\u5149\u8292\u7684\u795D\u798F\u4E0B\u95EA\u8000\uFF0C\u8C61\u5F81\u7740\u9A91\u58EB\u575A\u5B9A\u4E0D\u79FB\u7684\u4FE1\u5FF5\u548C\u6218\u573A\u4E0A\u7684\u82F1\u52C7\u65E0\u754F\u3002"
  - Name: gear_1_des
    Text: "\u8FD9\u5957\u6218\u8863\u7531\u9668\u843D\u6052\u661F\u7684\u6838\u5FC3\u953B\u9020\u800C\u6210\uFF0C\u80FD\u5C06\u7EAF\u7CB9\u7684\u5149\u8292\u8F6C\u5316\u4E3A\u8FD1\u4E4E\u575A\u4E0D\u53EF\u6467\u7684\u5C4F\u969C\u3002"
  - Name: gear_2_des
    Text: "\u91D1\u8272\u7684\u53D1\u4E1D\u5728\u5149\u8292\u7684\u795D\u798F\u4E0B\u95EA\u8000\uFF0C\u8C61\u5F81\u7740\u9A91\u58EB\u575A\u5B9A\u4E0D\u79FB\u7684\u4FE1\u5FF5\u548C\u6218\u573A\u4E0A\u7684\u82F1\u52C7\u65E0\u754F\u3002"
  - Name: gear_3_des
    Text: "\u66FE\u7ECF\u7531\u8054\u76DF\u5B88\u536B\u8005\u4F69\u6234\u7684\u91D1\u8272\u5FBD\u7AE0\uFF0C\u95EA\u8000\u7740\u5149\u8292\uFF0C\u6FC0\u52B1\u52C7\u6C14\uFF0C\u9F13\u821E\u76DF\u53CB\u3002"
  - Name: gear_4_des
    Text: "\u6BCF\u9897\u6C34\u6676\u90FD\u4E0E\u76D6\u4E9A\u7684\u672C\u8D28\u4EA7\u751F\u5171\u9E23\uFF0C\u5C06\u5148\u7956\u548C\u4ED6\u4EEC\u7684\u4F19\u4F34\u4EEC\u8054\u7CFB\u5728\u4E00\u8D77\uFF0C\u5171\u4EAB\u6D3B\u529B\u548C\u6301\u4E45\u7684\u529B\u91CF\u3002"
  - Name: gear_5_des
    Text: "\u5B83\u7531\u76D6\u4E9A\u4E4B\u5FC3\u953B\u9020\u800C\u6210\uFF0C\u8574\u542B\u7740\u5F3A\u5927\u7684\u80FD\u91CF\uFF0C\u80FD\u591F\u589E\u5F3A\u4F69\u6234\u8005\u7684\u901F\u5EA6\u3002"
  - Name: gear_6_des
    Text: "\u8FD9\u4E9B\u4ECE\u6C38\u6052\u5E9F\u589F\u4E2D\u56DE\u6536\u7684\u4E66\u9875\u95EA\u70C1\u7740\u88AB\u9057\u5FD8\u7684\u661F\u5149\uFF0C\u589E\u5F3A\u4E86\u5B83\u7684\u961F\u4F0D\u3002"
  - Name: gear_7_des
    Text: "\u4E00\u628A\u7531\u9AA8\u5934\u3001\u77F3\u5934\u548C\u90E8\u843D\u7B26\u6587\u953B\u9020\u800C\u6210\u7684\u6B8B\u66B4\u6218\u65A7\u3002\u5B83\u7531\u914B\u957F\u4EEC\u4EE3\u4EE3\u76F8\u4F20\uFF0C\u6325\u821E\u65F6\u5145\u6EE1\u539F\u59CB\u7684\u72C2\u6012\u548C\u65E0\u60C5\u7684\u590D\u4EC7\u3002"
  - Name: gear_8_des
    Text: "\u8FD9\u4EF6\u76D4\u7532\u7531\u517D\u76AE\u5236\u6210\uFF0C\u5E76\u4EE5\u91D1\u5C5E\u52A0\u56FA\uFF0C\u4E0A\u9762\u5E03\u6EE1\u4E86\u767E\u573A\u6218\u5F79\u7684\u75D5\u8FF9\u3002\u5B83\u53D7\u5230\u90E8\u843D\u6218\u795E\u7684\u795D\u798F\uFF0C\u662F\u65CF\u957F\u7684\u8C61\u5F81\u3002"
  - Name: gear_9_des
    Text: "\u84EC\u677E\u7684\u84DD\u8272\u5934\u53D1\uFF0C\u636E\u8BF4\u53D7\u5230\u6D77\u6D0B\u7CBE\u7075\u7684\u795D\u798F\u3002\u4EBA\u4EEC\u76F8\u4FE1\uFF0C\u4F69\u6234\u8FD9\u79CD\u5934\u53D1\u7684\u4EBA\u80FD\u591F\u6C72\u53D6\u6D77\u6D0B\u7684\u529B\u91CF\u548C\u575A\u5B9A\u7684\u610F\u5FD7\u3002"
  - Name: gear_10_des
    Text: "\u8FD9\u9762\u76FE\u724C\u4E0A\u523B\u6709\u7EF4\u6D1B\u5C14\u65CF\u7684\u7687\u5BB6\u5370\u7AE0\uFF0C\u7EF4\u6D1B\u5C14\u65CF\u66FE\u4E0E\u62C2\u6653\u8840\u76DF\u5E76\u80A9\u4F5C\u6218\uFF0C\u627F\u8F7D\u7740\u4ED6\u4EEC\u7684\u8363\u8A89\u548C\u529B\u91CF\u3002"
  - Name: gear_11_des
    Text: "\u5B83\u4EE5\u7FE1\u7FE0\u7CBE\u534E\u953B\u9020\u800C\u6210\uFF0C\u4EE5\u6B64\u7EAA\u5FF5\u90A3\u4E9B\u5728\u76D6\u4E9A\u5371\u96BE\u4E4B\u9645\u5B88\u62A4\u5979\u7684\u5DF2\u6545\u5148\u8D24\u3002"
  - Name: gear_12_des
    Text: "\u8FD9\u679A\u6212\u6307\u5728\u706B\u5C71\u7194\u7089\u4E2D\u953B\u9020\u800C\u6210\uFF0C\u5B83\u8574\u542B\u7740\u76AE\u62C9\u897F\u65AF\u70BD\u70ED\u7684\u751F\u547D\u4E4B\u8840\uFF0C\u80FD\u591F\u8D4B\u4E88\u4F69\u6234\u8005\u52C7\u6C14\u3002"
  - Name: gear_13_des
    Text: "\u4E00\u4EFD\u53E4\u8001\u7684\u624B\u7A3F\uFF0C\u8BB0\u5F55\u7740\u76D6\u4E9A\u6700\u521D\u7684\u547C\u5438\u3002\u5B83\u7684\u6587\u5B57\u629A\u6170\u7740\u7075\u9B42\uFF0C\u5B88\u62A4\u7740\u8089\u4F53\u3002"
  - Name: gear_14_des
    Text: "\u4E00\u53EA\u5F2F\u66F2\u7684\u673A\u68B0\u722A\uFF0C\u914D\u6709\u81EA\u9002\u5E94\u5200\u7247\u3002\u5B83\u5207\u5272\u65F6\u65E2\u6709\u624B\u672F\u5200\u822C\u7684\u7CBE\u51C6\uFF0C\u53C8\u6709\u91CE\u517D\u822C\u7684\u51F6\u731B\u3002"
  - Name: gear_15_des
    Text: "\u8FD9\u6B3E\u6DF1\u7EA2\u8272\u76D4\u7532\u7531\u5F3A\u5316\u5408\u91D1\u953B\u9020\u800C\u6210\uFF0C\u5E76\u4EE5\u80FD\u91CF\u6838\u5FC3\u4E3A\u52A8\u529B\uFF0C\u5C06\u86EE\u529B\u4E0E\u7CBE\u5BC6\u5DE5\u7A0B\u5B8C\u7F8E\u878D\u5408\u3002"
  - Name: gear_16_des
    Text: "\u72C2\u91CE\u7684\u94F6\u767D\u8272\u5934\u53D1\uFF0C\u636E\u8BF4\u5728\u6218\u6597\u4E34\u8FD1\u65F6\u4F1A\u8FF8\u53D1\u51FA\u60CA\u4EBA\u7684\u80FD\u91CF\u3002\u8FD9\u662F\u4E0E\u80FD\u91CF\u6838\u5FC3\u76F8\u8FDE\u7684\u9A91\u58EB\u7684\u6807\u5FD7\u3002"
  - Name: gear_17_des
    Text: "\u5B83\u5E26\u6709\u4F4E\u8BED\u68EE\u6797\u53E4\u6811\u7684\u5370\u8BB0\uFF0C\u4EE5\u5143\u7D20\u7CBE\u7075\u7684\u6301\u4E45\u529B\u91CF\u4FDD\u62A4\u76DF\u53CB\u3002"
  - Name: gear_18_des
    Text: "\u76F8\u8FDE\u7684\u91D1\u8272\u5B9D\u77F3\u6784\u6210\u56E2\u7ED3\u7684\u76DF\u7EA6\uFF0C\u8D4B\u4E88\u5E76\u80A9\u4F5C\u6218\u8005\u6301\u4E45\u7684\u529B\u91CF\u3002"
  - Name: gear_19_des
    Text: "\u8FD9\u679A\u523B\u6709\u86C7\u5F62\u56FE\u6848\u7684\u6212\u6307\u662F\u5728\u5931\u843D\u7684\u7EF4\u91CC\u8FEA\u4E9A\u65AF\u5723\u6BBF\u953B\u9020\u800C\u6210\uFF0C\u5982\u4ECA\u627F\u8F7D\u7740\u4E00\u4F4D\u54E8\u5175\u5931\u843D\u7684\u9057\u4EA7\u3002"
  - Name: gear_20_des
    Text: "\u8FD9\u4EFD\u624B\u7A3F\u662F\u4ECE\u5723\u57DF\u7EF4\u91CC\u8FEA\u4E9A\u65AF\u9677\u843D\u540E\u56DE\u6536\u7684\uFF0C\u5B83\u5C06\u54E8\u5175\u7684\u667A\u6167\u6CE8\u5165\u5230\u4FDD\u62A4\u7ED3\u754C\u4E2D\u3002"
  - Name: gear_sub_upgrade
    Text: "\u5347\u7EA7\u88C5\u5907\uFF0C\u63D0\u5347\u82F1\u96C4\u5B9E\u529B\u3002"
  - Name: gear_sub_max_level
    Text: "\u88C5\u5907\u7B49\u7EA7\u4E0D\u80FD\u8D85\u8FC7\u73A9\u5BB6\u7B49\u7EA7\u3002"
