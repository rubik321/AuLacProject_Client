  - Name: linked_account_notic
    Text: "\u60A8\u7684 Myrk \u8D26\u6237 {0} \u5DF2\u6210\u529F\u5173\u8054\u3002"
  - Name: link_account_not_login
    Text: "\u8BF7\u767B\u5F55\u540E\u7EE7\u7EED\u3002"
  - Name: link_account_title
    Text: "\u521B\u5EFA\u8D26\u6237"
  - Name: link_account_warrning
    Text: "\u60A8\u76EE\u524D\u4EE5\u8BBF\u5BA2\u8EAB\u4EFD\u8FDB\u884C\u6E38\u620F\u3002\u8BF7\u5173\u8054\u60A8\u7684\u8D26\u53F7\u4EE5\u907F\u514D\u6570\u636E\u4E22\u5931\u3002\u524D\u5F80\u201C\u8BBE\u7F6E\u201D\uFF08\u5C4F\u5E55\u53F3\u4E0A\u89D2\uFF09\uFF0C\u7136\u540E\u70B9\u51FB\u201C\u5173\u8054\u201D\u6309\u94AE\u3002"
  - Name: land
    Text: "\u571F\u5730"
  - Name: race_name_0
    Text: "\u76D6\u4E9A"
  - Name: race_name_1
    Text: "\u673A\u7535\u4E00\u4F53\u5316"
  - Name: race_name_2
    Text: "\u5C3C\u6CD5\u91CC\u5B89"
  - Name: race_name_3
    Text: "\u4F59\u70EC\u6C11"
  - Name: race_name_4
    Text: "\u963F\u5361\u5C3C\u4E9A"
  - Name: race_name_5
    Text: "\u79FB\u4F4D\u8005"
  - Name: race_detail_0
    Text: "\u76D6\u4E9A\u662F\u4E00\u9897\u7C7B\u4F3C\u5730\u7403\u7684\u661F\u7403\uFF0C\u5C45\u4F4F\u7740\u8FD9\u4E9B\u4EBA\uFF0C\u4ED6\u4EEC\u4E0E\u81EA\u7136\u548C\u52A8\u7269\u6709\u7740\u6DF1\u539A\u7684\u8054\u7CFB\u3002\u4ED6\u4EEC\u80FD\u4E0E\u52A8\u7269\u4EA4\u6D41\uFF0C\u5E76\u8FD0\u7528\u5927\u5730\u9B54\u6CD5\u6765\u64CD\u63A7\u81EA\u7136\u754C\u3002"
  - Name: race_detail_1
    Text: "\u8FD9\u662F\u4E00\u4E2A\u751F\u6D3B\u5728\u9AD8\u79D1\u6280\u661F\u7403\u4E0A\u7684\u8D5B\u535A\u683C\u79CD\u65CF\uFF0C\u62E5\u6709\u9AD8\u5EA6\u53D1\u8FBE\u7684\u6587\u660E\u3002\u4ED6\u4EEC\u7684\u8EAB\u4F53\u7531\u673A\u68B0\u6784\u9020\u3001\u673A\u5668\u4EBA\u548C\u4EBA\u5DE5\u667A\u80FD\u6784\u6210\u3002\u4ED6\u4EEC\u7684\u529B\u91CF\u6E90\u4E8E\u4ED6\u4EEC\u7684\u521B\u9020\u529B\u548C\u5BF9\u6280\u672F\u7684\u6DF1\u523B\u7406\u89E3\u3002"
  - Name: race_detail_2
    Text: "\u6765\u81EA\u9065\u8FDC\u661F\u7403\u7684\u5916\u661F\u4EBA\uFF0C\u90A3\u91CC\u73AF\u5883\u6076\u52A3\u3002\u4ED6\u4EEC\u62E5\u6709\u84DD\u8272\u7684\u76AE\u80A4\uFF0C\u80FD\u591F\u64CD\u63A7\u6C34\u5143\u7D20\u4E4B\u529B\u3002\u5728\u6C34\u4E0B\u73AF\u5883\u4E2D\uFF0C\u4ED6\u4EEC\u662F\u5F3A\u5927\u800C\u654F\u6377\u7684\u6218\u58EB\u3002"
  - Name: race_detail_3
    Text: "\u4ED6\u4EEC\u5C45\u4F4F\u5728\u4E00\u4E2A\u70ED\u5E26\u661F\u7403\u4E0A\uFF0C\u90A3\u91CC\u7684\u4EBA\u4EEC\u5C06\u70ED\u548C\u706B\u89C6\u4E3A\u65E5\u5E38\u751F\u6D3B\u4E0D\u53EF\u6216\u7F3A\u7684\u4E00\u90E8\u5206\u3002\u4ED6\u4EEC\u80FD\u591F\u521B\u9020\u548C\u63A7\u5236\u706B\u7130\uFF0C\u5E76\u5C06\u5176\u7528\u4E8E\u9B54\u6CD5\u6216\u6B66\u5668\u3002\u4ED6\u4EEC\u795E\u5723\u7684\u6587\u5316\u5D07\u62DC\u4E0E\u706B\u548C\u70ED\u76F8\u5173\u7684\u795E\u7075\u3002"
  - Name: race_detail_4
    Text: "\u8FD9\u662F\u4E00\u4E2A\u62E5\u6709\u64CD\u63A7\u5B87\u5B99\u80FD\u91CF\u548C\u9B54\u6CD5\u80FD\u529B\u7684\u9AD8\u7B49\u79CD\u65CF\u3002\u4ED6\u4EEC\u5C45\u4F4F\u5728\u4E00\u9897\u62E5\u6709\u72EC\u7279\u5927\u6C14\u5C42\u7684\u661F\u7403\u4E0A\uFF0C\u8FD9\u79CD\u5927\u6C14\u5C42\u4F7F\u4ED6\u4EEC\u80FD\u591F\u5438\u6536\u6765\u81EA\u6052\u661F\u548C\u90BB\u8FD1\u884C\u661F\u7684\u80FD\u91CF\u548C\u9B54\u6CD5\u3002\u4ED6\u4EEC\u662F\u62E5\u6709\u65E0\u9650\u5B87\u5B99\u77E5\u8BC6\u7684\u5DEB\u5E08\u3002"
  - Name: race_detail_5
    Text: "\u8FD9\u662F\u4E00\u4E2A\u80FD\u591F\u968F\u610F\u53D8\u5F62\u5E76\u8C03\u6574\u8EAB\u4F53\u5F62\u6001\u7684\u79CD\u65CF\u3002\u4ED6\u4EEC\u5C45\u4F4F\u5728\u4E00\u4E2A\u9762\u4E34\u5404\u79CD\u5A01\u80C1\u7684\u661F\u7403\u4E0A\uFF0C\u8FD9\u79CD\u53D8\u5F62\u80FD\u529B\u5E2E\u52A9\u4ED6\u4EEC\u5728\u4E25\u9177\u7684\u73AF\u5883\u4E2D\u751F\u5B58\u548C\u9002\u5E94\u3002\u4ED6\u4EEC\u9002\u5E94\u6027\u5F3A\uFF0C\u80FD\u591F\u6839\u636E\u4E0D\u540C\u7684\u60C5\u51B5\u6539\u53D8\u5F62\u6001\u3002"
  - Name: dont_enough_item
    Text: "\u60A8\u6CA1\u6709\u8DB3\u591F\u7684 {0}\uFF01"
  - Name: dont_enough_item_title
    Text: "\u8D44\u6E90\u4E0D\u8DB3"
  - Name: warning_cap_slot_inventory_bag
    Text: "\u60A8\u7684\u7269\u54C1\u680F\u5DF2\u6EE1\uFF0C\u8BF7\u6269\u5145\u7269\u54C1\u680F\u4EE5\u7EE7\u7EED\u64CD\u4F5C\u3002"
