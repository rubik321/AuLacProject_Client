      \u653B\u51FB\u529B\uFF0C\u4F7F\u5176\u6C89\u9ED8\u6982\u7387\u4E3A 1%\uFF0C\u6301\u7EED
      2 \u56DE\u5408\u3002"
  - Name: skill_passive_name_8
    Text: "\u538B\u788E\u529B"
  - Name: skill_passive_detail_8
    Text: "\u653B\u51FB\u9020\u6210{0}%\u653B\u51FB\u529B\u635F\u5931\u5E76\u9020\u6210{1}%\u653B\u51FB\u529B\u6D41\u8840\uFF0C\u540C\u65F6\u964D\u4F4E{2}\u70B9\u6012\u6C14\u3002"
  - Name: skill_passive_name_9
    Text: "\u9632\u5B88\u59FF\u6001"
  - Name: skill_passive_detail_9
    Text: "\u88AB\u51FB\u4E2D\u65F6\uFF0C\u6709{0}%\u7684\u51E0\u7387\u4F7F\u653B\u51FB\u8005\u51BB\u7ED3{1}\u56DE\u5408\u3002"
  - Name: skill_passive_name_10
    Text: "\u6D3B\u529B\u6D8C\u52A8"
  - Name: skill_passive_detail_10
    Text: "\u5BF9\u524D\u5217\u654C\u4EBA\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\uFF0C\u5E76\u6062\u590D\u76F8\u5F53\u4E8E\u653B\u51FB\u529B{1}%\u7684\u751F\u547D\u503C\u3002"
  - Name: skill_passive_name_11
    Text: "\u9B54\u529B\u6D41"
  - Name: skill_passive_detail_11
    Text: "\u653B\u51FB{1}\u4E2A\u968F\u673A\u654C\u4EBA\uFF0C\u9020\u6210{0}%\u653B\u51FB\u529B\u7684\u4F24\u5BB3\u3002\u9644\u52A0\u707C\u70E7\u6548\u679C\uFF0C\u5728{3}\u56DE\u5408\u5185\u9020\u6210\u76F8\u5F53\u4E8E\u76EE\u6807\u6700\u5927\u751F\u547D\u503C{2}%\u7684\u771F\u5B9E\u4F24\u5BB3\u3002"
  - Name: skill_passive_name_12
    Text: "\u5965\u672F\u4EB2\u548C\u529B"
  - Name: skill_passive_detail_12
    Text: "\u653B\u51FB\u529B\u63D0\u5347{0}%\uFF0C\u751F\u547D\u503C\u63D0\u5347{1}%\u3002\u751F\u547D\u503C\u9996\u6B21\u4F4E\u4E8E{3}%\u65F6\uFF0C\u83B7\u5F97{4}%\u4F24\u5BB3\u51CF\u514D\uFF0C\u6301\u7EED{5}\u56DE\u5408\u3002"
