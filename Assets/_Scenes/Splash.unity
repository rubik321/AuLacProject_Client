    Text: "\u521A\u4ECE\u53E4\u8001\u7684\u9F99\u86CB\u4E2D\u5B75\u5316\u51FA\u6765\u7684\u5E7C\u9F99Wyrmote\uFF0C\u867D\u7136\u86CB\u58F3\u5C1A\u672A\u5B8C\u5168\u5C55\u5F00\uFF0C\u5374\u5DF2\u6D3B\u529B\u5341\u8DB3\uFF0C\u987D\u76AE\u65E0\u6BD4\u3002\u636E\u8BF4\u8FD9\u53EA\u56DE\u54CD\u8574\u85CF\u7740\u6C89\u7761\u7684\u5143\u7D20\u80FD\u91CF\uFF0C\u5E76\u627F\u8F7D\u7740\u5DF2\u706D\u7EDD\u7684\u9F99\u65CF\u8840\u8109\u7684\u4F20\u627F\u3002Wyrmote\u4F1A\u8FC5\u901F\u4E0E\u90A3\u4E9B\u5C55\u73B0\u51FA\u52C7\u6C14\u7684\u540E\u88D4\u5EFA\u7ACB\u8D77\u6DF1\u539A\u7684\u53CB\u8C0A\uFF0C\u5E76\u4E14\u8FD8\u6709\u4E00\u4E2A\u5947\u7279\u7684\u4E60\u60EF\uFF1A\u5B83\u4F1A\u6BEB\u4E0D\u72B9\u8C6B\u5730\u8E52\u8DDA\u8D70\u5411\u5371\u9669\u3002"
  - Name: monster1_des
    Text: "\u7279\u6E29\u7279\u62C9\u514B\u65AF\u662F\u7981\u5FCC\u70BC\u91D1\u672F\u4E0E\u5931\u843D\u79D1\u6280\u4EA4\u7EC7\u7684\u626D\u66F2\u4EA7\u7269\uFF0C\u5B83\u662F\u9F99\u9B42\u7684\u8FDB\u5316\u5F62\u6001\u2014\u2014\u65E9\u5DF2\u5931\u53BB\u4E86\u7EAF\u771F\u3002\u5982\u4ECA\uFF0C\u5B83\u5316\u8EAB\u4E3A\u53CC\u5934\u6050\u6016\u751F\u7269\uFF0C\u534A\u9AA8\u534A\u673A\u68B0\uFF0C\u884C\u52A8\u8BE1\u5F02\u7CBE\u51C6\uFF0C\u6E34\u671B\u638C\u63A7\u4E00\u5207\u3002\u6BCF\u4E2A\u5934\u9885\u90FD\u62E5\u6709\u72EC\u7ACB\u7684\u610F\u8BC6\uFF1A\u4E00\u4E2A\u53D7\u672C\u80FD\u9A71\u4F7F\uFF0C\u53E6\u4E00\u4E2A\u5219\u51B7\u9177\u7B97\u8BA1\u3002\u5C3D\u7BA1\u6218\u6597\u4E2D\u4EE4\u4EBA\u80C6\u5BD2\uFF0C\u4F46\u5728\u5076\u5C14\u7684\u72B9\u8C6B\u65F6\u523B\uFF0C\u5B83\u6614\u65E5\u7684\u5F71\u5B50\u4ECD\u4F1A\u95EA\u73B0\u2026\u2026\u4EFF\u4F5B\u4F53\u5185\u7684\u5E7C\u9F99\u4F9D\u7136\u8BB0\u5F97\u4E00\u5207\u3002"
  - Name: monster2_des
    Text: "\u4E09\u5934\u5DE8\u517D\u9AD8\u8038\u5165\u4E91\uFF0C\u5B9B\u5982\u4E00\u5177\u7531\u9AA8\u9ABC\u3001\u8840\u8089\u548C\u65E0\u60C5\u94A2\u94C1\u953B\u9020\u800C\u6210\u7684\u4E09\u5934\u602A\u7269\u3002\u6BCF\u4E2A\u5934\u9885\u90FD\u8BC9\u8BF4\u7740\u4E0D\u540C\u7684\u771F\u7406\uFF1A\u6124\u6012\u3001\u667A\u6167\u548C\u610F\u5FD7\u2014\u2014\u5B83\u4EEC\u6C38\u4E0D\u76F8\u5BB9\uFF0C\u5374\u53C8\u5728\u6BC1\u706D\u4E2D\u6C38\u8FDC\u56E2\u7ED3\u4E00\u81F4\u3002\u5B83\u66FE\u662F\u8106\u5F31\u7684\u5E7C\u5D3D\uFF0C\u5982\u4ECA\u5374\u5DF2\u5316\u8EAB\u4E3A\u4E00\u53F0\u6D3B\u751F\u751F\u7684\u6218\u4E89\u673A\u5668\uFF0C\u7531\u8150\u5316\u7684\u5143\u7D20\u6838\u5FC3\u548C\u65E9\u5DF2\u5931\u4F20\u7684\u53E4\u8001\u79D1\u6280\u9A71\u52A8\u3002\u4F20\u8BF4\u53EA\u6709\u610F\u5FD7\u575A\u5B9A\u7684\u5723\u88D4\u624D\u80FD\u9A7E\u9A6D\u5B83\u7684\u72C2\u6012\u2026\u2026\u6216\u8005\u8BF4\uFF0C\u624D\u80FD\u5728\u5B83\u7684\u80CC\u53DB\u4E0B\u5E78\u5B58\u3002"
  - Name: monster3_des
    Text: "\u5E03\u9C81\u897F\u514B\u539F\u672C\u53EA\u662F\u4E00\u53EA\u666E\u901A\u7684\u6797\u5730\u5E7C\u5D3D\uFF0C\u5374\u88AB\u4E00\u7FA4\u6B63\u5728\u8FDB\u884C\u5143\u7D20\u8840\u6E05\u5B9E\u9A8C\u7684\u90AA\u6076\u70BC\u91D1\u672F\u58EB\u6293\u8D70\u3002\u6CE8\u5C04\u540E\uFF0C\u5B83\u8840\u7BA1\u4E2D\u6D8C\u52A8\u7740\u5947\u5F02\u7684\u7EFF\u8272\u5149\u8292\uFF0C\u91CA\u653E\u51FA\u8FDC\u8D85\u5176\u5A07\u5C0F\u8EAB\u8EAF\u7684\u51F6\u731B\u529B\u91CF\u3002\u5C3D\u7BA1\u5B83\u4ECD\u7136\u4FDD\u7559\u7740\u5E7C\u5D3D\u7684\u597D\u5947\u672C\u80FD\uFF0C\u4F46\u5E03\u9C81\u897F\u514B\u5982\u4ECA\u4F1A\u7206\u53D1\u51FA\u5F02\u4E4E\u5BFB\u5E38\u7684\u529B\u91CF\u2014\u2014\u5B83\u5F98\u5F8A\u5728\u91CE\u517D\u672C\u6027\u548C\u672A\u6765\u53EF\u80FD\u6210\u4E3A\u7684\u602A\u7269\u4E4B\u95F4\u3002"
  - Name: monster4_des
    Text: "\u968F\u7740\u5E03\u9C81\u897F\u514B\u8FDB\u5316\u6210\u5E03\u62C9\u8FEA\u4E9A\u7279\uFF0C\u53D8\u5F02\u4E5F\u6108\u53D1\u4E25\u91CD\u2014\u2014\u5B83\u662F\u7531\u539F\u59CB\u808C\u8089\u3001\u88F8\u9732\u9AA8\u9ABC\u548C\u5267\u6BD2\u6012\u706B\u878D\u5408\u800C\u6210\u7684\u6050\u6016\u602A\u7269\u3002\u5728\u4E24\u7F50\u4E0D\u7A33\u5B9A\u8840\u6E05\u7684\u9A71\u52A8\u4E0B\uFF0C\u5E03\u62C9\u8FEA\u4E9A\u7279\u7684\u8EAB\u4F53\u5982\u4ECA\u4F1A\u6E17\u51FA\u7EFF\u8272\u80FD\u91CF\uFF0C\u6BCF\u8D70\u4E00\u6B65\u90FD\u4F1A\u707C\u70E7\u5730\u9762\u3002\u5B83\u7684\u5486\u54EE\u58F0\u4F1A\u5F15\u53D1\u6050\u614C\uFF0C\u5B83\u7684\u653B\u51FB\u4F1A\u7559\u4E0B\u8150\u8680\u6027\u7684\u75D5\u8FF9\u3002\u5E7C\u5D3D\u66FE\u7ECF\u62E5\u6709\u7684\u7EAF\u771F\u65E9\u5DF2\u88AB\u5C42\u5C42\u75DB\u82E6\u63A9\u57CB\uFF0C\u53EA\u5269\u4E0B\u4E00\u4E2A\u7531\u70BC\u91D1\u672F\u548C\u75DB\u82E6\u5851\u9020\u7684\u51B7\u9177\u65E0\u60C5\u7684\u63A0\u98DF\u8005\u3002"
  - Name: monster5_des
    Text: "\u5E03\u9C81\u6258\u514B\u8428\u662F\u8086\u65E0\u5FCC\u60EE\u7684\u5B9E\u9A8C\u7684\u6700\u7EC8\u4EA7\u7269\uFF0C\u5B83\u662F\u4E00\u5934\u7531\u91D1\u5C5E\u3001\u6BD2\u7D20\u548C\u72C2\u6012\u6784\u6210\u7684\u5E9E\u7136\u5DE8\u517D\u3002\u5B83\u575A\u786C\u7684\u5934\u9AA8\u4E0A\u957F\u7740\u4E00\u6839\u52A0\u56FA\u7684\u89D2\uFF0C\u952F\u9F7F\u72B6\u7684\u94A2\u7259\u6495\u88C2\u4E00\u5207\u963B\u6321\u4E4B\u7269\u3002\u80CC\u4E0A\u7684\u7F50\u5B50\u6E90\u6E90\u4E0D\u65AD\u5730\u5411\u5B83\u7684\u8840\u6DB2\u4E2D\u6CE8\u5165\u4E0D\u7A33\u5B9A\u7684\u8840\u6E05\uFF0C\u4F7F\u5B83\u59CB\u7EC8\u5904\u4E8E\u72C2\u66B4\u53D8\u5F02\u7684\u72B6\u6001\u3002\u5E03\u9C81\u6258\u514B\u8428\u4E0D\u518D\u611F\u5230\u6050\u60E7\u6216\u75BC\u75DB\u3002\u5B83\u5B58\u5728\u7684\u552F\u4E00\u76EE\u7684\u5C31\u662F\u6A2A\u51B2\u76F4\u649E\uFF0C\u5B83\u662F\u4E00\u4EF6\u6D3B\u751F\u751F\u7684\u6B66\u5668\uFF0C\u5176\u72C2\u6012\u51E0\u4E4E\u65E0\u6CD5\u6291\u5236\u3002"
  - Name: monster6_des
    Text: "\u522B\u88AB\u5B83\u7684\u540D\u5B57\u8BEF\u5BFC\u4E86\u2014\u2014\u6BDB\u8338\u8338\u7684\u6BDB\u8338\u8338\u53EF\u4E0D\u662F\u597D\u60F9\u7684\u3002\u8FD9\u5934\u5F3A\u58EE\u7684\u89D2\u517D\u6218\u58EB\u51FA\u751F\u4E8E\u98CE\u66B4\u4FB5\u8680\u7684\u9AD8\u5730\uFF0C\u4ECE\u5C0F\u5C31\u63A5\u53D7\u6B8B\u9177\u7684\u529B\u91CF\u548C\u8010\u529B\u8BAD\u7EC3\u3002\u5B83\u62F3\u5934\u5982\u5DE8\u77F3\u822C\u575A\u786C\uFF0C\u5FC3\u810F\u5374\u65E0\u6BD4\u5F3A\u5927\uFF0C\u603B\u662F\u52C7\u5F80\u76F4\u524D\uFF0C\u8FCE\u96BE\u800C\u4E0A\uFF0C\u6E34\u671B\u8BC1\u660E\u5373\u4F7F\u662F\u6700\u5F31\u5C0F\u7684\u6218\u58EB\u4E5F\u80FD\u64BC\u52A8\u5927\u5730\u3002\u5FE0\u8BDA\u3001\u56FA\u6267\uFF0C\u800C\u4E14\u51FA\u4EBA\u610F\u6599\u5730\u5BCC\u6709\u6218\u672F\u5934\u8111\uFF0C\u6BDB\u8338\u8338\u662F\u4EFB\u4F55\u4E00\u4F4D\u8D62\u5F97\u5B83\u5C0A\u91CD\u7684\u540E\u88D4\u6700\u5FE0\u5B9E\u7684\u4F19\u4F34\u3002"
  - Name: monster7_des
    Text: "\u5386\u7ECF\u6218\u706B\u6DEC\u70BC\uFF0C\u70C8\u7130\u6DEC\u70BC\uFF0C\u706B\u7130\u517DBlazuff\u662FFluffalo\u4E0D\u5C48\u610F\u5FD7\u7684\u8FDB\u5316\u5316\u8EAB\u3002\u5B83\u8EAB\u8EAF\u808C\u8089\u866C\u7ED3\uFF0C\u94E0\u7532\u4E0A\u954C\u523B\u7740\u8C61\u5F81\u80DC\u5229\u7684\u90E8\u843D\u56FE\u817E\uFF0C\u5C3E\u5C16\u71C3\u8D77\u706B\u7130\uFF0C\u968F\u7740\u6012\u706B\u7684\u5347\u817E\u6108\u53D1\u70BD\u70C8\u3002Blazuff\u4E0D\u518D\u4EC5\u4EC5\u662F\u4E00\u4E2A\u987D\u5F3A\u7684\u6597\u58EB\uFF0C\u5B83\u4EE5\u8363\u8A89\u4E3A\u5148\uFF0C\u4EE5\u96EA\u5D29\u822C\u7684\u529B\u91CF\u548C\u8001\u7EC3\u6218\u58EB\u822C\u7684\u7CBE\u51C6\u53D1\u8D77\u653B\u51FB\u3002\u5B83\u6218\u6597\uFF0C\u5E76\u975E\u4EC5\u4EC5\u4E3A\u4E86\u80DC\u5229\uFF0C\u66F4\u662F\u4E3A\u4E86\u4F20\u627F\u3002"
  - Name: monster8_des
    Text: "\u8EAB\u62AB\u6218\u706B\u953B\u9020\u7684\u94E0\u7532\uFF0C\u5B9B\u5982\u4E00\u56E2\u6D3B\u751F\u751F\u7684\u70C8\u7130\uFF0C\u76AE\u7F57\u7EB3\u514B\u65AF\u662F\u6BDB\u7ED2\u7ED2\u706B\u7130\u8840\u8109\u7684\u5DC5\u5CF0\u3002\u4ED6\u7684\u9B03\u6BDB\u5982\u540C\u91CE\u706B\u822C\u718A\u718A\u71C3\u70E7\uFF0C\u6BCF\u4E00\u6B65\u90FD\u7559\u4E0B\u7F15\u7F15\u4F59\u70EC\u3002\u5728\u6124\u6012\u4E0E\u51B3\u5FC3\u7684\u9A71\u4F7F\u4E0B\uFF0C\u76AE\u7F57\u7EB3\u514B\u65AF\u62E5\u6709\u8DB3\u4EE5\u6467\u6BC1\u6700\u5F3A\u654C\u4EBA\u7684\u7194\u5CA9\u4E4B\u529B\u3002\u4ED6\u7684\u5B58\u5728\u672C\u8EAB\u5C31\u80FD\u70B9\u71C3\u6218\u573A\u2014\u2014\u70B9\u71C3\u706B\u7130\uFF0C\u4E5F\u70B9\u71C3\u52C7\u6C14\u3002\u4E0E\u4ED6\u5E76\u80A9\u4F5C\u6218\uFF0C\u5C31\u5982\u540C\u4E0E\u706B\u5C71\u7684\u6012\u706B\u540C\u5728\u3002"
  - Name: monster9_des
    Text: "\u5728\u5E72\u71E5\u9F9F\u88C2\u7684\u5730\u8868\u4E0B\uFF0C\u514B\u96F7\u683C\u8FC8\u7279\u6084\u7136\u7A7F\u884C\u3002\u8FD9\u79CD\u4F53\u578B\u867D\u5C0F\u5374\u8EAB\u62AB\u91CD\u7532\u7684\u56DE\u58F0\u602A\u4EE5\u4F0F\u51FB\u8457\u79F0\u3002\u5B83\u952F\u9F7F\u72B6\u7684\u7532\u58F3\u4E0E\u5CA9\u77F3\u5730\u5F62\u5B8C\u7F8E\u878D\u5408\uFF0C\u800C\u5B83\u90A3\u950B\u5229\u7684\u53CC\u817F\u5219\u80FD\u8F7B\u6613\u5730\u94BB\u7A7F\u5CA9\u77F3\u3002\u5C3D\u7BA1\u4F53\u578B\u5A07\u5C0F\uFF0C\u5B83\u5374\u4EE4\u77FF\u5DE5\u548C\u62FE\u8352\u8005\u90FD\u95FB\u98CE\u4E27\u80C6\u2014\u2014\u5B83\u7684\u6495\u54AC\u80FD\u5728\u77AC\u95F4\u7834\u574F\u5730\u58F3\u7ED3\u6784\u3002\u52A1\u5FC5\u5C0F\u5FC3\uFF0C\u56E0\u4E3A\u5927\u5730\u98A4\u6296\u4E4B\u5904\uFF0C\u6216\u8BB8\u5C31\u6F5C\u4F0F\u7740\u4E00\u53EA\u514B\u96F7\u683C\u8FC8\u7279\u3002"
  - Name: monster10_des
    Text: "\u8428\u8BFA\u514B\u662F\u514B\u62C9\u683C\u8FC8\u7279\u7684\u53EF\u6015\u8FDB\u5316\u4F53\u2014\u2014\u5B83\u4E0D\u518D\u662F\u6F5C\u4F0F\u7684\u722C\u884C\u8005\uFF0C\u800C\u662F\u4E00\u5EA7\u7531\u77F3\u5934\u548C\u9AA8\u9ABC\u6784\u6210\u7684\u79FB\u52A8\u5821\u5792\u3002\u5B83\u516D\u6761\u950B\u5229\u7684\u817F\u5728\u51B2\u950B\u65F6\u7C89\u788E\u5730\u5F62\uFF0C\u5DE8\u5927\u7684\u5634\u91CC\u5E03\u6EE1\u952F\u9F7F\u72B6\u7684\u7259\u9F7F\uFF0C\u968F\u65F6\u51C6\u5907\u6495\u788E\u94A2\u94C1\u3002\u5B83\u575A\u786C\u5982\u5CA9\u77F3\u7684\u7532\u58F3\u4E0A\u957F\u6EE1\u4E86\u5C16\u523A\uFF0C\u5982\u540C\u5927\u81EA\u7136\u4EB2\u624B\u96D5\u523B\u7684\u8B66\u793A\u6807\u5FD7\u3002\u8428\u8BFA\u514B\u66FE\u7ECF\u662F\u9690\u85CF\u7684\u5A01\u80C1\uFF0C\u5982\u4ECA\u5374\u6210\u4E3A\u4E86\u6218\u573A\u4E0A\u65E0\u60C5\u7684\u63A0\u98DF\u8005\uFF0C\u5C31\u8FDE\u8EAB\u7ECF\u767E\u6218\u7684\u5148\u9A71\u8005\u4E5F\u5BF9\u5176\u5FC3\u751F\u754F\u60E7\u3002"
  - Name: monster11_des
    Text: "\u4F20\u95FB\u8D1D\u5FB7\u62C9\u5E93\u5C14\u662F\u81EA\u7B2C\u4E00\u6B21\u5D29\u584C\u4EE5\u6765\u4FBF\u88AB\u57CB\u846C\u7684\u8FDC\u53E4\u6050\u6016\uFF0C\u662F\u76D6\u4E9A\u4E4B\u6012\u7684\u5316\u8EAB\uFF0C\u7ECF\u5C81\u6708\u77F3\u4E0B\u78E8\u783A\u800C\u6210\u3002\u5B83\u9AD8\u8038\u5165\u4E91\uFF0C\u51B7\u9177\u65E0\u60C5\uFF0C\u5982\u4ECA\u5DF2\u7136\u82CF\u9192\uFF0C\u62E5\u6709\u516B\u6761\u952F\u9F7F\u72B6\u7684\u80A2\u4F53\u548C\u4E24\u628A\u5DE8\u5927\u7684\u9AA8\u9570\uFF0C\u6495\u88C2\u5927\u5730\u4E0E\u8840\u8089\u3002\u5B83\u575A\u786C\u7684\u7532\u58F3\u4E2D\u6D8C\u52A8\u7740\u6C89\u7761\u7684\u5143\u7D20\u80FD\u91CF\uFF0C\u7EFF\u8272\u7684\u88C2\u9699\u4E2D\u95EA\u70C1\u7740\u5FAE\u5149\uFF0C\u5B83\u7684\u51FA\u73B0\u672C\u8EAB\u5C31\u80FD\u64BC\u52A8\u5927\u5730\u3002\u8D1D\u5FB7\u62C9\u5E93\u5C14\u5E76\u4E0D\u730E\u6740\u2014\u2014\u5B83\u51C0\u5316\u4E00\u5207\uFF0C\u6240\u5230\u4E4B\u5904\u53EA\u7559\u4E0B\u5C18\u57C3\u4E0E\u5BC2\u9759\u3002\u76F4\u9762\u5B83\uFF0C\u4FBF\u662F\u6311\u6218\u5927\u5730\u672C\u8EAB\u7684\u610F\u5FD7\u3002"
  - Name: monster12_des
    Text: "\u6765\u81EA\u65E9\u5DF2\u88AB\u6D2A\u6C34\u6DF9\u6CA1\u7684\u6587\u660E\u6D77\u5CB8\u5E9F\u589F\u7684\u79CD\u65CF\u2014\u2014\u88C2\u722A\uFF0C\u662F\u4E00\u79CD\u51F6\u731B\u800C\u654F\u6377\u7684\u63A0\u98DF\u8005\uFF0C\u5B83\u51FA\u6CA1\u4E8E\u6F6E\u6EE9\u548C\u6C89\u8239\u6B8B\u9AB8\u4E4B\u95F4\u3002\u5B83\u6325\u821E\u7740\u4ECE\u6C89\u8239\u4E2D\u626F\u4E0B\u7684\u9508\u8FF9\u6591\u6591\u7684\u9C7C\u94A9\uFF0C\u51ED\u501F\u7740\u539F\u59CB\u7684\u672C\u80FD\u548C\u7CBE\u51C6\u7684\u653B\u51FB\u8FDB\u884C\u6218\u6597\u3002\u5B83\u51B0\u84DD\u8272\u7684\u76AE\u6BDB\u5728\u51DD\u7ED3\u7684\u6C34\u6C7D\u4E2D\u53D1\u51FA\u567C\u556A\u58F0\uFF0C\u5B83\u7684\u5486\u54EE\u5982\u540C\u5DE8\u6D6A\u822C\u56DE\u8361\u3002\u867D\u7136\u8FD8\u5F88\u5E74\u8F7B\uFF0C\u88C2\u722A\u5374\u6BEB\u4E0D\u7559\u60C5\u2014\u2014\u6BCF\u4E00\u6B21\u6C34\u4E0B\u6218\u6597\u7684\u80DC\u5229\u90FD\u4F1A\u8BA9\u5B83\u7684\u6012\u706B\u66F4\u52A0\u9AD8\u6DA8\u3002"
  - Name: monster13_des
    Text: "\u5E03\u83B1\u56E0\u65B9\u4E0D\u518D\u53EA\u662F\u5E9F\u589F\u4E2D\u7684\u62FE\u8352\u8005\uFF0C\u4ED6\u5DF2\u5316\u8EAB\u4E3A\u6D2A\u6CDB\u4E4B\u5730\u7684\u6218\u4E89\u4F7F\u8005\u3002\u4ED6\u90A3\u7C97\u7CD9\u7684\u94A9\u5B50\u5DF2\u88AB\u91CD\u953B\u6210\u4E00\u628A\u7531\u6C89\u8239\u6B8B\u9AB8\u953B\u9020\u800C\u6210\u7684\u952F\u9F7F\u5229\u5203\uFF0C\u8574\u542B\u6C34\u6D41\u80FD\u91CF\u7684\u5F27\u5149\u5728\u4ED6\u94E0\u7532\u4E4B\u4E0A\u567C\u556A\u4F5C\u54CD\u3002\u5E03\u83B1\u56E0\u65B9\u88AB\u6DF1\u6D77\u6F6E\u77F3\u7684\u529B\u91CF\u6240\u6D78\u6DA6\uFF0C\u884C\u52A8\u65E2\u91CE\u6027\u7CBE\u51C6\u53C8\u5145\u6EE1\u6B8B\u9177\u7684\u610F\u56FE\u3002\u4ED6\u7684\u5486\u54EE\u5982\u540C\u5DE8\u6D6A\u7FFB\u6EDA\uFF0C\u5F53\u5486\u54EE\u58F0\u54CD\u8D77\u65F6\uFF0C\u5C31\u8FDE\u6F6E\u6C34\u672C\u8EAB\u4F3C\u4E4E\u4E5F\u4F1A\u9000\u5374\u3002"
  - Name: monster14_des
    Text: "\u4ECE\u88AB\u9057\u5FD8\u6D77\u5CB8\u7834\u788E\u7684\u6F6E\u6C50\u4E2D\uFF0C\u7EB3\u745F\u62C9\u514B\u5D1B\u8D77\uFF0C\u4ED6\u662F\u88C2\u989A\u8FDB\u5316\u7684\u5DC5\u5CF0\u5F62\u6001\uFF0C\u4E5F\u662F\u98CE\u66B4\u8086\u8650\u6DF1\u6D77\u7684\u519B\u9600\u3002\u4ED6\u8EAB\u62AB\u6DF1\u6E0A\u953B\u9020\u7684\u94E0\u7532\uFF0C\u6325\u821E\u7740\u8574\u542B\u7740\u6D77\u6D0B\u6012\u706B\u7684\u6B8B\u9177\u6F6E\u6C50\u94A9\uFF0C\u7EB3\u745F\u62C9\u514B\u5468\u8EAB\u6D8C\u52A8\u7740\u567C\u556A\u4F5C\u54CD\u7684\u80FD\u91CF\u2014\u2014\u4ED6\u7684\u8EAB\u4F53\u4E0D\u65AD\u88AB\u6C79\u6D8C\u7684\u6697\u6D41\u6240\u73AF\u7ED5\u3002\u6BCF\u4E00\u6B21\u653B\u51FB\u90FD\u4F1A\u5728\u6218\u573A\u4E0A\u5F15\u53D1\u9707\u98A4\uFF0C\u4ED6\u81EA\u8EAB\u7684\u5B58\u5728\u4FBF\u80FD\u626D\u66F2\u7A7A\u6C14\uFF0C\u5E26\u6765\u538B\u529B\u548C\u9759\u7535\u3002\u7EB3\u745F\u62C9\u514B\u4E0D\u518D\u4EC5\u4EC5\u662F\u4E00\u5934\u51ED\u672C\u80FD\u884C\u4E8B\u7684\u91CE\u517D\uFF0C\u4ED6\u5DF2\u6210\u4E3A\u4E00\u4E2A\u6D3B\u7740\u7684\u4F20\u5947\u2014\u2014\u6C34\u624B\u4EEC\u5728\u7948\u7977\u4E2D\u4F4E\u8BED\u7740\u4ED6\u7684\u540D\u5B57\uFF0C\u5723\u88D4\u7684\u6218\u6B4C\u4E2D\u4E5F\u5145\u6EE1\u4E86\u5BF9\u4ED6\u7684\u6050\u60E7\u3002"
  - Name: monster15_des
    Text: "\u74E6\u8BFA\u514B\u662F\u4E1B\u6797\u4E2D\u4E00\u5934\u9886\u5730\u9738\u4E3B\u2014\u2014\u534A\u662F\u91CE\u517D\uFF0C\u534A\u662F\u4EE4\u4EBA\u80C6\u5BD2\u7684\u731B\u517D\u3002\u5B83\u7C97\u58EE\u7684\u56DB\u80A2\u624E\u6839\u4E8E\u53E4\u8001\u7684\u690D\u88AB\u4E4B\u4E2D\uFF0C\u8986\u76D6\u7740\u6811\u76AE\u822C\u7684\u7532\u58F3\uFF0C\u5728\u5E7D\u6697\u7684\u6811\u51A0\u4E2D\u5386\u7ECF\u6570\u767E\u5E74\u987D\u5F3A\u751F\u5B58\uFF0C\u53D8\u5F97\u575A\u786C\u65E0\u6BD4\u3002\u5B83\u66FE\u662F\u90E8\u843D\u4F20\u8BF4\u4E2D\u4F4E\u8BED\u7684\u5BF9\u8C61\uFF0C\u5982\u4ECA\u5374\u4EE5\u60CA\u4EBA\u7684\u901F\u5EA6\u53D1\u8D77\u653B\u51FB\uFF0C\u53CC\u7FFC\u5F20\u5F00\uFF0C\u53CC\u76EE\u71C3\u70E7\u7740\u539F\u59CB\u7684\u672C\u80FD\u3002\u5B83\u950B\u5229\u7684\u722A\u5B50\u6495\u88C2\u704C\u6728\u4E1B\u548C\u76D4\u7532\uFF0C\u6E05\u9664\u6240\u6709\u80C6\u6562\u95EF\u5165\u5176\u9886\u5730\u7684\u751F\u7269\u3002\u74E6\u8BFA\u514B\u5E76\u975E\u4E3A\u4E86\u89C5\u98DF\u800C\u72E9\u730E\u2014\u2014\u5B83\u662F\u4E3A\u4E86\u7EDF\u6CBB\u800C\u72E9\u730E\u3002"
  - Name: monster16_des
    Text: "\u74E6\u8BFA\u5361\u4E0D\u518D\u4EC5\u4EC5\u662F\u4E1B\u6797\u4E2D\u7684\u63A0\u98DF\u8005\u2014\u2014\u5B83\u5DF2\u6210\u4E3A\u4E00\u80A1\u81F3\u9AD8\u65E0\u4E0A\u7684\u81EA\u7136\u529B\u91CF\u3002\u5B83\u8EAB\u62AB\u6811\u76AE\u953B\u9020\u7684\u94E0\u7532\uFF0C\u8EAB\u4E0A\u523B\u6709\u656C\u754F\u6216\u6050\u60E7\u5B83\u7684\u4EBA\u4EEC\u7559\u4E0B\u7684\u4EEA\u5F0F\u6027\u5370\u8BB0\uFF0C\u4EE5\u4E00\u79CD\u7CBE\u5FC3\u7B56\u5212\u7684\u51F6\u731B\u7EDF\u6CBB\u7740\u81EA\u5DF1\u7684\u9886\u5730\u3002\u5982\u4ECA\uFF0C\u5B83\u7684\u7FC5\u8180\u66F4\u591A\u5730\u7528\u4E8E\u5A01\u6151\u800C\u975E\u98DE\u884C\uFF0C\u5B83\u950B\u5229\u7684\u722A\u5B50\u5982\u540C\u9570\u5200\u822C\u65A9\u65AD\u77F3\u5934\u548C\u94A2\u94C1\u3002\u5B83\u7684\u4E00\u4E3E\u4E00\u52A8\u90FD\u627F\u8F7D\u7740\u8FD9\u5934\u4E16\u4EE3\u5728\u8352\u91CE\u4E2D\u751F\u5B58\u5E76\u79F0\u9738\u7684\u751F\u7269\u7684\u91CD\u91CF\u3002\u5728\u4E1B\u6797\u6DF1\u5904\uFF0C\u74E6\u8BFA\u5361\u5C31\u662F\u6CD5\u5219\u3002"
  - Name: monster17_des
    Text: "\u74E6\u8BFA\u5361\u5C3C\u514B\u65AF\u4E0D\u518D\u662F\u91CE\u517D\uFF0C\u800C\u662F\u76D6\u4E9A\u72C2\u91CE\u4E4B\u5FC3\u7684\u4F20\u5947\u2014\u2014\u5B83\u8EAB\u62AB\u9540\u91D1\u6811\u76AE\u77F3\u94E0\u7532\uFF0C\u5934\u6234\u88AB\u9057\u5FD8\u65F6\u4EE3\u7684\u9057\u7269\u3002\u5B83\u7684\u4E00\u4E3E\u4E00\u52A8\u90FD\u95EA\u8000\u7740\u4EEA\u5F0F\u822C\u7684\u5A01\u80FD\uFF0C\u5229\u722A\u5316\u4F5C\u7F20\u7ED5\u7740\u4EEA\u5F0F\u94A2\u7684\u5DE8\u9570\u3002\u74E6\u8BFA\u5361\u5C3C\u514B\u65AF\u8EAB\u62AB\u795E\u5723\u7684\u94E0\u7532\uFF0C\u5468\u8EAB\u6D8C\u52A8\u7740\u5143\u7D20\u4E4B\u529B\uFF0C\u5B83\u4E0D\u518D\u662F\u4E1B\u6797\u7684\u6E38\u8361\u8005\u2014\u2014\u5B83\u662F\u4E1B\u6797\u7684\u7EDF\u6CBB\u8005\u3002\u9C9C\u6709\u4EBA\u6562\u8E0F\u5165\u5B83\u7684\u9886\u5730\uFF0C\u800C\u65E0\u4EBA\u80FD\u591F\u6BEB\u53D1\u65E0\u635F\u5730\u79BB\u5F00\u3002\u5F53\u74E6\u8BFA\u5361\u5C3C\u514B\u65AF\u5D1B\u8D77\u4E4B\u65F6\uFF0C\u5C31\u8FDE\u4E1B\u6797\u4E5F\u5C4F\u4F4F\u4E86\u547C\u5438\u3002"
  - Name: monster18_des
    Text: "\u5E03\u4F26\u6CF0\u5FB7\u662F\u4E00\u4F4D\u9971\u7ECF\u6F6E\u6C50\u4E0E\u78E8\u96BE\u6DEC\u70BC\u7684\u6D77\u5CB8\u6267\u6CD5\u8005\u3002\u4ED6\u62E5\u6709\u539A\u5B9E\u7684\u9CDE\u7532\u76AE\u80A4\u548C\u8DB3\u4EE5\u62B5\u5FA1\u5DE8\u6D6A\u62CD\u51FB\u7684\u529B\u91CF\uFF0C\u5E38\u88AB\u5B88\u62A4\u5728\u53E4\u8001\u7684\u822A\u9053\u548C\u6C89\u6CA1\u7684\u9057\u8FF9\u4E4B\u4E2D\u3002\u4ED6\u90A3\u7531\u9AA8\u5934\u548C\u7901\u77F3\u6253\u9020\u7684\u6218\u65A7\uFF0C\u80FD\u53D1\u51FA\u7F13\u6162\u5374\u5A01\u529B\u5DE8\u5927\u7684\u91CD\u51FB\uFF0C\u5728\u654C\u4EBA\u548C\u4ED6\u4EEC\u8E0F\u8DB3\u7684\u571F\u5730\u4E0A\u90FD\u7559\u4E0B\u6DF1\u6DF1\u7684\u5370\u8BB0\u3002\u5E03\u4F26\u6CF0\u5FB7\u867D\u7136\u4E0D\u6613\u52A8\u6012\uFF0C\u4F46\u4E00\u65E6\u51FA\u624B\uFF0C\u4FBF\u4F1A\u611F\u53D7\u5230\u6D77\u6D0B\u7684\u78C5\u7934\u529B\u91CF\u3002"
  - Name: monster19_des
    Text: "\u5E03\u9C81\u56FE\u65AF\u514B\u5386\u7ECF\u65E0\u6570\u6B21\u6CBF\u6D77\u51B2\u7A81\uFF0C\u5DF2\u7136\u6210\u4E3A\u7ECF\u9A8C\u4E30\u5BCC\u7684\u6D77\u6D0B\u63A0\u98DF\u8005\u3002\u4ED6\u539F\u672C\u7B80\u5355\u7684\u7532\u58F3\u5982\u4ECA\u5DF2\u786C\u5316\u6210\u8FD1\u4E4E\u575A\u4E0D\u53EF\u6467\u7684\u5821\u5792\uFF0C\u800C\u4ED6\u539A\u5B9E\u7684\u76AE\u6BDB\u4EA6\u53EF\u5316\u4F5C\u5229\u5203\u4E0E\u7BAD\u77E2\u3002\u4ED6\u4EE5\u4EA1\u654C\u7684\u9AB8\u9AA8\u4E3A\u9970\uFF0C\u6325\u821E\u7740\u4E00\u628A\u6B8B\u66B4\u7684\u94A9\u65A7\uFF0C\u5E03\u9C81\u56FE\u65AF\u514B\u6218\u6597\u5E76\u975E\u53EA\u4E3A\u80DC\u5229\u2014\u2014\u800C\u662F\u4E3A\u4E86\u786E\u4FDD\u65E0\u4EBA\u6562\u518D\u8FD4\u56DE\u3002\u4ED6\u6BCF\u4E00\u6B65\u90FD\u5982\u540C\u96F7\u9E23\u822C\u54CD\u5F7B\u5CA9\u77F3\uFF0C\u5C31\u8FDE\u8EAB\u62AB\u91CD\u7532\u7684\u5148\u9A71\u8005\u4EEC\u5728\u4ED6\u9762\u524D\u4E5F\u5FC3\u751F\u754F\u60E7\u3002\u6D77\u6D0B\u4E0D\u518D\u4EC5\u4EC5\u662F\u4ED6\u7684\u5BB6\u56ED\u2014\u2014\u800C\u662F\u4ED6\u7684\u9886\u5730\u3002"
  - Name: monster20_des
    Text: "\u5E03\u9C81\u5854\u739B\u5E76\u975E\u4EC5\u4EC5\u662F\u4E00\u4E2A\u56DE\u54CD\u2014\u2014\u4ED6\u672C\u8EAB\u5C31\u662F\u4E00\u573A\u4E8B\u4EF6\u3002\u4ED6\u662F\u6D77\u6D0B\u4E2D\u7684\u6218\u4E89\u6CF0\u5766\uFF0C\u8EAB\u62AB\u9AA8\u94F8\u94E0\u7532\uFF0C\u5934\u6234\u7531\u4ED6\u78BE\u788E\u7684\u6BCF\u4E00\u4E2A\u6311\u6218\u8005\u7684\u6B8B\u9AB8\u7EC4\u6210\u7684\u738B\u51A0\u3002\u4ED6\u5E9E\u5927\u7684\u8EAB\u8EAF\u5982\u540C\u6DA8\u6F6E\u822C\u52BF\u4E0D\u53EF\u6321\uFF0C\u6BCF\u4E00\u6B65\u90FD\u9707\u52A8\u7740\u811A\u4E0B\u7684\u5927\u5730\u3002\u4ED6\u90A3\u6BD4\u6700\u575A\u56FA\u7684\u953B\u94A2\u8FD8\u8981\u575A\u786C\u7684\u5916\u58F3\uFF0C\u5200\u5251\u3001\u6CD5\u672F\u548C\u653B\u57CE\u5668\u68B0\u90FD\u5BF9\u4ED6\u6BEB\u4E0D\u5728\u610F\u3002\u4ED6\u62E5\u6709\u5982\u77F3\u67F1\u822C\u7C97\u58EE\u7684\u53CC\u817F\uFF0C\u624B\u4E2D\u7684\u6218\u65A7\u4E00\u51FB\u4FBF\u53EF\u7EC8\u7ED3\u6218\u6597\uFF0C\u5E03\u9C81\u5854\u739B\u7B80\u76F4\u5C31\u662F\u4E00\u53F0\u6D3B\u751F\u751F\u7684\u653B\u57CE\u5668\u68B0\u3002\u4ED6\u7684\u654C\u4EBA\u4E0D\u4F1A\u9003\u8DD1\u2014\u2014\u4ED6\u4EEC\u4F1A\u6E83\u4E0D\u6210\u519B\u3002\u6D77\u6D0B\u8FFD\u968F\u4ED6\uFF0C\u5E76\u975E\u4F5C\u4E3A\u76DF\u53CB\uFF0C\u800C\u662F\u4F5C\u4E3A\u4E00\u4EF6\u88AB\u91CA\u653E\u7684\u6B66\u5668\u3002"
  - Name: monster21_des
    Text: "\u8FD9\u53F0\u88C5\u7532\u56DE\u54CD\u673A\u7532\u8BDE\u751F\u4E8E\u4E00\u4E2A\u6447\u6447\u6B32\u5760\u7684\u5E1D\u56FD\u7684\u6700\u540E\u6323\u624E\uFF0C\u5728\u76D6\u4E9A\u6700\u6DF1\u5904\u7194\u7089\u7684\u7194\u5CA9\u4E4B\u4E0B\u79D8\u5BC6\u953B\u9020\u800C\u6210\u3002\u5B83\u53EA\u4EE5\u4EE3\u7801\u548C\u7528\u9014\u4E3A\u4EBA\u6240\u77E5\uFF0C\u88AB\u8BBE\u8BA1\u6210\u5B8C\u7F8E\u7684\u6B65\u5175\u2014\u2014\u575A\u97E7\u4E0D\u62D4\u3001\u4E0D\u77E5\u75B2\u5026\u3001\u51B7\u9177\u65E0\u60C5\u3002\u4F46\u5F53\u661F\u754C\u4E4B\u95E8\u5D29\u584C\uFF0C\u5E1D\u56FD\u5728\u5D29\u584C\u4E2D\u6D88\u4EA1\uFF0C\u63A7\u5236\u5B83\u7684\u9501\u200B\u200B\u94FE\u4E5F\u968F\u4E4B\u65AD\u88C2\u3002\u5982\u4ECA\uFF0C\u5B83\u6E38\u8361\u5728\u76D6\u4E9A\u7834\u788E\u7684\u5927\u5730\u4E0A\uFF0C\u6210\u4E3A\u4E00\u53F0\u88AB\u6570\u4E2A\u4E16\u7EAA\u8150\u5316\u5143\u7D20\u80FD\u91CF\u626D\u66F2\u7684\u6D3B\u751F\u751F\u7684\u6218\u4E89\u673A\u5668\u3002"
  - Name: monster22_des
    Text: "\u66FE\u540D\u4E3A\u65AF\u7279\u62C9\u745F\u514B\u65AF\u7684\u6218\u4E89\u673A\u5668\u5E76\u672A\u5C31\u6B64\u6C89\u5BC2\u3002\u5728\u76D6\u4E9A\u4F24\u75D5\u7D2F\u7D2F\u7684\u8868\u9762\u6E38\u8361\u4E86\u6570\u4E2A\u4E16\u7EAA\u540E\uFF0C\u5B83\u5438\u6536\u4E86\u88AB\u9057\u5FD8\u7684\u5408\u91D1\u788E\u7247\u3001\u8150\u5316\u7684\u6C34\u6676\u4EE5\u53CA\u5D29\u584C\u540E\u9057\u7559\u7684\u661F\u754C\u6B8B\u9AB8\u3002\u88AB\u8FDC\u53E4\u661F\u754C\u4E4B\u95E8\u7684\u88C2\u7F1D\u6240\u5438\u5F15\uFF0C\u5B83\u7684\u6838\u5FC3\u5F00\u59CB\u53D8\u5F02\u2014\u2014\u5E76\u975E\u8150\u673D\uFF0C\u800C\u662F\u8FDB\u5316\u3002\u76D6\u4E9A\u7684\u7194\u5CA9\u8109\u7EDC\u5C06\u5B83\u7684\u7CFB\u7EDF\u4E0E\u4E0D\u7A33\u5B9A\u7684\u5143\u7D20\u80FD\u91CF\u878D\u5408\uFF0C\u5F15\u53D1\u4E86\u4E00\u573A\u5267\u70C8\u7684\u91CD\u751F\u3002\u5982\u4ECA\uFF0C\u5B83\u5DF2\u91CD\u94F8\u4E3A\u65AF\u7279\u62C9\u745F\u514B\u65AF\uFF0C\u5176\u5408\u91D1\u8EAF\u4F53\u8FF8\u53D1\u51FA\u539F\u59CB\u7684\u529B\u91CF\uFF0C\u4E0D\u518D\u662F\u6BEB\u65E0\u610F\u8BC6\u7684\u9057\u8FF9\uFF0C\u800C\u662F\u4E00\u67B6\u88AB\u590D\u4EC7\u9A71\u4F7F\u7684\u5DE8\u517D\uFF0C\u9A71\u52A8\u5B83\u7684\u4E0D\u518D\u662F\u6307\u4EE4\uFF0C\u800C\u662F\u6124\u6012\u3002"
  - Name: monster23_des
    Text: "\u65AF\u7279\u62C9\u745F\u514B\u65AF\uFF08Strathex\uFF09\u6700\u521D\u53EA\u662F\u4E00\u4EF6\u88AB\u9057\u5F03\u7684\u6218\u4E89\u6B66\u5668\uFF0C\u5982\u4ECA\u5374\u5DF2\u8715\u53D8\u4E3A\u66F4\u52A0\u6050\u6016\u7684\u5B58\u5728\u3002\u5728\u7ECF\u5386\u5267\u70C8\u7684\u91CD\u751F\uFF0C\u5316\u8EAB\u4E3A\u65AF\u7279\u62C9\u745F\u68EE\uFF08Strathexen\uFF09\u4E4B\u540E\uFF0C\u8FD9\u66FE\u7ECF\u53D7\u7A0B\u5E8F\u675F\u7F1A\u7684\u5B9E\u4F53\u5F7B\u5E95\u89C9\u9192\u3002\u4ED6\u5BFB\u89C5\u7740\u76D6\u4E9A\u6700\u53E4\u8001\u7194\u7089\u7684\u9057\u8FF9\u548C\u5D29\u584C\u524D\u5B9E\u9A8C\u7684\u9057\u5740\uFF0C\u6316\u6398\u51FA\u6CE8\u5165\u4E86\u7EAF\u7CB9\u5143\u7D20\u6838\u5FC3\u7684\u5408\u91D1\u9057\u7269\u2014\u2014\u8FD9\u4E9B\u9057\u7269\u66FE\u88AB\u661F\u754C\u8054\u76DF\u5C01\u5370\u8BB8\u4E45\u3002\u968F\u7740\u4ED6\u88AB\u8150\u5316\u7684\u7CFB\u7EDF\u6574\u5408\u8FD9\u4E9B\u7981\u5FCC\u6750\u6599\uFF0C\u6700\u7EC8\u7684\u8715\u53D8\u5F00\u59CB\u4E86\u3002\u65AF\u7279\u62C9\u745F\u514B\u65AF\u4E0D\u518D\u4EC5\u4EC5\u662F\u6124\u6012\u7684\u8BB0\u5FC6\uFF0C\u800C\u662F\u6124\u6012\u7684\u5316\u8EAB\u3002\u4ED6\u5E76\u975E\u4E00\u4EF6\u6B66\u5668\uFF0C\u800C\u662F\u6E05\u7B97\u2014\u2014\u7531\u5E9F\u589F\u953B\u9020\uFF0C\u7531\u5D29\u584C\u8D4B\u4E88\u529B\u91CF\uFF0C\u5E76\u7531\u4EFB\u4F55\u4E3B\u4EBA\u90FD\u65E0\u6CD5\u9A7E\u9A6D\u7684\u610F\u5FD7\u6240\u9A71\u52A8\u3002"
  - Name: monster24_des
    Text: "\u8FD9\u5934\u70C8\u7130\u5DE8\u517D\u7531\u65E0\u58F0\u706B\u5C71\u55B7\u53D1\u7684\u7070\u70EC\u953B\u9020\u800C\u6210\uFF0C\u662F\u5E03\u83B1\u4F50\u5C14\u91CD\u751F\u7684\u7B2C\u4E00\u56E2\u706B\u7130\u3002\u5B83\u6BCF\u8D70\u4E00\u6B65\uFF0C\u7126\u571F\u4FBF\u5728\u5176\u5229\u722A\u4E0B\u5192\u51FA\u7F15\u7F15\u9752\u70DF\u3002\u5B83\u7A7F\u68AD\u4E8E\u76D6\u4E9A\u706B\u5C71\u7684\u4F24\u75D5\u4E4B\u4E2D\uFF0C\u7531\u6124\u6012\u548C\u8BB0\u5FC6\u6307\u5F15\u3002\u5C3D\u7BA1\u5B83\u4F53\u6001\u5C1A\u8F7B\uFF0C\u4F46\u4F53\u5185\u7684\u706B\u7130\u5374\u6C38\u4E0D\u7184\u706D\uFF0C\u94ED\u8BB0\u7740\u7FA4\u5C71\u80CC\u53DB\u5B83\u7684\u90A3\u4E2A\u591C\u665A\u3002"
  - Name: monster25_des
    Text: "\u706B\u7130\u4E0D\u518D\u62D6\u66F3\u5728\u8EAB\u540E\uFF0C\u800C\u662F\u4ECE\u4F53\u5185\u55B7\u6D8C\u800C\u51FA\u3002\u5728\u76D6\u4E9A\u707C\u70ED\u7684\u4F24\u53E3\u4E0A\u7ECF\u5386\u4E86\u65E0\u6570\u6B21\u6218\u6597\u540E\uFF0C\u5E03\u83B1\u5179\u5DF2\u8FDB\u5316\u6210\u7194\u5CA9\u6012\u706B\u7684\u6D3B\u4F53\u8F7D\u4F53\u3002\u4ED6\u5982\u4ECA\u62AB\u7740\u706B\u5C71\u677F\u7532\u7684\u76AE\u6BDB\u6563\u53D1\u7740\u707C\u70ED\u7684\u5149\u8292\uFF0C\u4ED6\u7684\u547C\u5438\u5728\u5F00\u53E3\u4E4B\u524D\u4FBF\u5DF2\u707C\u70E7\u7A7A\u6C14\u3002\u706B\u7130\u5728\u4ED6\u7684\u9B03\u6BDB\u3001\u5C3E\u5DF4\u548C\u6240\u5230\u4E4B\u5904\u821E\u52A8\u3002\u8FD9\u4E0D\u518D\u662F\u8BB0\u5FC6\u7684\u706B\u7130\uFF0C\u800C\u662F\u884C\u52A8\u7684\u706B\u7130\u3002"
  - Name: monster26_des
    Text: "\u901D\u53BB\u7684\u7070\u70EC\u5DF2\u4E0D\u590D\u5B58\u5728\uFF0C\u552F\u6709\u590D\u4EC7\u4E4B\u706B\u718A\u718A\u71C3\u70E7\u3002\u5E03\u96F7\u4F50\u5C14\u7684\u6700\u7EC8\u5F62\u6001\uFF0C\u662F\u6124\u6012\u4E0E\u51B3\u5FC3\u7684\u70BD\u70C8\u590D\u4EC7\u8005\u3002\u4ED6\u9AA8\u94F8\u7684\u5C3E\u5DF4\u548C\u7126\u707C\u7684\u5934\u9AA8\u71C3\u70E7\u7740\u5148\u7956\u7684\u706B\u7130\uFF0C\u6BD4\u5CA9\u6D46\u66F4\u70BD\u70ED\uFF0C\u6BD4\u521D\u6B21\u55B7\u53D1\u66F4\u8000\u773C\u3002\u4ED6\u4E0D\u518D\u5BFB\u6C42\u590D\u4EC7\uFF0C\u56E0\u4E3A\u4ED6\u5C31\u662F\u6E05\u7B97\u3002\u4ED6\u6240\u5230\u4E4B\u5904\uFF0C\u706B\u5C71\u7686\u4E3A\u9707\u98A4\uFF0C\u56E0\u4E3A\u5BA1\u5224\u7684\u65F6\u523B\u5DF2\u7136\u6765\u4E34\u3002"
  - Name: monster27_des
    Text: "\u6D77\u5C14\u96C5\u4E0D\u518D\u9690\u533F\u4E8E\u9634\u5F71\u4E4B\u4E2D\uFF0C\u5979\u5DF2\u7136\u5316\u4F5C\u5168\u65B0\u5F62\u6001\u3002\u5979\u7684\u4E0B\u534A\u8EAB\u4E0E\u5979\u66FE\u6A21\u4EFF\u7684\u68EE\u6797\u5DE8\u517D\u878D\u4E3A\u4E00\u4F53\uFF0C\u624B\u4E2D\u7684\u6CD5\u6756\u8574\u542B\u7740\u5143\u7D20\u667A\u6167\uFF0C\u5B88\u62A4\u7740\u795E\u5723\u7684\u6797\u95F4\u7A7A\u5730\u514D\u53D7\u8150\u5316\u4FB5\u8680\u3002\u5979\u7684\u6E21\u9E26\u6307\u5F15\u7740\u8FF7\u5931\u7684\u7075\u9B42\uFF0C\u60E9\u7F5A\u7740\u90A3\u4E9B\u5FC3\u6000\u4E0D\u8F68\u4E4B\u4EBA\u3002\u4E00\u4E9B\u62C2\u6653\u8840\u76DF\u7684\u6210\u5458\u58F0\u79F0\u66FE\u76EE\u7779\u8FC7\u5979\u8B66\u793A\u7684\u76EE\u5149\u2026\u2026\u800C\u53E6\u4E00\u4E9B\u4EBA\u5219\u53EA\u8BB0\u5F97\u6811\u6728\u9010\u6E10\u903C\u8FD1\u3002"
  - Name: monster28_des
    Text: "\u6D77\u5C14\u5FB7\u4E0D\u518D\u53EA\u662F\u68EE\u6797\u4E2D\u7684\u5E7B\u5F71\uFF0C\u5979\u5DF2\u7136\u63A5\u53D7\u4E86\u81EA\u5DF1\u4F5C\u4E3A\u5E73\u8861\u5B88\u62A4\u8005\u7684\u4F7F\u547D\u3002\u5979\u7684\u5B9D\u77F3\u6CD5\u6756\u6D8C\u52A8\u7740\u8FDC\u53E4\u7FE0\u7EFF\u7684\u529B\u91CF\uFF0C\u6E21\u9E26\u59CB\u7EC8\u4F34\u5979\u5DE6\u53F3\uFF0C\u5979\u7F16\u7EC7\u7740\u4FDD\u62A4\u6027\u7684\u7ED3\u754C\u548C\u590D\u4EC7\u7684\u8BC5\u5492\uFF0C\u4E24\u8005\u517C\u5907\u3002\u80C6\u6562\u6270\u4E71\u76D6\u4E9A\u548C\u8C10\u4E4B\u4EBA\uFF0C\u5176\u529B\u91CF\u5C06\u88AB\u65E0\u5F62\u7684\u85E4\u8513\u5438\u53D6\uFF0C\u9053\u8DEF\u5C06\u88AB\u6C38\u6052\u7684\u8FF7\u96FE\u6240\u541E\u566C\u3002"
  - Name: monster29_des
    Text: "\u5982\u4ECA\uFF0C\u80E1\u5C14\u5FB7\u62C9\u5DF2\u5B8C\u5168\u89C9\u9192\uFF0C\u6210\u4E3A\u68EE\u6797\u7684\u81F3\u9AD8\u4E3B\u5BB0\uFF0C\u5979\u80FD\u9A7E\u9A6D\u76D6\u4E9A\u7684\u539F\u59CB\u610F\u5FD7\u3002\u5979\u6743\u6756\u7684\u7FE1\u7FE0\u4E4B\u5FC3\u95EA\u8000\u7740\u5148\u7956\u7684\u8BB0\u5FC6\uFF0C\u5979\u7684\u58F0\u97F3\u80FD\u7EDF\u5FA1\u6811\u53F6\u3001\u91CE\u517D\u548C\u9634\u5F71\u3002\u6816\u606F\u5728\u5979\u8EAB\u65C1\u7684\u6E21\u9E26\u4E0D\u518D\u662F\u4FA6\u5BDF\u5175\uFF0C\u800C\u662F\u6E05\u7B97\u7684\u4F7F\u8005\u3002\u5728\u80E1\u5C14\u5FB7\u62C9\u7684\u9886\u5730\uFF0C\u81EA\u7136\u4E0D\u4F1A\u5BBD\u6055\uFF0C\u5B83\u4F1A\u94ED\u8BB0\uFF0C\u5E76\u6536\u56DE\u4E00\u5207\u3002"
  - Name: monster2000_des
    Text: "\u70DF\u5F71\u8BDE\u751F\u4E8E\u88AB\u9057\u5FD8\u7684\u6218\u573A\u7070\u70EC\u4E4B\u4E2D\uFF0C\u662F\u4E00\u56E2\u8FC5\u75BE\u65E0\u58F0\u3001\u7B3C\u7F69\u5728\u9634\u5F71\u4E2D\u7684\u706B\u7130\u3002\u4ED6\u8EAB\u62AB\u7126\u707C\u7684\u6218\u888D\uFF0C\u624B\u6301\u707C\u70ED\u7684\u5229\u5203\uFF0C\u5982\u540C\u98CE\u4E2D\u7684\u70DF\u96FE\u822C\u7A7F\u68AD\u4E8E\u6218\u573A\u3002\u4ED6\u7684\u6BCF\u4E00\u4E2A\u52A8\u4F5C\u90FD\u62D6\u66F3\u7740\u4F59\u70EC\uFF0C\u71C3\u70E7\u7684\u76EE\u5149\u575A\u5B9A\u5730\u7A7F\u900F\u9ED1\u6697\u3002\u540E\u88D4\u4EEC\u4F4E\u8BED\u9053\uFF0C\u4ED6\u662F\u9668\u843D\u6218\u58EB\u7075\u9B42\u7684\u6B8B\u5B58\uFF0C\u88AB\u8BC5\u5492\u5728\u6C38\u6052\u7684\u5BC2\u9759\u4E2D\u6218\u6597\u2014\u2014\u51FA\u624B\u8FC5\u6377\uFF0C\u6D88\u5931\u5F97\u66F4\u5FEB\u3002"
  - Name: monster2001_des
    Text: "\u7531\u7194\u878D\u5408\u91D1\u548C\u8FDC\u53E4\u7535\u8DEF\u6784\u6210\u7684\u5E9E\u5927\u5DE8\u517D\u6208\u5229\u514B\u65AF\uFF0C\u5728\u88AB\u9057\u5FD8\u7684\u7194\u7089\u5E9F\u589F\u4E2D\u8E52\u8DDA\u800C\u884C\u3002\u5B83\u90A3\u53EA\u4E00\u52A8\u4E0D\u52A8\u7684\u773C\u775B\u95EA\u70C1\u7740\u65E0\u58F0\u7684\u5149\u8292\uFF0C\u641C\u5BFB\u7740\u5165\u4FB5\u8005\u548C\u9057\u5931\u7684\u9057\u7269\u3002\u5B83\u8EAB\u62AB\u7126\u6A59\u8272\u7684\u91D1\u5C5E\u76D4\u7532\uFF0C\u80F8\u524D\u6709\u4E00\u4E2A\u5706\u5F62\u6838\u5FC3\uFF0C\u636E\u4FE1\u7528\u4E8E\u8C03\u8282\u5185\u90E8\u538B\u529B\u548C\u80FD\u91CF\u3002\u6208\u5229\u514B\u65AF\u7684\u53CC\u81C2\u6C89\u91CD\u5982\u94C1\u7827\uFF0C\u53CC\u817F\u5219\u7EAF\u7CB9\u4E3A\u4E86\u7A33\u5B9A\u800C\u6253\u9020\uFF0C\u5B83\u7684\u653B\u51FB\u5982\u540C\u574D\u584C\u7684\u77F3\u67F1\u2014\u2014\u7F13\u6162\u3001\u6C89\u7A33\uFF0C\u5374\u53C8\u6781\u5177\u6740\u4F24\u529B\u3002"
  - Name: monster2002_des
    Text: "\u5854\u7D22\u514B\u884C\u52A8\u7F13\u6162\u3001\u6C89\u9ED8\u65E0\u58F0\uFF0C\u5374\u53C8\u65E0\u6BD4\u575A\u97E7\uFF0C\u5B83\u662F\u4E00\u53EA\u4ECE\u6D77\u5E95\u5347\u8D77\u7684\u6DF1\u6D77\u6F2B\u6E38\u8005\u3002\u5B83\u539A\u5B9E\u7684\u87BA\u65CB\u72B6\u5916\u58F3\u4E0A\u8986\u76D6\u7740\u53C2\u5DEE\u4E0D\u9F50\u7684\u73CA\u745A\uFF0C\u90A3\u662F\u5B83\u4E00\u751F\u6F02\u6CCA\u4E8E\u7901\u77F3\u5893\u5730\u548C\u6D77\u5E95\u6D77\u6C9F\u7684\u75D5\u8FF9\u3002\u5C3D\u7BA1\u5B83\u7684\u884C\u52A8\u5982\u540C\u51B0\u5DDD\u4E00\u822C\u7F13\u6162\uFF0C\u4F46\u6BCF\u4E00\u6B65\u90FD\u627F\u8F7D\u7740\u51E0\u4E2A\u4E16\u7EAA\u7684\u91CD\u91CF\u3002\u5854\u7D22\u514B\u62E5\u6709\u4E00\u53EA\u95EA\u95EA\u53D1\u5149\u7684\u773C\u775B\uFF0C\u8EAB\u4F53\u8109\u52A8\u7740\u6F6E\u6C50\u7684\u80FD\u91CF\uFF0C\u5B83\u8C61\u5F81\u7740\u5927\u6D77\u672C\u8EAB\u7684\u8010\u5FC3\u548C\u6BC1\u706D\u6027\u7684\u529B\u91CF\u2014\u2014\u4E00\u65E6\u88AB\u6FC0\u6012\uFF0C\u4FBF\u52BF\u4E0D\u53EF\u6321\u3002"
  - Name: monster2003_des
    Text: "\u62C9\u7EF4\u5C14\u662F\u4E00\u4F4D\u795E\u79D8\u83AB\u6D4B\u7684\u5B58\u5728\uFF0C\u65E2\u4F18\u96C5\u53C8\u5145\u6EE1\u5A01\u80C1\u3002\u4ED6\u8EAB\u59FF\u633A\u62D4\uFF0C\u5B9B\u5982\u4E00\u5339\u7531\u9634\u5F71\u953B\u9020\u7684\u9A8F\u9A6C\uFF0C\u53CC\u7FFC\u6536\u62E2\uFF0C\u65E0\u58F0\u5730\u5C55\u73B0\u7740\u4ED6\u7684\u6840\u9A9C\u4E0D\u9A6F\u3002\u5C3D\u7BA1\u4ED6\u7684\u8EAB\u5F62\u770B\u4F3C\u4F18\u96C5\uFF0C\u4F46\u771F\u6B63\u7684\u529B\u91CF\u5374\u9690\u85CF\u5728\u9AA8\u9ABC\u4E4B\u4E0B\u2014\u2014\u7531\u5BCC\u542B\u91D1\u5C5E\u7CBE\u534E\u953B\u9020\u800C\u6210\u7684\u9AA8\u9ABC\uFF0C\u5200\u5251\u70C8\u7130\u90FD\u65E0\u6CD5\u64BC\u52A8\u4ED6\u3002\u4ED6\u53CC\u76EE\u5982\u7194\u91D1\u822C\u95EA\u8000\uFF0C\u7284\u89D2\u53D1\u51FA\u5143\u7D20\u5171\u9E23\u7684\u55E1\u9E23\uFF0C\u62C9\u7EF4\u5C14\u4EE5\u4E00\u79CD\u4EE4\u4EBA\u80C6\u5BD2\u7684\u59FF\u6001\u6ED1\u8FC7\u6218\u573A\u3002\u9C9C\u6709\u4EBA\u6562\u4E0E\u4ED6\u6B63\u9762\u4EA4\u950B\uFF0C\u56E0\u4E3A\u4ED6\u6BCF\u4E00\u6B65\u7684\u811A\u6B65\u90FD\u5982\u540C\u94E0\u7532\u822C\u5728\u6218\u573A\u4E0A\u56DE\u8361\u3002"
  - Name: monster2004_des
    Text: "\u8FC5\u6377\u800C\u65E0\u60C5\u7684\u7A7A\u4E2D\u63A0\u98DF\u8005\uFF0C\u6BD2\u8702\uFF08Venomelra\uFF09\u5728\u7A7A\u4E2D\u75BE\u9A70\uFF0C\u7D2B\u91D1\u8272\u7684\u5149\u8292\u95EA\u70C1\u4E0D\u5B9A\u3002\u5B83\u62E5\u6709\u534A\u900F\u660E\u7684\u9EC4\u8272\u7FC5\u8180\uFF0C\u4EE5\u53CA\u5982\u540C\u7194\u5316\u7684\u7425\u73C0\u822C\u95EA\u8000\u7684\u6BD2\u523A\uFF0C\u8FD9\u79CD\u5F62\u4F3C\u9EC4\u8702\u7684\u56DE\u58F0\u751F\u7269\u65E2\u7F8E\u4E3D\u53C8\u81F4\u547D\u3002\u5B83\u5149\u6ED1\u7684\u8EAB\u8EAF\u4E0B\u9690\u85CF\u7740\u7531\u73CD\u7A00\u690D\u7269\u71AC\u5236\u800C\u6210\u7684\u5F3A\u6548\u6BD2\u7D20\uFF0C\u5373\u4F7F\u53EA\u88AB\u8707\u4E00\u4E0B\uFF0C\u4E5F\u53EF\u80FD\u4F7F\u4EBA\u762B\u75EA\u3002\u5F88\u5C11\u6709\u4EBA\u80FD\u9884\u77E5\u5B83\u7684\u5230\u6765\u2014\u2014\u800C\u80FD\u6D3B\u7740\u8BB2\u8FF0\u8FD9\u6BB5\u7ECF\u5386\u7684\u66F4\u662F\u5BE5\u5BE5\u65E0\u51E0\u3002"
  - Name: monster2005_des
    Text: "\u51EF\u8389\u8299\u62C9\u662F\u5929\u7A7A\u4E0E\u6D77\u6D0B\u4E2D\u7F55\u89C1\u7684\u5947\u89C2\uFF0C\u5979\u4EE5\u5B81\u9759\u4F18\u96C5\u7684\u59FF\u6001\u7FF1\u7FD4\u4E8E\u7A7A\u4E2D\uFF0C\u51B0\u84DD\u8272\u4E0E\u767D\u8272\u7684\u7FC5\u8180\u5728\u6708\u5149\u4E0B\u95EA\u70C1\uFF0C\u5B9B\u5982\u6CE2\u5149\u7CBC\u7CBC\u7684\u6D77\u9762\u3002\u867D\u7136\u5979\u8BDE\u751F\u4E8E\u6C34\u5143\u7D20\uFF0C\u5374\u9C9C\u5C11\u89E6\u5730\uFF0C\u66F4\u559C\u6B22\u76D8\u65CB\u4E8E\u6D77\u98CE\u548C\u8FF7\u96FE\u4E4B\u4E2D\u3002\u5979\u90A3\u53EA\u72EC\u7279\u7684\u773C\u775B\u6563\u53D1\u7740\u6C89\u9759\u7684\u667A\u6167\uFF0C\u800C\u5979\u90A3\u95EA\u4EAE\u7684\u89E6\u89D2\u5219\u80FD\u611F\u77E5\u5929\u6C14\u548C\u6F6E\u6C50\u7684\u53D8\u5316\u3002\u51EF\u8389\u8299\u62C9\u6027\u60C5\u6E29\u548C\u5374\u53C8\u96BE\u4EE5\u6349\u6478\uFF0C\u56E0\u6B64\u5E38\u5E38\u88AB\u4EBA\u8BEF\u8BA4\u4E3A\u662F\u98CE\u66B4\u4E4B\u7075\u3002"
  - Name: monster2006_des
    Text: "\u5FB7\u96F7\u683C\u7C73\u5C14\u8BDE\u751F\u4E8E\u8150\u673D\u5730\u8109\u7684\u9634\u5F71\u4E4B\u4E2D\uFF0C\u662F\u5143\u7D20\u6DF7\u6C8C\u7684\u7578\u5F62\u5E7D\u7075\u3002\u5B83\u90A3\u53EA\u5B64\u96F6\u96F6\u3001\u4E00\u52A8\u4E0D\u52A8\u7684\u773C\u775B\u71C3\u70E7\u7740\u5F02\u4E4E\u5BFB\u5E38\u7684\u611F\u77E5\uFF0C\u7EFF\u8272\u7684\u706B\u7130\u4ECE\u5B83\u7684\u624B\u81C2\u548C\u5934\u90E8\u6E17\u51FA\uFF0C\u5982\u540C\u5177\u8C61\u5316\u7684\u6BD2\u6027\u610F\u5FD7\u3002\u5FB7\u96F7\u683C\u7C73\u5C14\u56DB\u80A2\u7EC6\u957F\uFF0C\u8EAB\u8EAF\u4EFF\u4F5B\u5728\u7EF4\u5EA6\u95F4\u6E38\u8361\uFF0C\u5B83\u5F98\u5F8A\u4E8E\u8BC5\u5492\u4E4B\u5730\uFF0C\u88AB\u8150\u673D\u4E0E\u7EDD\u671B\u6240\u5438\u5F15\u3002\u4E00\u4E9B\u5148\u7956\u8BF4\u5B83\u4F1A\u4F4E\u8BED\u2014\u2014\u4F46\u51E1\u503E\u542C\u8FC7\u5B83\u4F4E\u8BED\u7684\u4EBA\uFF0C\u90FD\u5DF2\u9762\u76EE\u5168\u975E\u3002"
  - Name: monster2007_des
    Text: "\u5965\u5E03\u897F\u6D1B\u514B\u8BDE\u751F\u4E8E\u76D6\u4E9A\u6C34\u6676\u6D1E\u7A74\u6700\u6DF1\u5904\u7684\u8109\u7EDC\uFF0C\u662F\u5CA9\u77F3\u4E0E\u95EA\u8000\u6012\u706B\u7684\u5B88\u62A4\u8005\u3002\u5B83\u7D27\u51D1\u7684\u8EAB\u8EAF\u62AB\u7740\u952F\u9F7F\u72B6\u7684\u7D2B\u8272\u5CA9\u77F3\u94E0\u7532\uFF0C\u7329\u7EA2\u7684\u6C34\u6676\u5982\u540C\u5929\u7136\u5229\u5203\u822C\u4ECE\u56DB\u80A2\u4F38\u51FA\u3002\u4E00\u53EA\u95EA\u7740\u5BD2\u5149\u7684\u773C\u775B\u51B7\u9177\u800C\u575A\u5B9A\u5730\u5BA1\u89C6\u7740\u5468\u56F4\u7684\u4E00\u5207\u3002\u9759\u8C27\u65F6\uFF0C\u5B83\u5BC2\u9759\u65E0\u58F0\uFF0C\u7EB9\u4E1D\u4E0D\u52A8\uFF1B\u4F46\u5F53\u5927\u5730\u98A4\u6296\u4E4B\u65F6\uFF0C\u5965\u5E03\u897F\u6D1B\u514B\u4FBF\u4F1A\u82CF\u9192\uFF0C\u4EE5\u5730\u58F3\u8FD0\u52A8\u822C\u7684\u72C2\u6012\u4E4B\u529B\uFF0C\u5B88\u62A4\u5730\u8868\u4E4B\u4E0B\u7684\u5E73\u8861\u3002"
  - Name: monster2008_des
    Text: "\u6F5C\u4F0F\u5728\u76D6\u4E9A\u6700\u8352\u91CE\u5730\u5E26\u8302\u5BC6\u7684\u704C\u6728\u4E1B\u4E2D\uFF0C\u5965\u5E93\u6D1B\u62C9\u514B\u662F\u4E00\u79CD\u690D\u7269\u4E0E\u63A0\u98DF\u8005\u602A\u8BDE\u7684\u878D\u5408\u4F53\u3002\u5B83\u5F62\u4F3C\u53D8\u5F02\u7684\u6355\u8747\u8349\uFF0C\u5DE8\u5927\u7684\u5634\u5DF4\u91CC\u6D41\u6DCC\u7740\u8150\u8680\u6027\u7684\u6C41\u6DB2\uFF0C\u5634\u89D2\u5E03\u6EE1\u952F\u9F7F\u72B6\u7684\u82B1\u74E3\u72B6\u7360\u7259\uFF0C\u968F\u65F6\u51C6\u5907\u541E\u566C\u4EFB\u4F55\u80C6\u6562\u9760\u8FD1\u7684\u751F\u7269\u3002\u5C3D\u7BA1\u6839\u690D\u4E8E\u81EA\u7136\u5143\u7D20\uFF0C\u5965\u5E93\u6D1B\u62C9\u514B\u5374\u6BEB\u65E0\u6E29\u60C5\u53EF\u8A00\uFF0C\u53EA\u6709\u9965\u997F\u3002\u4F20\u8BF4\u5B83\u7684\u773C\u775B\u4ECE\u4E0D\u7728\u52A8\uFF0C\u65F6\u523B\u6CE8\u89C6\u7740\uFF0C\u7B49\u5F85\u7740\u4E0B\u4E00\u4E2A\u80C6\u6562\u8E0F\u5165\u5176\u9886\u5730\u7684\u4E0D\u901F\u4E4B\u5BA2\u3002"
  - Name: monster2009_des
    Text: "\u6DF1\u57CB\u4E8E\u76D6\u4E9A\u53D8\u5E7B\u83AB\u6D4B\u7684\u5730\u58F3\u4E4B\u4E0B\uFF0C\u7C73\u5C14\u6C83\u514B\u662F\u575A\u97E7\u4E0E\u654F\u611F\u7684\u5947\u5999\u878D\u5408\u4F53\u3002\u5B83\u7D2B\u8272\u7684\u94E0\u7532\u8282\u6BB5\u4FDD\u62A4\u5B83\u514D\u53D7\u5760\u843D\u788E\u77F3\u548C\u6355\u98DF\u8005\u7684\u4FB5\u88AD\uFF0C\u800C\u67D4\u8F6F\u7684\u84DD\u7EFF\u8272\u8179\u90E8\u5219\u4F7F\u5B83\u80FD\u591F\u94BB\u8FC7\u6700\u72ED\u7A84\u7684\u7F1D\u9699\u3002\u9AD8\u8038\u7684\u89E6\u89D2\u4E0B\u95EA\u70C1\u7740\u4E00\u53EA\u72EC\u7279\u7684\u773C\u775B\uFF0C\u654F\u9510\u5730\u611F\u77E5\u7740\u5468\u56F4\u4E16\u754C\u7684\u9707\u98A4\u3002\u5C3D\u7BA1\u4F53\u578B\u5A07\u5C0F\uFF0C\u7C73\u5C14\u6C83\u514B\u5374\u662F\u5927\u5730\u8B66\u60D5\u7684\u5B88\u62A4\u8005\u2014\u2014\u53EA\u6709\u5F53\u5730\u8868\u4E0B\u7684\u5E73\u8861\u88AB\u6253\u7834\u65F6\uFF0C\u5B83\u624D\u4F1A\u73B0\u8EAB\u3002"
  - Name: monster1000_des
    Text: "\u624E\u5C14\u7EF4\u514B\u65AF\u5E76\u975E\u666E\u901A\u7684\u6307\u6325\u5B98\u2014\u2014\u4ED6\u662F\u4E00\u4F4D\u80FD\u91CF\u901A\u9053\u3002\u8FD9\u4F4D\u8BDE\u751F\u4E8E\u88C2\u9699\u6700\u6DF1\u5904\u7684\u5148\u77E5\uFF0C\u80FD\u591F\u5F15\u5BFC\u539F\u59CB\u7684\u865A\u7A7A\u80FD\u91CF\uFF0C\u6467\u6BC1\u5F62\u4F53\uFF0C\u627C\u6740\u601D\u60F3\uFF0C\u74E6\u89E3\u4E00\u5207\u62B5\u6297\u3002\u4ED6\u8EAB\u62AB\u865A\u7A7A\u4E4B\u706B\uFF0C\u5934\u6234\u795E\u79D8\u7B26\u6587\uFF0C\u53E3\u4E2D\u8BF4\u7740\u6740\u622E\u4E4B\u8BED\u3002\u4ED6\u7684\u80FD\u529B\u80FD\u591F\u626D\u66F2\u65F6\u95F4\u3001\u7A7A\u95F4\u548C\u610F\u5FD7\uFF0C\u4F7F\u4ED6\u6210\u4E3A\u4EFB\u4F55\u661F\u754C\u5165\u4FB5\u4E2D\u6700\u53EF\u6015\u7684\u5A01\u80C1\u3002"
  - Name: monster1001_des
    Text: "\u827E\u514B\u624E\u91CC\u662F\u5F17\u96F7\u57FA\u5C14\u8702\u5DE2\u7684\u65CF\u957F\u2014\u2014\u53E4\u8001\u3001\u81C3\u80BF\uFF0C\u5374\u5907\u53D7\u5C0A\u5D07\u3002\u5979\u7684\u8EAB\u4F53\u5982\u540C\u4E00\u4E2A\u5B55\u80B2\u7740\u751F\u7269\u6709\u673A\u6050\u6016\u751F\u7269\u7684\u5BB9\u5668\uFF0C\u80FD\u591F\u5728\u6218\u6597\u4E2D\u5B75\u5316\u51FA\u5E7C\u866B\u548C\u53D8\u5F02\u4E91\u3002\u5979\u7684\u6BCF\u4E00\u4E2A\u5B69\u5B50\u90FD\u4E0E\u5979\u7684\u610F\u5FD7\u6709\u7740\u7CBE\u795E\u4E0A\u7684\u8054\u7CFB\uFF0C\u800C\u5979\u7684\u8702\u5DE2\u610F\u8BC6\u751A\u81F3\u80FD\u591F\u667A\u80DC\u6700\u8BAD\u7EC3\u6709\u7D20\u7684\u7A81\u51FB\u961F\u3002\u5979\u7684\u6218\u8D25\u5E76\u975E\u7EC8\u7ED3\u2014\u2014\u5B83\u53EA\u662F\u6682\u65F6\u963B\u6B62\u4E86\u8FD9\u573A\u6D69\u52AB\u3002\u9664\u975E\u88AB\u5F7B\u5E95\u6D88\u706D\uFF0C\u5426\u5219\u5979\u7684\u540E\u4EE3\u5C06\u7EE7\u7EED\u5728\u6218\u573A\u9634\u5F71\u4E2D\u5B55\u80B2\u3002"
  - Name: monster1002_des
    Text: "\u8428\u8BFA\u514B\u65AF\u662F\u4E00\u53F0\u79FB\u52A8\u761F\u75AB\u673A\u5668\u2014\u2014\u5B83\u65E2\u662F\u62FE\u8352\u8005\uFF0C\u53C8\u662F\u7A81\u51FB\u961F\u5458\uFF0C\u6D51\u8EAB\u6563\u53D1\u7740\u6050\u6016\u6C14\u606F\u3002\u5B83\u6D51\u8EAB\u957F\u6EE1\u6709\u6BD2\u7684\u8D58\u751F\u7269\uFF0C\u7531\u6536\u5272\u7684\u7269\u8D28\u7F1D\u5408\u800C\u6210\uFF0C\u5176\u8EAF\u4F53\u5B9E\u65F6\u53D8\u5F02\uFF0C\u80FD\u591F\u9002\u5E94\u635F\u4F24\u5E76\u5411\u6218\u573A\u55B7\u5410\u6C61\u79FD\u3002\u5F17\u96F7\u57FA\u5C14\u4EBA\u5229\u7528\u50CF\u8428\u8BFA\u514B\u65AF\u8FD9\u6837\u7684\u6536\u5272\u8005\u6765\u6E05\u9664\u62B5\u6297\u52BF\u529B\u2014\u2014\u901A\u8FC7\u6D88\u5316\u6216\u8150\u70C2\u7684\u65B9\u5F0F\u3002\u5B83\u7684\u51FA\u73B0\u4E0D\u4EC5\u610F\u5473\u7740\u5165\u4FB5\uFF0C\u66F4\u610F\u5473\u7740\u761F\u75AB\u7684\u8513\u5EF6\u3002\u6467\u6BC1\u5B83\u8FD8\u4E0D\u591F\uFF0C\u4F60\u8FD8\u5FC5\u987B\u711A\u70E7\u5B83\u89E6\u53CA\u8FC7\u7684\u571F\u5730\u3002"
  - Name: monster1003_des
    Text: "\u8F9B\u8428\u91CC\u5B88\u536B\u662F\u5F17\u96F7\u57FA\u5C14\u866B\u7FA4\u7684\u7075\u80FD\u7279\u5DE5\u3002\u5B83\u65E2\u662F\u5BA1\u8BAF\u8005\u53C8\u662F\u523D\u5B50\u624B\uFF0C\u5728\u6467\u6BC1\u730E\u7269\u8089\u4F53\u4E4B\u524D\uFF0C\u4FBF\u5148\u4FB5\u8680\u5176\u5FC3\u667A\u3002\u5B83\u5934\u9876\u7684\u8109\u52A8\u5706\u9876\u65E2\u662F\u866B\u7FA4\u7075\u80FD\u4FE1\u53F7\u7684\u653E\u5927\u5668\uFF0C\u4E5F\u662F\u5176\u4F20\u5BFC\u901A\u9053\uFF0C\u4F7F\u5176\u80FD\u591F\u5728\u6218\u6597\u4E2D\u538B\u5236\u654C\u4EBA\u7684\u6CD5\u672F\u5E76\u6270\u4E71\u5176\u601D\u7EF4\u3002\u8FD9\u79CD\u751F\u7269\u66FE\u4E00\u5EA6\u88AB\u88C2\u9699\u5B66\u8005\u89C6\u4E3A\u4F20\u8BF4\uFF0C\u5982\u4ECA\u5B83\u51FA\u73B0\u5728\u4F20\u9001\u95E8\u524D\uFF0C\u9884\u793A\u7740\u866B\u7FA4\u5373\u5C06\u5347\u7EA7\u884C\u52A8\u3002"
  - Name: monster1004_des
    Text: "\u9ED1\u66DC\u77F3\u6F5C\u884C\u8005\u662F\u5F17\u96F7\u57FA\u5C14\u7684\u7B2C\u4E00\u9053\u9632\u7EBF\u2014\u2014\u6279\u91CF\u751F\u4EA7\u3001\u534A\u667A\u80FD\u4E14\u6BEB\u4E0D\u7559\u60C5\u3002\u8FD9\u79CD\u65E0\u4EBA\u673A\u7531\u9ED1\u66DC\u77F3\u51E0\u4E01\u8D28\u548C\u8109\u51B2\u53CD\u5E94\u808C\u8089\u7EA4\u7EF4\u953B\u9020\u800C\u6210\uFF0C\u5176\u8FD0\u4F5C\u6548\u7387\u4E4B\u9AD8\uFF0C\u4E0E\u5176\u7B80\u5355\u7684\u6784\u9020\u5F62\u6210\u9C9C\u660E\u5BF9\u6BD4\u3002\u867D\u7136\u5728\u540C\u7C7B\u4E2D\u5730\u4F4D\u8F83\u4F4E\uFF0C\u4F46\u5176\u901F\u5EA6\u548C\u6495\u88C2\u62A4\u7532\u7684\u653B\u51FB\u529B\uFF0C\u5BF9\u4E8E\u6BEB\u65E0\u9632\u5907\u7684\u654C\u4EBA\u800C\u8A00\uFF0C\u65E0\u7591\u662F\u4E00\u4E2A\u5371\u9669\u7684\u5BF9\u624B\u3002\u8FD9\u4E9B\u751F\u7269\u901A\u5E38\u5355\u72EC\u884C\u52A8\uFF0C\u8D1F\u8D23\u4FA6\u5BDF\u6216\u5B88\u536B\u5E9F\u5F03\u7684\u57CE\u95E8\uFF0C\u4F46\u4E00\u65E6\u53D7\u5230\u5A01\u80C1\uFF0C\u5B83\u4EEC\u4FBF\u4F1A\u5316\u8EAB\u4E3A\u55DC\u8840\u7684\u523D\u5B50\u624B\u3002"
  - Name: monster1100_des
    Text: "\u624E\u5C14\u7EF4\u514B\u65AF\u5E76\u975E\u666E\u901A\u7684\u6307\u6325\u5B98\u2014\u2014\u4ED6\u662F\u4E00\u4F4D\u80FD\u91CF\u901A\u9053\u3002\u8FD9\u4F4D\u8BDE\u751F\u4E8E\u88C2\u9699\u6700\u6DF1\u5904\u7684\u5148\u77E5\uFF0C\u80FD\u591F\u5F15\u5BFC\u539F\u59CB\u7684\u865A\u7A7A\u80FD\u91CF\uFF0C\u6467\u6BC1\u5F62\u4F53\uFF0C\u627C\u6740\u601D\u60F3\uFF0C\u74E6\u89E3\u4E00\u5207\u62B5\u6297\u3002\u4ED6\u8EAB\u62AB\u865A\u7A7A\u4E4B\u706B\uFF0C\u5934\u6234\u795E\u79D8\u7B26\u6587\uFF0C\u53E3\u4E2D\u8BF4\u7740\u6740\u622E\u4E4B\u8BED\u3002\u4ED6\u7684\u80FD\u529B\u80FD\u591F\u626D\u66F2\u65F6\u95F4\u3001\u7A7A\u95F4\u548C\u610F\u5FD7\uFF0C\u4F7F\u4ED6\u6210\u4E3A\u4EFB\u4F55\u661F\u754C\u5165\u4FB5\u4E2D\u6700\u53EF\u6015\u7684\u5A01\u80C1\u3002"
  - Name: monster1101_des
    Text: "\u827E\u514B\u624E\u91CC\u662F\u5F17\u96F7\u57FA\u5C14\u8702\u5DE2\u7684\u65CF\u957F\u2014\u2014\u53E4\u8001\u3001\u81C3\u80BF\uFF0C\u5374\u5907\u53D7\u5C0A\u5D07\u3002\u5979\u7684\u8EAB\u4F53\u5982\u540C\u4E00\u4E2A\u5B55\u80B2\u7740\u751F\u7269\u6709\u673A\u6050\u6016\u751F\u7269\u7684\u5BB9\u5668\uFF0C\u80FD\u591F\u5728\u6218\u6597\u4E2D\u5B75\u5316\u51FA\u5E7C\u866B\u548C\u53D8\u5F02\u4E91\u3002\u5979\u7684\u6BCF\u4E00\u4E2A\u5B69\u5B50\u90FD\u4E0E\u5979\u7684\u610F\u5FD7\u6709\u7740\u7CBE\u795E\u4E0A\u7684\u8054\u7CFB\uFF0C\u800C\u5979\u7684\u8702\u5DE2\u610F\u8BC6\u751A\u81F3\u80FD\u591F\u667A\u80DC\u6700\u8BAD\u7EC3\u6709\u7D20\u7684\u7A81\u51FB\u961F\u3002\u5979\u7684\u6218\u8D25\u5E76\u975E\u7EC8\u7ED3\u2014\u2014\u5B83\u53EA\u662F\u6682\u65F6\u963B\u6B62\u4E86\u8FD9\u573A\u6D69\u52AB\u3002\u9664\u975E\u88AB\u5F7B\u5E95\u6D88\u706D\uFF0C\u5426\u5219\u5979\u7684\u540E\u4EE3\u5C06\u7EE7\u7EED\u5728\u6218\u573A\u9634\u5F71\u4E2D\u5B55\u80B2\u3002"
  - Name: monster1102_des
    Text: "\u8428\u8BFA\u514B\u65AF\u662F\u4E00\u53F0\u79FB\u52A8\u761F\u75AB\u673A\u5668\u2014\u2014\u5B83\u65E2\u662F\u62FE\u8352\u8005\uFF0C\u53C8\u662F\u7A81\u51FB\u961F\u5458\uFF0C\u6D51\u8EAB\u6563\u53D1\u7740\u6050\u6016\u6C14\u606F\u3002\u5B83\u6D51\u8EAB\u957F\u6EE1\u6709\u6BD2\u7684\u8D58\u751F\u7269\uFF0C\u7531\u6536\u5272\u7684\u7269\u8D28\u7F1D\u5408\u800C\u6210\uFF0C\u5176\u8EAF\u4F53\u5B9E\u65F6\u53D8\u5F02\uFF0C\u80FD\u591F\u9002\u5E94\u635F\u4F24\u5E76\u5411\u6218\u573A\u55B7\u5410\u6C61\u79FD\u3002\u5F17\u96F7\u57FA\u5C14\u4EBA\u5229\u7528\u50CF\u8428\u8BFA\u514B\u65AF\u8FD9\u6837\u7684\u6536\u5272\u8005\u6765\u6E05\u9664\u62B5\u6297\u52BF\u529B\u2014\u2014\u901A\u8FC7\u6D88\u5316\u6216\u8150\u70C2\u7684\u65B9\u5F0F\u3002\u5B83\u7684\u51FA\u73B0\u4E0D\u4EC5\u610F\u5473\u7740\u5165\u4FB5\uFF0C\u66F4\u610F\u5473\u7740\u761F\u75AB\u7684\u8513\u5EF6\u3002\u6467\u6BC1\u5B83\u8FD8\u4E0D\u591F\uFF0C\u4F60\u8FD8\u5FC5\u987B\u711A\u70E7\u5B83\u89E6\u53CA\u8FC7\u7684\u571F\u5730\u3002"
  - Name: monster1103_des
    Text: "\u8F9B\u8428\u91CC\u5B88\u536B\u662F\u5F17\u96F7\u57FA\u5C14\u866B\u7FA4\u7684\u7075\u80FD\u7279\u5DE5\u3002\u5B83\u65E2\u662F\u5BA1\u8BAF\u8005\u53C8\u662F\u523D\u5B50\u624B\uFF0C\u5728\u6467\u6BC1\u730E\u7269\u8089\u4F53\u4E4B\u524D\uFF0C\u4FBF\u5148\u4FB5\u8680\u5176\u5FC3\u667A\u3002\u5B83\u5934\u9876\u7684\u8109\u52A8\u5706\u9876\u65E2\u662F\u866B\u7FA4\u7075\u80FD\u4FE1\u53F7\u7684\u653E\u5927\u5668\uFF0C\u4E5F\u662F\u5176\u4F20\u5BFC\u901A\u9053\uFF0C\u4F7F\u5176\u80FD\u591F\u5728\u6218\u6597\u4E2D\u538B\u5236\u654C\u4EBA\u7684\u6CD5\u672F\u5E76\u6270\u4E71\u5176\u601D\u7EF4\u3002\u8FD9\u79CD\u751F\u7269\u66FE\u4E00\u5EA6\u88AB\u88C2\u9699\u5B66\u8005\u89C6\u4E3A\u4F20\u8BF4\uFF0C\u5982\u4ECA\u5B83\u51FA\u73B0\u5728\u4F20\u9001\u95E8\u524D\uFF0C\u9884\u793A\u7740\u866B\u7FA4\u5373\u5C06\u5347\u7EA7\u884C\u52A8\u3002"
  - Name: monster1104_des
    Text: "\u9ED1\u66DC\u77F3\u6F5C\u884C\u8005\u662F\u5F17\u96F7\u57FA\u5C14\u7684\u7B2C\u4E00\u9053\u9632\u7EBF\u2014\u2014\u6279\u91CF\u751F\u4EA7\u3001\u534A\u667A\u80FD\u4E14\u6BEB\u4E0D\u7559\u60C5\u3002\u8FD9\u79CD\u65E0\u4EBA\u673A\u7531\u9ED1\u66DC\u77F3\u51E0\u4E01\u8D28\u548C\u8109\u51B2\u53CD\u5E94\u808C\u8089\u7EA4\u7EF4\u953B\u9020\u800C\u6210\uFF0C\u5176\u8FD0\u4F5C\u6548\u7387\u4E4B\u9AD8\uFF0C\u4E0E\u5176\u7B80\u5355\u7684\u6784\u9020\u5F62\u6210\u9C9C\u660E\u5BF9\u6BD4\u3002\u867D\u7136\u5728\u540C\u7C7B\u4E2D\u5730\u4F4D\u8F83\u4F4E\uFF0C\u4F46\u5176\u901F\u5EA6\u548C\u6495\u88C2\u62A4\u7532\u7684\u653B\u51FB\u529B\uFF0C\u5BF9\u4E8E\u6BEB\u65E0\u9632\u5907\u7684\u654C\u4EBA\u800C\u8A00\uFF0C\u65E0\u7591\u662F\u4E00\u4E2A\u5371\u9669\u7684\u5BF9\u624B\u3002\u8FD9\u4E9B\u751F\u7269\u901A\u5E38\u5355\u72EC\u884C\u52A8\uFF0C\u8D1F\u8D23\u4FA6\u5BDF\u6216\u5B88\u536B\u5E9F\u5F03\u7684\u57CE\u95E8\uFF0C\u4F46\u4E00\u65E6\u53D7\u5230\u5A01\u80C1\uFF0C\u5B83\u4EEC\u4FBF\u4F1A\u5316\u8EAB\u4E3A\u55DC\u8840\u7684\u523D\u5B50\u624B\u3002"
  - Name: achievement_reward
    Text: "\u6210\u5C31\u5956\u52B1"
  - Name: achievements_title
    Text: "\u6210\u5C31"
  - Name: reward_title
    Text: "\u62A5\u916C"
  - Name: DailyQuest_CompleteAll
    Text: "\u6BCF\u65E5\u5B8C\u6210\u8005"
  - Name: DailyQuest_LogIn
    Text: "\u65B0\u7684\u9ECE\u660E"
  - Name: DailyQuest_Summon
    Text: "\u53EC\u5524\u5E08\u4EEA\u5F0F"
  - Name: DailyQuest_WinBattleMap
    Text: "\u5F81\u670D\u8352\u91CE"
  - Name: DailyQuest_OpenChest
    Text: "\u7B2C\u4E00\u9053\u9501"
  - Name: DailyQuest_CompleteAll_info
    Text: "\u5B8C\u6210\u5F53\u5929\u6240\u6709\u4EFB\u52A1\u5373\u53EF\u5B8C\u6210\u6B64\u4EFB\u52A1\u3002"
  - Name: DailyQuest_LogIn_info
