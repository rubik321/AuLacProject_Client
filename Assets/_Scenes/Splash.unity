    Text: "\u53EA\u9700\u82B1\u8D39<color=#317E1C> {0} </color>\u5373\u53EF\u89E3\u9501\u9EC4\u91D1\u901A\u884C\u8BC1\uFF0C\u9886\u53D6\u4E13\u5C5E\u5956\u52B1\uFF0C\u5E76\u5728\u65C5\u9014\u4E2D\u8D62\u53D6\u7A00\u6709\u5B9D\u85CF\uFF01"
