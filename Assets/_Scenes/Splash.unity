  - Name: skill_passive_name_42
    Text: "Ember b\xE1o th\xF9"
  - Name: skill_passive_detail_42
    Text: "Khi b\u1ECB t\u1EA5n c\xF4ng, c\xF3 {0}% c\u01A1 h\u1ED9i Thi\xEAu \u0111\u1ED1t
