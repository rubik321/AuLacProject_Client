    Text: "\u6392\u884C\u699C"
  - Name: opponent_mess
    Text: "\u4F60\u5DF2\u7ECF\u8D62\u5F97\u4E86\u8FD9\u573A\u6218\u6597\u3002\u8BF7\u9009\u62E9\u5176\u4ED6\u5BF9\u624B\u3002"
  - Name: not_enough_arena_tickets
    Text: "\u4F60\u9700\u8981\u66F4\u591A\u7ADE\u6280\u573A\u95E8\u7968\u624D\u80FD\u5F00\u59CB\u8FD9\u573A\u6218\u6597\u3002"
  - Name: avatar
    Text: "\u963F\u51E1\u8FBE"
  - Name: tut_0_1
    Text: "\u4F60\u5DF2\u82CF\u9192\uFF0C\u540E\u88D4\u3002\u6B22\u8FCE\u56DE\u5230\u76D6\u4E9A\u3002\u6211\u662F\u7C73\u5C14\u514B\u2026\u2026\u4E0D\u518D\u662F\u6614\u65E5\u7684\u6211\uFF0C\u800C\u662F\u4E00\u4E2A\u5E7B\u8C61\uFF0C\u4E00\u58F0\u56DE\u8361\u4E8E\u65F6\u5149\u7684\u4F4E\u8BED\u3002\u6211\u7684\u4F7F\u547D\u662F\u6307\u5F15\u4F60\u2014\u2014\u5E2E\u52A9\u4F60\u91CD\u62FE\u529B\u91CF\uFF0C\u5FC6\u8D77\u4F60\u66FE\u7ECF\u662F\u8C01\u2026\u2026\u4EE5\u53CA\u4F60\u5FC5\u987B\u6210\u4E3A\u4EC0\u4E48\u6837\u7684\u4EBA\u3002"
  - Name: tut_1_1
    Text: "\u4F5C\u4E3A\u4E00\u4EFD\u89C9\u9192\u793C\u7269\uFF0C\u60A8\u7684\u90AE\u7BB1\u91CC\u6709\u4E00\u5C01\u90AE\u4EF6\u7B49\u7740\u60A8\u3002\u70B9\u51FB\u90AE\u4EF6\u56FE\u6807\u6253\u5F00\u6536\u4EF6\u7BB1\uFF0C\u9886\u53D6\u60A8\u7684\u5956\u52B1\u3002"
  - Name: tut_1_2
    Text: "\u8BF7\u6253\u5F00\u60A8\u7684\u4FE1\u606F\u5E76\u9886\u53D6\u5956\u52B1\u3002\u4F60\u5DF2\u7ECF\u8FC8\u51FA\u4E86\u7B2C\u4E00\u6B65\uFF0C\u540E\u88D4\u3002\u5728\u63A5\u4E0B\u6765\u7684\u65C5\u7A0B\u4E2D\uFF0C\u4F60\u9700\u8981\u5229\u7528\u4E00\u5207\u4F18\u52BF\u3002"
  - Name: tut_2_1
    Text: "\u8FD9\u662F\u76D6\u4E9A\u7684\u4E16\u754C\u5730\u56FE\u3002\u5B83\u66FE\u662F\u4E00\u4E2A\u7531\u661F\u754C\u4E4B\u95E8\u7EDF\u4E00\u7684\u9886\u57DF\uFF0C\u5982\u4ECA\u5374\u652F\u79BB\u7834\u788E\uFF0C\u88AB\u4EBA\u9057\u5FD8\u3002\u6563\u843D\u5728\u8FD9\u7247\u571F\u5730\u4E0A\u7684\u662F\u56DE\u54CD\u2014\u2014\u66FE\u7ECF\u4E0E\u50CF\u4F60\u8FD9\u6837\u7684\u5148\u7956\u7F14\u7ED3\u5951\u7EA6\u7684\u5143\u7D20\u751F\u7269\u7684\u6B8B\u9AB8\u3002"
  - Name: tut_2_2
    Text: "\u8FD9\u4E9B\u56DE\u54CD\u5E76\u975E\u6BEB\u65E0\u7406\u667A\u7684\u91CE\u517D\u3002\u5B83\u4EEC\u66FE\u662F\u76DF\u53CB\u3001\u4F19\u4F34\u2026\u2026\u5B88\u62A4\u8005\u3002\u4F46\u5927\u5D29\u574F\u626D\u66F2\u4E86\u5F7C\u6B64\u95F4\u7684\u8054\u7CFB\u3002\u5982\u4ECA\uFF0C\u8BB8\u591A\u56DE\u54CD\u8FF7\u5931\u4E86\u65B9\u5411\uFF0C\u88AB\u5143\u7D20\u6DF7\u6C8C\u541E\u566C\u3002\u73B0\u5728\uFF0C\u4F60\u5FC5\u987B\u6218\u6597\uFF0C\u6536\u96C6\u5B83\u4EEC\u7684\u7CBE\u534E\uFF0C\u7136\u540E\u8BAD\u7EC3\u5B83\u4EEC\uFF0C\u8BA9\u5B83\u4EEC\u518D\u6B21\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002"
  - Name: tut_2_3
    Text: "\u5728\u4E16\u754C\u5730\u56FE\u4E0A\u9009\u62E9\u597D\u6218\u6597\u540E\uFF0C\u4F60\u4F1A\u8FDB\u5165\u6218\u524D\u754C\u9762\u3002\u754C\u9762\u4F1A\u663E\u793A\u4F60\u5373\u5C06\u9762\u5BF9\u7684\u654C\u4EBA\u3001\u5176\u5143\u7D20\u5C5E\u6027\u548C\u5A01\u529B\u3002\u5728\u8FD9\u4E2A\u4E16\u754C\u91CC\uFF0C\u62C2\u6653\u8840\u76DF\u7684\u6210\u5458\u4EEC\u4F9D\u9760\u56DE\u54CD\u7684\u529B\u91CF\u8FDB\u884C\u6218\u6597\u3002\u6218\u6597\u662F\u81EA\u52A8\u8FDB\u884C\u7684\uFF0C\u76F4\u5230\u4F60\u83B7\u80DC\u6216\u5931\u8D25\u4E3A\u6B62\u3002\u6309\u4E0B\u653B\u51FB\u952E\u5373\u53EF\u7EE7\u7EED\u3002"
  - Name: tut_2_4
    Text: "\u51C6\u5907\u597D\u8FCE\u6218\u65F6\uFF0C\u6309\u4E0B\u653B\u51FB\u952E\u3002\u201C\u5728\u8FD9\u4E2A\u4E16\u754C\u91CC\uFF0C\u62C2\u6653\u8840\u76DF\u7684\u6210\u5458\u4EEC\u4F9D\u9760\u56DE\u54CD\u7684\u529B\u91CF\u6218\u6597\u3002\u6218\u6597\u662F\u81EA\u52A8\u8FDB\u884C\u7684\uFF0C\u4F1A\u4E00\u76F4\u6301\u7EED\u5230\u4F60\u83B7\u80DC\u6216\u5931\u8D25\u4E3A\u6B62\u3002\u201D"
  - Name: tut_3_1
    Text: "\u73B0\u5728\uFF0C\u8BA9\u6211\u4EEC\u4E3A\u4F60\u5373\u5C06\u5230\u6765\u7684\u6218\u6597\u505A\u597D\u51C6\u5907\u3002\u70B9\u51FB\u5C4F\u5E55\u5E95\u90E8\u7684\u201C\u82F1\u96C4\u201D\u6309\u94AE\uFF0C\u5373\u53EF\u67E5\u770B\u4F60\u7684\u88C5\u5907\u3002"
  - Name: tut_3_2
    Text: "\u8FD9\u672C\u5178\u7C4D\u8BB0\u5F55\u4E86\u4F60\u6536\u96C6\u7684\u6240\u6709\u88C5\u5907\uFF1A\u76D4\u7532\u3001\u6B66\u5668\u548C\u53E4\u4EE3\u9057\u7269\u3002\u88C5\u5907\u4F60\u7684\u540E\u88D4\u53EF\u4EE5\u589E\u5F3A\u4F60\u7684\u56DE\u54CD\u4F19\u4F34\u7684\u529B\u91CF\u3002"
  - Name: tut_3_3
    Text: "\u70B9\u51FB\u76FE\u724C\u5373\u53EF\u67E5\u770B\u5176\u8BE6\u7EC6\u4FE1\u606F\u3002\u5728\u8FD9\u91CC\uFF0C\u60A8\u53EF\u4EE5\u770B\u5230\u5B83\u4E3A\u60A8\u7684\u540E\u88D4\u63D0\u4F9B\u7684\u5C5E\u6027\u52A0\u6210\uFF0C\u4EE5\u53CA\u5B83\u5982\u4F55\u5728\u6218\u6597\u4E2D\u63D0\u5347\u60A8\u7684\u56DE\u54CD\u6548\u679C\u3002"
  - Name: tut_3_4
    Text: "\u5728\u8FD9\u4E2A\u754C\u9762\uFF0C\u4F60\u53EF\u4EE5\u5347\u7EA7\u8FD9\u4EF6\u88C5\u5907\u6765\u589E\u5F3A\u5B83\u7684\u6548\u679C\u2026\u2026\u6216\u8005\u5982\u679C\u4F60\u4E0D\u518D\u9700\u8981\u5B83\uFF0C\u4E5F\u53EF\u4EE5\u628A\u5B83\u5356\u6389\u3002"
  - Name: tut_3_5
    Text: "\u6BCF\u6B21\u5347\u7EA7\u90FD\u9700\u8981\u88C5\u5907\u77F3\u548C\u91D1\u5E01\u7B49\u8D44\u6E90\u3002\u660E\u667A\u6295\u8D44\u5427\uFF0C\u540E\u88D4\u3002\u4F60\u7684\u56DE\u54CD\u4E4B\u529B\u5F80\u5F80\u53D6\u51B3\u4E8E\u4F60\u6240\u7A7F\u6234\u7684\u76D4\u7532\u3002"
  - Name: tut_4_1
    Text: "\u70B9\u51FB\u5C4F\u5E55\u5E95\u90E8\u7684\u201C\u80CC\u5305\u201D\u6309\u94AE\u6253\u5F00\u80CC\u5305\u3002"
  - Name: tut_4_2
    Text: "\u8FD9\u91CC\u5B58\u653E\u7740\u4F60\u5728\u6218\u6597\u548C\u5192\u9669\u4E2D\u6536\u96C6\u7684\u6240\u6709\u7269\u54C1\uFF0C\u4ECE\u98DF\u7269\u3001\u94A5\u5319\u5230\u73CD\u8D35\u7684\u56DE\u54CD\u788E\u7247\uFF0C\u5E94\u6709\u5C3D\u6709\u3002"
  - Name: tut_4_3
    Text: "\u80CC\u5305\u7A7A\u95F4\u4E0D\u8DB3\uFF1F\u4F60\u53EF\u4EE5\u82B1\u8D39\u5C11\u91CF\u5B9D\u77F3\u6765\u6269\u5BB9\u3002\u505A\u597D\u51C6\u5907\u5427\uFF0C\u540E\u88D4\uFF0C\u5373\u4F7F\u662F\u6700\u5C0F\u7684\u7269\u54C1\u4E5F\u53EF\u80FD\u5DE6\u53F3\u4F60\u7684\u65C5\u7A0B\u547D\u8FD0\u3002"
  - Name: tut_5_1
    Text: "\u6309\u4E0B\u5C4F\u5E55\u5E95\u90E8\u7684\u201C\u6392\u961F\u201D\u6309\u94AE\u3002"
  - Name: tut_5_2
    Text: "\u8FD9\u662F\u4F60\u7684\u56DE\u58F0\u9635\u5BB9\u754C\u9762\u3002\u5728\u8FD9\u91CC\uFF0C\u4F60\u53EF\u4EE5\u6DFB\u52A0\u3001\u79FB\u9664\u6216\u91CD\u65B0\u90E8\u7F72\u4F60\u7684\u56DE\u58F0\uFF0C\u4E3A\u6218\u6597\u505A\u597D\u51C6\u5907\u3002\u5408\u7406\u7684\u9635\u5BB9\u90E8\u7F72\u81F3\u5173\u91CD\u8981\uFF0C\u5B83\u53EF\u4EE5\u626D\u8F6C\u6218\u5C40\u3002"
  - Name: tut_6_1
    Text: "\u4F60\u7684\u76D6\u4E9A\u4E4B\u65C5\u5145\u6EE1\u610F\u4E49\u3002\u70B9\u51FB\u4E0B\u65B9\u201C\u4EFB\u52A1\u201D\u6309\u94AE\uFF0C\u67E5\u770B\u6446\u5728\u4F60\u9762\u524D\u7684\u6311\u6218\u3002"
  - Name: tut_6_2
    Text: "\u5728\u8FD9\u91CC\uFF0C\u60A8\u53EF\u4EE5\u627E\u5230\u6BCF\u65E5\u4EFB\u52A1\u4EE5\u53CA\u957F\u671F\u6311\u6218\u3002\u6BCF\u4E2A\u4EFB\u52A1\u90FD\u4F1A\u5E26\u6765\u5956\u52B1\uFF0C\u4F8B\u5982\u91D1\u5E01\u3001\u5B9D\u77F3\u548C\u5176\u4ED6\u8D44\u6E90\uFF0C\u8FD9\u4E9B\u90FD\u5C06\u5E2E\u52A9\u60A8\u5728\u76D6\u4E9A\u5927\u9646\u7684\u6218\u6597\u4E2D\u53D6\u5F97\u80DC\u5229\u3002"
  - Name: tut_7_1
    Text: "\u70B9\u51FB\u5C4F\u5E55\u5E95\u90E8\u7684\u201C\u602A\u7269\u201D\u6309\u94AE\u3002\u4F60\u7684\u56DE\u58F0\u4F19\u4F34\u4EEC\u4F1A\u5728\u8FD9\u91CC\u7B49\u5F85\u4F60\u7684\u6307\u5F15\u3002"
  - Name: tut_7_2
    Text: "\u5728\u8FD9\u91CC\u60A8\u53EF\u4EE5\u67E5\u770B\u60A8\u7684\u56DE\u58F0\u3002\u9009\u62E9\u4E00\u4E2A\u56DE\u58F0\u8FDB\u884C\u5347\u7EA7\u6216\u8FDB\u5316\u3002\u70B9\u51FB\u201C\u5347\u7EA7\u201D\u6309\u94AE\u7EE7\u7EED\u3002"
  - Name: tut_7_3
    Text: "\u8FD9\u662F\u56DE\u58F0\u7684\u5F3A\u5316\u754C\u9762\u3002\u60A8\u53EF\u4EE5\u9009\u62E9\u63D0\u5347\u56DE\u58F0\u7684\u7B49\u7EA7\u3001\u661F\u7EA7\uFF0C\u751A\u81F3\u8FDB\u5316\u2014\u2014\u5982\u679C\u60A8\u62E5\u6709\u5408\u9002\u7684\u6750\u6599\u3002"
  - Name: tut_8_1
    Text: "\u70B9\u51FB\u201C\u5E02\u573A\u201D\u6309\u94AE\u3002"
  - Name: tut_8_2
    Text: "\u6B22\u8FCE\u6765\u5230\u5E02\u573A\uFF0C\u540E\u88D4\u3002\u5728\u8FD9\u91CC\uFF0C\u60A8\u53EF\u4EE5\u8D2D\u4E70\u5F3A\u5927\u7684\u914D\u4EF6\u6765\u52A9\u60A8\u6218\u6597\uFF0C\u4E5F\u53EF\u4EE5\u8D2D\u4E70\u65F6\u5C1A\u7684\u88C5\u5907\u6765\u6539\u53D8\u60A8\u7684\u5916\u89C2\u3002"
  - Name: tut_8_3
    Text: "\u4F60\u8FD8\u53EF\u4EE5\u5728\u8FD9\u91CC\u83B7\u5F97\u91D1\u5E01\u548C\u5B9D\u77F3\uFF0C\u5B83\u4EEC\u5BF9\u88C5\u5907\u5347\u7EA7\u3001\u8FDB\u5316\u56DE\u54CD\u7B49\u5404\u4E2A\u65B9\u9762\u90FD\u5F88\u6709\u7528\u3002"
  - Name: tut_8_4
    Text: "\u8BF7\u7ECF\u5E38\u56DE\u6765\u770B\u770B\u3002\u4F60\u6C38\u8FDC\u4E0D\u77E5\u9053\u4EC0\u4E48\u65F6\u5019\u4F1A\u51FA\u73B0\u7A00\u6709\u5546\u54C1\u2026\u2026\u6216\u8005\u9650\u65F6\u7279\u4EF7\u2026\u2026"
  - Name: tut_9_1
    Text: "\u6211\u5FC5\u987B\u5411\u4F60\u9053\u522B\u4E86\uFF0C\u52C7\u6562\u7684\u540E\u88D4\u3002\u4F60\u73B0\u5728\u62E5\u6709\u7EE7\u7EED\u4FEE\u884C\u6240\u9700\u7684\u77E5\u8BC6\uFF0C\u53EF\u4EE5\u518D\u6B21\u5D1B\u8D77\uFF0C\u6210\u4E3A\u76D6\u4E9A\u7684\u5B88\u62A4\u8005\u3002\u4E00\u4F4D\u8DB3\u4EE5\u6062\u590D\u5931\u53BB\u7684\u4E00\u5207\u2026\u2026\u5E76\u5B88\u62A4\u6B8B\u5B58\u4E00\u5207\u7684\u540E\u88D4\u3002"
  - Name: tut_9_2
    Text: "\u8BB0\u4F4F\uFF1A\u4F60\u5E76\u4E0D\u5B64\u5355\u3002\u76D6\u4E9A\u5404\u5730\u7684\u4F17\u591A\u8D24\u8005\u5DF2\u7ECF\u89C9\u9192\uFF0C\u4ED6\u4EEC\u968F\u65F6\u51C6\u5907\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u2026\u2026\u6216\u5728\u5371\u96BE\u4E4B\u9645\u5411\u4F60\u6C42\u52A9\u3002\u524D\u8DEF\u5145\u6EE1\u6311\u6218\uFF0C\u4F46\u4E5F\u5FC5\u5C06\u5851\u9020\u4F60\u3002\u73B0\u5728\u5C31\u51FA\u53D1\uFF0C\u5F00\u542F\u4F60\u7684\u4F20\u5947\u5427\u3002"
  - Name: tut_10_1
    Text: "\u4F60\u597D\uFF0C\u540E\u88D4\u3002\u6211\u662F\u5854\u5C14\u91CC\u514B\xB7\u6C83\u6069\u2014\u2014\u7ADE\u6280\u573A\u5927\u5E08\uFF0C\u52C7\u6C14\u5B88\u62A4\u8005\uFF0C\u56DE\u54CD\u8BD5\u70BC\u7684\u5B88\u62A4\u8005\u3002\u770B\u6765\u4F60\u5DF2\u7ECF\u8DB3\u591F\u5F3A\u5927\uFF0C\u53EF\u4EE5\u8FDB\u5165\u7ADE\u6280\u573A\u4E86\u3002"
  - Name: tut_10_2
    Text: "\u7ADE\u6280\u573A\u4E0D\u4EC5\u4EC5\u662F\u68C0\u9A8C\u529B\u91CF\u7684\u5730\u65B9\uFF0C\u66F4\u662F\u7B56\u7565\u4E0E\u5B9E\u529B\u4EA4\u950B\u7684\u6218\u573A\u3002\u4F60\u7684\u56DE\u54CD\u2014\u2014\u4F60\u7684\u9009\u62E9\u2014\u2014\u5C06\u9762\u5BF9\u76D6\u4E9A\u5927\u9646\u4E0A\u6700\u5F3A\u5927\u7684\u5BF9\u624B\u3002\u4F46\u9996\u5148\u2026\u2026\u8BA9\u6211\u4EEC\u8FDB\u53BB\u770B\u770B\u3002"
  - Name: tut_10_3
    Text: "\u6BCF\u5468\uFF0C\u50CF\u4F60\u8FD9\u6837\u7684\u52C7\u58EB\u90FD\u4F1A\u5D1B\u8D77\u548C\u9668\u843D\u3002\u79EF\u5206\u5F97\u4EE5\u8D62\u5F97\uFF0C\u8363\u8000\u5F97\u4EE5\u5F70\u663E\u3002\u800C\u5956\u52B1\uFF1F\u90A3\u53EA\u5C5E\u4E8E\u52C7\u8005\u3002"
  - Name: tut_10_4
    Text: "\u65E2\u7136\u4F60\u5DF2\u7ECF\u6765\u4E86\uFF0C\u6211\u4EEC\u5C31\u6765\u7EC4\u5EFA\u4F60\u7684\u9632\u5FA1\u56E2\u961F\u5427\u3002"
  - Name: tut_10_5
    Text: "\u5728\u8FD9\u91CC\uFF0C\u4F60\u9700\u8981\u6307\u5B9A\u54EA\u4E9B\u540C\u4F34\u5C06\u5728\u7ADE\u6280\u573A\u4E2D\u634D\u536B\u4F60\u7684\u8363\u8A89\u5E76\u4E3A\u4F60\u800C\u6218\u3002"
  - Name: tut_10_6
    Text: "\u56DE\u5230\u4E3B\u7ADE\u6280\u573A\uFF0C\u60A8\u5C06\u770B\u5230\u60A8\u7684\u5BF9\u624B\u3002\u60A8\u53EF\u4EE5\u6BCF
      15 \u5206\u949F\u5237\u65B0\u4E00\u6B21\u5BF9\u624B\u5217\u8868\uFF0C\u6216\u8005\u652F\u4ED8\u5C11\u91CF\u8D39\u7528\u63D0\u524D\u5237\u65B0\u3002"
  - Name: tut_10_7
    Text: "\u5F88\u597D\u5947\u7B49\u7EA7\u3001\u5956\u52B1\u4EE5\u53CA\u664B\u5347\u9700\u8981\u4EC0\u4E48\u6761\u4EF6"
  - Name: tut_10_8
    Text: "\u5982\u679C\u4F60\u60F3\u770B\u770B\u73B0\u5728\u8C01\u79F0\u9738\u7ADE\u6280\u573A\uFF0C\u53EF\u4EE5\u67E5\u770B\u6392\u884C\u699C\u3002"
  - Name: tut_10_9
    Text: "\u6BCF\u5468\u7ED3\u675F\u65F6\uFF0C\u60A8\u7684\u5956\u52B1\u5C06\u6839\u636E\u60A8\u7684\u7B49\u7EA7\u901A\u8FC7\u90AE\u4EF6\u5BC4\u9001\u7ED9\u60A8\u3002"
  - Name: tut_10_10
    Text: "\u6240\u4EE5\uFF0CScion\uFF0C\u884C\u52A8\u8D77\u6765\u5427\u3002\u8BA9\u4ED6\u4EEC\u5F7B\u5E95\u4E86\u89E3\u4F60\u662F\u8C01\u3002"
  - Name: next
    Text: "\u4E0B\u4E00\u4E2A"
  - Name: skip_this_tutorial
    Text: "\u60A8\u60F3\u8DF3\u8FC7\u672C\u6559\u7A0B\u5417\uFF1F"
  - Name: skip_this_tutorial1
    Text: "\u60A8\u60F3\u8DF3\u8FC7\u672C\u6559\u7A0B\u5417\uFF1F"
  - Name: watch_ads_to_claim
    Text: "\u4F60\u60F3\u9886\u53D6\u53CC\u500D\u5956\u52B1\u5417\uFF1F"
  - Name: double_reward
    Text: "\u53CC\u500D\u5956\u52B1"
  - Name: arena_mess_reset
    Text: "\u60A8\u662F\u5426\u613F\u610F\u82B1\u8D39 10 \u4E2A\u5B9D\u77F3\u6765\u5237\u65B0\u60A8\u7684\u7ADE\u6280\u573A\u5BF9\u624B\uFF1F"
  - Name: mail_reward_title
    Text: "\u90AE\u4EF6\u5956\u52B1"
  - Name: title_wc_mail
    Text: "\u6B22\u8FCE\u6765\u5230 Myrk\uFF1A\u88AB\u9057\u5FD8\u8005\u7684\u56DE\u54CD"
  - Name: detail_wc_mail
    Text: "\u81F4\u65B0\u89C9\u9192\u7684\u540E\u88D4\uFF0C\r\n\u7FA4\u661F\u5DF2\u7136\u8FDE\u6210\u4E00\u7EBF\uFF0C\u4F60\u7684\u65C5\u7A0B\u5373\u5C06\u5F00\u542F\u3002\r\n\u6B22\u8FCE\u6765\u5230\u300A\u7C73\u5C14\u514B\uFF1A\u9057\u5FD8\u7684\u56DE\u54CD\u300B\u2014\u2014\u4E00\u4E2A\u5145\u6EE1\u5143\u7D20\u4E4B\u529B\u3001\u53E4\u8001\u9884\u8A00\u548C\u65E0\u6570\u5192\u9669\u7684\u4E16\u754C\u3002\u6211\u4EEC\u8363\u5E78\u5730\u6B22\u8FCE\u4F60\u52A0\u5165\u6211\u4EEC\u4E0D\u65AD\u58EE\u5927\u7684\u540E\u88D4\u6218\u58EB\u961F\u4F0D\u3002\r\n\u4E3A\u4E86\u8868\u8FBE\u6211\u4EEC\u7684\u8C22\u610F\uFF0C\u6211\u4EEC\u5DF2\u5728\u4F60\u7684\u7269\u54C1\u680F\u4E2D\u653E\u7F6E\u4E86\u4E00\u4EFD\u6B22\u8FCE\u793C\u5305\u3002\u793C\u5305\u5185\u542B\u4E13\u5C5E\u7269\u54C1\uFF0C\u52A9\u4F60\u63D0\u5347\u5B9E\u529B\uFF0C\u8FCE\u63A5\u672A\u6765\u7684\u6311\u6218\u3002\r\n\u5982\u679C\u4F60\u9700\u8981\u4EFB\u4F55\u5E2E\u52A9\uFF0C\u6211\u4EEC\u7684\u5BA2\u670D\u56E2\u961F\u968F\u65F6\u5F85\u547D\u3002\u4F60\u53EF\u4EE5\u968F\u65F6\u901A\u8FC7\u6E38\u620F\u5185\u7684\u5E2E\u52A9\u4E2D\u5FC3\u6216\u8BBF\u95EE<color=green><link=https://penguinpixelworks.com>\u6211\u4EEC\u7684\u5BA2\u670D</link></color>\u4E0E\u6211\u4EEC\u8054\u7CFB\u3002\r\n\u4F60\u7684\u4F20\u5947\uFF0C\u4ECE\u6B64\u523B\u5F00\u59CB\u3002\u63A2\u7D22\u9690\u85CF\u7684\u771F\u76F8\uFF0C\u5524\u9192\u5931\u843D\u7684\u529B\u91CF\uFF0C\u5C06\u4F60\u7684\u540D\u5B57\u954C\u523B\u5728\u5386\u53F2\u7684\u56DE\u54CD\u4E4B\u4E2D\u3002\r\n\u4E3A\u4E86\u76D6\u4E9A\u3002\u4E3A\u4E86\u5E73\u8861\u3002\u4E3A\u4E86\u8363\u8000\u3002\r\n\u2014\u2014\u7C73\u5C14\u514B\u56E2\u961F\u2014\u2014"
  - Name: title_portal_mail
    Text: "\u661F\u754C\u4E4B\u95E8\u5DF2\u88AB\u5F81\u670D\uFF01"
  - Name: detail_portal_mail
    Text: "<b>\u5C0A\u656C\u7684\u540E\u88D4\uFF0C</b>\r\n\u5F17\u96F7\u57FA\u5C14#{0}\u5DF2\u9668\u843D\uFF0C\u661F\u754C\u4E4B\u95E8\u5DF2\u88AB\u5C01\u5370\u3002\u611F\u8C22\u60A8\u7684\u52AA\u529B\uFF0C\u60A8\u7684\u529B\u91CF\u5B88\u62A4\u4E86\u6211\u4EEC\u7684\u4E16\u754C\uFF0C\u4F7F\u5176\u514D\u53D7\u5F7C\u5CB8\u6DF7\u6C8C\u7684\u4FB5\u88AD\u3002\r\n\u4E3A\u8868\u8FBE\u6211\u4EEC\u7684\u611F\u6FC0\u4E4B\u60C5\uFF0C\u8BF7\u63A5\u53D7\u8FD9\u4E9B\u5956\u52B1\uFF0C\u4EE5\u8868\u5F70\u60A8\u7684\u52C7\u6C14\u548C\u8D21\u732E\u3002\r\n\u7EE7\u7EED\u6500\u767B\u5427\uFF0C\u56E0\u4E3A\u66F4\u5927\u7684\u6311\u6218\u6B63\u7B49\u5F85\u7740\u60A8\uFF0C\u5728\u6BCF\u4E00\u6247\u661F\u754C\u4E4B\u95E8\u4E4B\u540E\u2026\u2026"
  - Name: text_mail_delete_all
    Text: "\u5220\u9664\u6240\u6709\u90AE\u4EF6"
  - Name: text_mail_delete_all_content
    Text: "\u60A8\u786E\u5B9A\u8981\u5220\u9664\u6240\u6709\u90AE\u4EF6\u5417\uFF1F"
  - Name: arena_reward_title
    Text: "\u7ADE\u6280\u573A - \u82F1\u52C7\u6218\u5229\u54C1"
  - Name: arena_reward_detail
    Text: "\u52C7\u58EB\u554A\uFF0C\u7ADE\u6280\u573A\u4E2D\u94A2\u94C1\u78B0\u649E\u7684\u8F70\u9E23\u58F0\u5DF2\u954C\u523B\u5728\u6218\u4E89\u53F2\u518C\u4E0A\u3002\u51ED\u501F\u4F60\u7684\u7B49\u7EA7\u548C\u82F1\u52C7\uFF0C\u6218\u795E\u8D50\u4E88\u4F60\u8FD9\u4E9B\u5956\u8D4F\u3002\u613F\u4ED6\u4EEC\u7684\u529B\u91CF\u6307\u5F15\u4F60\u8D70\u5411\u66F4\u52A0\u8F89\u714C\u7684\u672A\u6765\uFF01"
  - Name: arena_title
    Text: "\u7ADE\u6280\u573A"
  - Name: crystal_gate_event_title
    Text: "<sprite name=icon_snowflake>\u6C34\u6676\u95E8<sprite name=icon_snowflake>"
  - Name: crystal_gate_event_detail
    Text: "<b>\u76D6\u4E9A\u7684\u51B0\u971C\u4E4B\u4E0B\uFF0C\u53E4\u8001\u7684\u529B\u91CF\u6B63\u5728\u8822\u8822\u6B32\u52A8\u2026\u2026</b>\u6570\u4E2A\u4E16\u7EAA\u524D\uFF0C\u4E3A\u4E86\u5C01\u5370\u9ED1\u6697\u5143\u7D20\uFF0C\u6700\u5927\u7684\u661F\u754C\u4E4B\u95E8\u88AB\u6467\u6BC1\u3002\r\n\u5B83\u7684\u788E\u7247\u6563\u843D\u5728\u76D6\u4E9A\u5404\u5730\uFF0C\u65E9\u5DF2\u88AB\u63A9\u57CB\u3001\u88AB\u9057\u5FD8\u2026\u2026\u5E76\u6E6E\u6CA1\u5728\u795E\u8BDD\u4E4B\u4E2D\u3002\r\n\u4F46\u5173\u4E8E\u6C34\u6676\u788E\u7247<sprite
      name=gate_crystal>\u518D\u6B21\u88AB\u53D1\u73B0\u7684\u4F20\u95FB\u6B63\u5728\u56DB\u9762\u516B\u65B9\u6D41\u4F20\u3002\r\n\u5B83\u4EEC\u53EC\u5524\u7740\u8FDC\u8FD1\u7684\u8D24\u8005\u524D\u6765\u5BFB\u89C5\u3002\r\n\u4E16\u754C\u6B63\u5728\u51C6\u5907\u2014\u2014\u51C6\u5907\u8FCE\u63A5\u4EC0\u4E48\uFF0C\u65E0\u4EBA\u77E5\u6653\u3002\r\n<sprite
      name=icon_snowflake>\u6C34\u6676\u4E4B\u95E8\u6D3B\u52A8\u5373\u5C06\u5F00\u542F\u3002<b>12\u6708{0}
      - 1\u6708{1}</b>"
  - Name: btn_remove_ads
    Text: "\u79FB\u9664\u5E7F\u544A"
  - Name: title_remove_ads
    Text: "\u79FB\u9664\u5E7F\u544A"
  - Name: des_remove_ads
    Text: "\u5F00\u542F\u4E00\u6BB5\u4E0D\u95F4\u65AD\u7684\u5192\u9669\u4E4B\u65C5\uFF01\u79FB\u9664\u6240\u6709\u5E7F\u544A\uFF0C\u4EAB\u53D7\u66F4\u6D41\u7545\u7684\u6218\u6597\u3001\u66F4\u5FEB\u7684\u8FDB\u5EA6\u548C\u6C89\u6D78\u5F0F\u7684\u65C5\u7A0B\uFF0C\u514D\u53D7\u5E72\u6270\u3002"
  - Name: battle_1_1_1
    Text: "\u4EE5\u5143\u7D20\u4E4B\u540D\u2026\u2026\u4F60\u9192\u4E86\uFF01\u7E41\u661F\u70B9\u70B9\uFF0C\u6211\u4ECE\u672A\u60F3\u8FC7\u4F1A\u6709\u4ECA\u5929\uFF01\u80FD\u591F\u4EB2\u773C\u89C1\u5230\u4E00\u4F4D\u5723\u88D4\uFF0C\u4E00\u4F4D\u9884\u8A00\u4E2D\u7684\u5B58\u5728\uFF01"
  - Name: battle_1_1_2
    Text: "\u6211\u662F\u7D22\u7433\uFF0C\u54E8\u5175\u7684\u540E\u88D4\uFF0C\u66FE\u6548\u529B\u4E8E\u661F\u754C\u8054\u76DF\uFF0C\u76F4\u5230\u5927\u5D29\u584C\u5C06\u4E00\u5207\u6467\u6BC1\u3002\u5982\u4ECA\u8054\u76DF\u5DF2\u5316\u4E3A\u5C18\u57C3\uFF0C\u88AB\u4E16\u4EBA\u9057\u5FD8\u3002\u4F46\u6211\u59CB\u7EC8\u65E0\u6CD5\u91CA\u6000\u3002\u4F60\u53EF\u4EE5\u79F0\u4E4B\u4E3A\u6267\u5FF5\u2026\u2026\u67D0\u79CD\u66F4\u6DF1\u5C42\u6B21\u7684\u4E1C\u897F\u9A71\u4F7F\u7740\u6211\u3002\u4E00\u79CD\u5728\u6211\u8840\u6DB2\u4E2D\u4F4E\u8BED\u7684\u6307\u5F15\uFF0C\u5F15\u9886\u6211\u627E\u5230\u4F60\u3002\u800C\u73B0\u5728\uFF0C\u65B0\u7684\u5A01\u80C1\u6B63\u5728\u94F6\u6CB3\u7CFB\u8FB9\u7F18\u4E4B\u5916\u5D1B\u8D77\uFF0C\u6211\u62C5\u5FC3\u6CA1\u6709\u4F60\uFF0C\u76D6\u4E9A\u5C06\u65E0\u6CD5\u5B58\u7EED\u3002"
  - Name: battle_1_1_3
    Text: "\u901A\u8FC7\u6211\u7684\u7814\u7A76\uFF0C\u6211\u53D1\u73B0\u4E86\u5173\u4E8E\u5148\u77E5\u7C73\u5C14\u514B\u7684\u8BB0\u8F7D\u3002\u8FD9\u4E9B\u8BB0\u8F7D\u8BA9\u6211\u770B\u5230\u4E86\u9690\u85CF\u7684\u795E\u5E99\uFF0C\u5B83\u6DF1\u57CB\u4E8E\u4E16\u754C\u4E4B\u4E0B\uFF0C\u81EA\u4E16\u754C\u5206\u88C2\u4EE5\u6765\u4FBF\u65E0\u4EBA\u89E6\u53CA\u3002\u5982\u679C\u4F20\u8BF4\u5C5E\u5B9E\uFF0C\u5B83\u6216\u8BB8\u662F\u5B88\u62A4\u76D6\u4E9A\u7684\u6700\u540E\u5E0C\u671B\u3002\u4F46\u9996\u5148\u2026\u2026\u6211\u4EEC\u5FC5\u987B\u79BB\u5F00\u8FD9\u7247\u5E9F\u589F\u3002\u524D\u8DEF\u5D0E\u5C96\uFF0C\u800C\u6C38\u6052\u4E4B\u5883\u7684\u4EA1\u7075\u4E5F\u5E76\u975E\u90FD\u7518\u613F\u6C89\u7761\u3002"
  - Name: battle_1_5_1
    Text: "\u90A3\u662F\u4E00\u573A\u60B2\u5267\u2026\u2026\u5927\u5D29\u584C\u4E4B\u540E\u53D1\u751F\u7684\u4E00\u5207\u3002\u76D6\u4E9A\u4E0E\u661F\u8FB0\u7684\u5206\u79BB\u5E76\u975E\u9057\u5F03\uFF0C\u800C\u662F\u4E00\u79CD\u727A\u7272\u3002\u90A3\u4E9B\u5E78\u5B58\u4E0B\u6765\u7684\u4EBA\u505A\u51FA\u4E86\u4E00\u4E2A\u4E0D\u53EF\u80FD\u7684\u9009\u62E9\uFF1A\u5207\u65AD\u5B87\u5B99\u7684\u7EBD\u5E26\uFF0C\u4EE5\u963B\u6B62\u865A\u7A7A\u7684\u63A8\u8FDB\u3002\u800C\u8FD9\u786E\u5B9E\u594F\u6548\u4E86\u2026\u2026\u81F3\u5C11\u5728\u4E00\u6BB5\u65F6\u95F4\u5185\u662F\u8FD9\u6837\u3002"
  - Name: battle_1_5_2
    Text: "\u4F46\u4EE3\u4EF7\u60E8\u91CD\u3002\u6574\u4E2A\u4E16\u754C\u9EEF\u7136\u5931\u8272\u3002\u661F\u754C\u8054\u76DF\u5206\u5D29\u79BB\u6790\u3002\u800C\u5728\u76D6\u4E9A\uFF0C\u66FE\u7ECF\u53D7\u4EBA\u656C\u4EF0\u3001\u878D\u5165\u65E5\u5E38\u751F\u6D3B\u7684\u5143\u7D20\uFF0C\u5982\u4ECA\u5374\u6210\u4E86\u6050\u60E7\u7684\u8C61\u5F81\u3002\u5B83\u4EEC\u7684\u4F7F\u7528\u5728\u6574\u4E2A\u94F6\u6CB3\u7CFB\u90FD\u88AB\u7981\u6B62\uFF0C\u88AB\u6CD5\u4EE4\u63A9\u76D6\uFF0C\u88AB\u6C89\u9ED8\u6240\u7B3C\u7F69\u3002\u4ED6\u4EEC\u5BB3\u6015\u865A\u7A7A\u4F1A\u518D\u6B21\u542C\u5230\u4ED6\u4EEC\u7684\u547C\u5524\u2026\u2026\u5E76\u524D\u6765\u53EC\u5524\u3002"
  - Name: battle_1_5_3
    Text: "\u5386\u53F2\u5C31\u8BB2\u5230\u8FD9\u91CC\u5427\u3002\u6211\u4EEC\u8D76\u7D27\u79BB\u5F00\u8FD9\u4E9B\u5E9F\u589F\uFF0C\u5B83\u4EEC\u65F6\u523B\u63D0\u9192\u7740\u6211\u4EEC\u66FE\u7ECF\u5931\u53BB\u7684\u4E00\u5207\u3002"
  - Name: battle_1_10_1
    Text: "\u6211\u8BFB\u8FC7\u5927\u5D29\u584C\u4E4B\u524D\u7684\u53E4\u8001\u8BB0\u5F55\uFF0C\u6C38\u6052\u4E4B\u57CE\u5E76\u975E\u53EA\u6709\u77F3\u5934\u548C\u5BC2\u9759\u3002\u5B83\u662F\u4E00\u5EA7\u706F\u5854\u3002\u6765\u81EA\u94F6\u6CB3\u7CFB\u5404\u5730\u7684\u5B66\u8005\u90FD\u66FE\u6765\u5230\u8FD9\u91CC\u7CBE\u901A\u5143\u7D20\u9B54\u6CD5\uFF0C\u8BB8\u591A\u6700\u4F1F\u5927\u7684\u54E8\u5175\u4E5F\u66FE\u5728\u6B64\u63A5\u53D7\u8BAD\u7EC3\u3002\u5176\u4E2D\u4E00\u4F4D\u2026\u2026\u6216\u8BB8\u5C31\u662F\u6211\u7684\u66FE\u66FE\u7956\u6BCD\u3002\u76D6\u4E9A\u5206\u88C2\u65F6\uFF0C\u5979\u8EAB\u5904\u5916\u661F\u3002\u5426\u5219\u2026\u2026\u6211\u6216\u8BB8\u6839\u672C\u4E0D\u4F1A\u51FA\u751F\u3002"
  - Name: battle_1_10_2
    Text: "\u884C\u8D70\u5728\u66FE\u7ECF\u751F\u673A\u52C3\u52C3\u4E4B\u5730\u5982\u4ECA\u7684\u7070\u70EC\u4E4B\u4E2D\uFF0C\u611F\u89C9\u5341\u5206\u602A\u5F02\u3002\u4F46\u6211\u4EEC\u5373\u5C06\u62B5\u8FBE\u7EC8\u70B9\u3002\u5728\u6211\u4EEC\u4E0E\u5E7F\u88A4\u8352\u91CE\u4E4B\u95F4\uFF0C\u8FD8\u6709\u4E00\u573A\u6700\u540E\u7684\u6218\u6597\u3002\u8FD9\u573A\u6218\u6597\u611F\u89C9\u622A\u7136\u4E0D\u540C\u2026\u2026\u66F4\u52A0\u731B\u70C8\uFF0C\u66F4\u52A0\u9ED1\u6697\u3002\u5E0C\u671B\u4F60\u5DF2\u505A\u597D\u51C6\u5907\uFF0C\u540E\u88D4\u3002\u76D6\u4E9A\u5728\u6CE8\u89C6\u7740\u4F60\u3002"
  - Name: battle_2_1_1
    Text: "\u4F60\u770B\u5230\u4E86\u5417\uFF1F\u90A3\u4E9B\u6811\u6839\u2026\u2026\u5B83\u4EEC\u81EA\u5DF1\u52A8\u4E86\u3002\u8FD9\u5730\u65B9\u80AF\u5B9A\u95F9\u9B3C\u3002"
  - Name: battle_2_1_2
    Text: "\u6839\u636E\u7C73\u5C14\u514B\u7684\u4E00\u4EFD\u53E4\u8001\u6587\u732E\u8BB0\u8F7D\uFF0C\u4F4E\u8BED\u6797\u66FE\u662F\u4E00\u5904\u5723\u5730\u3002\u90A3\u662F\u4E00\u7247\u795E\u5723\u7684\u6811\u6797\uFF0C\u5FB7\u9C81\u4F0A\u4EEC\u5728\u6B64\u4E0E\u5143\u7D20\u7CBE\u7075\u6C9F\u901A\uFF0C\u6574\u4E2A\u4E16\u754C\u4E5F\u56E0\u6B64\u548C\u8C10\u5730\u751F\u673A\u52C3\u52C3\u3002\u4F46\u5982\u4ECA\u5462\uFF1F\u4E00\u5207\u90FD\u626D\u66F2\u4E86\u3002\u6811\u6728\u53D1\u51FA\u547B\u541F\uFF0C\u8FF7\u96FE\u65E0\u6CD5\u6D88\u6563\uFF0C\u6211\u53D1\u8A93\uFF0C\u82D4\u85D3\u4F1A\u5728\u6211\u4EEC\u5165\u7761\u65F6\u6CE8\u89C6\u7740\u6211\u4EEC\u3002"
  - Name: battle_2_1_3
    Text: "\u6211\u4E0D\u559C\u6B22\u8FD9\u91CC\u3002\u6211\u4EEC\u5FEB\u70B9\u79BB\u5F00\u5427\u3002\u8FD9\u7247\u68EE\u6797\u4F1A\u8BB0\u4F4F\u5F88\u591A\u4E8B\u2026\u2026\u800C\u4E14\u5E76\u975E\u6240\u6709\u8BB0\u5FC6\u90FD\u662F\u7F8E\u597D\u7684\u3002"
  - Name: battle_2_5_1
    Text: "\u81EA\u5D29\u584C\u4EE5\u6765\uFF0C\u5143\u7D20\u4E4B\u95E8\u88AB\u5C01\u5370\uFF0C\u865A\u7A7A\u6700\u7EC8\u6D88\u6563\uFF0C\u661F\u754C\u8054\u76DF\u7684\u6B8B\u4F59\u4E5F\u968F\u4E4B\u74E6\u89E3\u3002\u5931\u53BB\u4E86\u5143\u7D20\u4E4B\u529B\uFF0C\u4F1F\u5927\u7684\u6587\u660E\u5931\u53BB\u4E86\u7EF4\u7CFB\u5F7C\u6B64\u7684\u529B\u91CF\u3002\u5927\u591A\u6570\u6587\u660E\u6C89\u5BC2\u4E0B\u6765\uFF0C\u6563\u843D\u4E8E\u661F\u8FB0\u4E4B\u95F4\u3002"
  - Name: battle_2_5_2
    Text: "\u4F46\u6709\u4E9B\u4EBA\u2026\u2026\u4E0D\u613F\u653E\u5F03\u3002\u5C11\u6570\u54E8\u5175\uFF0C\u5305\u62EC\u6211\u7684\u7956\u5148\u5728\u5185\uFF0C\u9690\u533F\u4E86\u8D77\u6765\u3002\u4ED6\u4EEC\u5B88\u62A4\u7740\u53E4\u8001\u7684\u6280\u827A\uFF0C\u5728\u94F6\u6CB3\u7CFB\u88AB\u4EBA\u9057\u5FD8\u7684\u89D2\u843D\u91CC\u79D8\u5BC6\u4FEE\u70BC\u5143\u7D20\u9B54\u6CD5\uFF0C\u5E0C\u671B\u80FD\u4FDD\u5B58\u90A3\u4E9B\u4EE4\u4E16\u4EBA\u754F\u60E7\u7684\u77E5\u8BC6\u3002\u4F46\u5373\u4FBF\u5982\u6B64\uFF0C\u4E5F\u53D8\u5F97\u5371\u673A\u56DB\u4F0F\u3002"
  - Name: battle_2_5_3
    Text: "\u51E0\u4E2A\u4E16\u7EAA\u4EE5\u6765\uFF0C\u6050\u60E7\u5316\u4F5C\u4EC7\u6068\u3002\u54E8\u5175\u906D\u5230\u8FFD\u6355\uFF0C\u88AB\u6307\u8D23\u4E3A\u5D29\u584C\u7684\u7F6A\u9B41\u7978\u9996\uFF0C\u88AB\u63A7\u544A\u5F15\u8BF1\u865A\u7A7A\u56DE\u5F52\u3002\u5728\u6211\u51FA\u751F\u4E4B\u65F6\uFF0C\u6211\u4EEC\u65CF\u7FA4\u51E0\u4E4E\u706D\u7EDD\uFF0C\u53EA\u5269\u4E0B\u96F6\u661F\u7684\u4F20\u95FB\u3002\u7136\u800C\u2026\u2026\u6211\u4EEC\u4F9D\u7136\u5B58\u5728\u3002\u6216\u8BB8\uFF0C\u5143\u7D20\u4E4B\u529B\u7EC8\u7A76\u6CA1\u6709\u629B\u5F03\u6211\u4EEC\u3002"
  - Name: battle_2_10_1
    Text: "\u4F60\u542C\u5230\u4E86\u5417\uFF1F\u4F4E\u6C89\u7684\u2026\u2026\u5589\u97F3\u3002\u5C31\u50CF\u6811\u6728\u5728\u547C\u5438\u4E00\u6837\u3002"
  - Name: battle_2_10_2
    Text: "\u6211\u8BFB\u8FC7\u4E00\u4E9B\u5173\u4E8E\u6B64\u5730\u751F\u7269\u7684\u4F20\u95FB\u3002\u53E4\u8001\u7684\u8B66\u544A\u8BB0\u8F7D\u5728\u54E8\u5175\u5377\u8F74\u4E2D\u3002\u5176\u4E2D\u6709\u4E00\u79CD\u751F\u7269\u5C24\u5176\u4EE4\u4EBA\u95FB\u98CE\u4E27\u80C6\u2026\u2026\u4ED6\u4EEC\u79F0\u4E4B\u4E3A\u8346\u68D8\u4E4B\u989A\u3002\u4E00\u79CD\u88AB\u5143\u7D20\u8150\u5316\u626D\u66F2\u7684\u91CE\u517D\u3002\u6811\u76AE\u5316\u4F5C\u76D4\u7532\uFF0C\u8346\u68D8\u5316\u4F5C\u957F\u77DB\uFF0C\u55DC\u98DF\u4E00\u5207\u547C\u5438\u4E4B\u7269\u3002\u6B64\u524D\u4ECE\u672A\u6709\u4EBA\u5E26\u56DE\u8FC7\u6E05\u6670\u7684\u8BB0\u5F55\uFF0C\u53EA\u6709\u6B8B\u7834\u7684\u65E5\u8BB0\u548C\u7834\u788E\u7684\u9057\u7269\u3002"
  - Name: battle_2_10_3
    Text: "\u65E0\u8BBA\u524D\u65B9\u7B49\u5F85\u7740\u6211\u4EEC\u7684\u662F\u4EC0\u4E48\uFF0C\u5B83\u90FD\u4E0D\u4F1A\u8BA9\u6211\u4EEC\u8F7B\u6613\u79BB\u5F00\u3002\u4FDD\u6301\u8B66\u60D5\uFF0C\u540E\u88D4\u3002\u8FD9\u7247\u68EE\u6797\u6216\u8BB8\u66FE\u7ECF\u662F\u5E87\u62A4\u6240\uFF0C\u4F46\u5982\u4ECA\u66F4\u50CF\u662F\u4E00\u573A\u8003\u9A8C\u3002"
  - Name: battle_3_1_1
    Text: "\u4F60\u542C\u5230\u4E86\u5417\uFF1F\u90A3\u56DE\u58F0\u2026\u2026\u542C\u8D77\u6765\u5F88\u4E0D\u81EA\u7136\u3002\u4EFF\u4F5B\u8FC7\u53BB\u672C\u8EAB\u6B63\u900F\u8FC7\u77F3\u5934\u4F4E\u8BED\u3002\u8FD9\u4E9B\u6D1E\u7A74\u91CC\u4E0D\u4EC5\u4EC5\u53EA\u6709\u5BC2\u9759\u3002"
  - Name: battle_3_1_2
    Text: "\u201C\u56DE\u54CD\u201D\u4E00\u8BCD\u8BA9\u6211\u8054\u60F3\u5230\u5143\u7D20\u3002\u5B83\u4EEC\u66FE\u7ECF\u751F\u673A\u52C3\u52C3\uFF0C\u5145\u6EE1\u6D3B\u529B\uFF0C\u5982\u4ECA\u5374\u53EA\u5269\u4E0B\u6B8B\u9AB8\uFF0C\u6614\u65E5\u8363\u5149\u7684\u5F71\u5B50\u3002\u4F46\u4F60\uFF0C\u76D6\u4E9A\u4E4B\u5B50\u2026\u2026\u4F60\u4E0D\u540C\u3002\u5373\u4F7F\u6C89\u7761\u4E86\u6570\u4E2A\u4E16\u7EAA\uFF0C\u4F60\u4E0E\u5143\u7D20\u7684\u8054\u7CFB\u4E5F\u4E1D\u6BEB\u672A\u51CF\u3002"
  - Name: battle_3_1_3
    Text: "\u5B83\u4EEC\u4F9D\u7136\u4F1A\u56DE\u5E94\u4F60\u7684\u53EC\u5524\u3002\u8FD9\u4E9B\u706B\u7130\u3001\u72C2\u98CE\u548C\u5CA9\u77F3\u7684\u5316\u8EAB\u4F1A\u805A\u96C6\u5728\u4F60\u8EAB\u8FB9\u3002\u8FD9\u8BA9\u6211\u770B\u5230\u4E86\u5E0C\u671B\u3002\u5982\u679C\u8FC7\u53BB\u7684\u56DE\u54CD\u4F9D\u7136\u8574\u542B\u529B\u91CF\u2026\u2026\u6216\u8BB8\u672A\u6765\u8FD8\u672A\u6D88\u901D\u3002"
  - Name: battle_3_5_1
    Text: "\u4F60\u770B\u5230\u4E86\u5417\uFF1F\u5C31\u5728\u90A3\u4E00\u77AC\u95F4\u2026\u2026\u6211\u53D1\u8A93\u6211\u770B\u5230\u4E86\u3002\u5148\u7956\u3002\u56DE\u54CD\u3002\u5143\u7D20\u4E4B\u529B\u5982\u6CE2\u6D9B\u822C\u6D8C\u52A8\u4E8E\u9ED1\u6697\u4E4B\u4E2D\u3002\u4ED6\u4EEC\u6B63\u4E0E\u865A\u7A7A\u602A\u7269\u6FC0\u6218\u3002\u90A3\u4E0D\u4EC5\u4EC5\u662F\u58F0\u97F3\u5728\u77F3\u5934\u95F4\u56DE\u8361\u3002\u90A3\u662F\u4E00\u5E45\u666F\u8C61\u2026\u2026\u4E00\u6BB5\u8BB0\u5FC6\u3002"
  - Name: battle_3_5_2
    Text: "\u5BF9\u4F60\u6765\u8BF4\uFF0C\u8FD9\u4E00\u5B9A\u4F3C\u66FE\u76F8\u8BC6\u3002\u524D\u4E16\u7684\u8BB0\u5FC6\u6D6E\u73B0\u773C\u524D\u3002\u4F60\u5F53\u65F6\u5C31\u5728\u90A3\u91CC\uFF0C\u5BF9\u5417\uFF1F\u4F60\u4E0D\u4EC5\u662F\u89C1\u8BC1\u8005\uFF0C\u66F4\u662F\u4E00\u540D\u6218\u58EB\u3002\u4F60\u66FE\u53C2\u4E0E\u8FC7\u90A3\u4E9B\u53E4\u8001\u7684\u6218\u5F79\uFF0C\u4E0D\u662F\u5417\uFF1F"
  - Name: battle_3_5_3
    Text: "\u6211\u53EA\u77E5\u9053\u4E00\u4E9B\u96F6\u788E\u7684\u6545\u4E8B\uFF0C\u662F\u4ECE\u5B88\u536B\u8005\u53E3\u4E2D\u6D41\u4F20\u4E0B\u6765\u7684\uFF0C\u4ED6\u4EEC\u5BF9\u8FC7\u53BB\u7684\u5386\u53F2\u4E5F\u77E5\u4E4B\u751A\u5C11\u3002\u4F46\u4EB2\u773C\u6240\u89C1\uFF0C\u54EA\u6015\u53EA\u662F\u4E00\u77AC\u95F4\u2026\u2026\u4E5F\u50CF\u662F\u5728\u770B\u7740\u5386\u53F2\u547C\u5438\u3002\u8FD9\u4E9B\u6D1E\u7A74\u5E76\u975E\u7A7A\u65E0\u4E00\u7269\u3002\u5B83\u4EEC\u94ED\u8BB0\u7740\u5F80\u4E8B\u3002"
  - Name: battle_3_10_1
    Text: "\u5728\u5148\u77E5\u7C73\u5C14\u514B\u6700\u53E4\u8001\u7684\u5377\u8F74\u4E4B\u4E00\u4E2D\uFF0C\u6709\u4E00\u6BB5\u6587\u5B57\uFF0C\u867D\u7136\u5B57\u8FF9\u6A21\u7CCA\u4E0D\u6E05\uFF0C\u5374\u63CF\u8FF0\u4E86\u4E00\u5EA7\u57CB\u85CF\u5728\u76D6\u4E9A\u5730\u5E95\u6DF1\u5904\u7684\u5723\u6BBF\u3002\u5927\u591A\u6570\u4EBA\u8BA4\u4E3A\u8FD9\u53EA\u662F\u6BD4\u55BB\uFF0C\u6216\u662F\u795E\u79D8\u4E3B\u4E49\u8005\u7684\u80E1\u8A00\u4E71\u8BED\u3002\u4F46\u8FD9\u4E9B\u6D1E\u7A74\u2026\u2026\u5B83\u4EEC\u4E0E\u5377\u8F74\u4E2D\u7684\u63CF\u8FF0\u5B8C\u5168\u543B\u5408\u3002\u5E03\u5C40\u3001\u5143\u7D20\u7279\u5F81\u2026\u2026\u7C73\u5C14\u514B\u795E\u6BBF\u6216\u8BB8\u771F\u7684\u5B58\u5728\uFF0C\u800C\u6211\u4EEC\u53EF\u80FD\u6B63\u5728\u9010\u6E10\u63A5\u8FD1\u5B83\u3002"
  - Name: battle_3_10_2
    Text: "\u4F46\u9996\u5148\uFF0C\u6211\u4EEC\u5FC5\u987B\u7A81\u7834\u5B88\u536B\u8FD9\u6700\u7EC8\u5BC6\u5BA4\u7684\u91CD\u91CD\u963B\u788D\u3002\u6211\u80FD\u611F\u89C9\u5230\uFF0C\u538B\u529B\uFF0C\u66B4\u98CE\u96E8\u524D\u7684\u5BC2\u9759\u3002\u8FD9\u573A\u6218\u6597\u5C06\u4E0E\u4EE5\u5F80\u622A\u7136\u4E0D\u540C\u3002\u5982\u679C\u6211\u4EEC\u80FD\u6D3B\u4E0B\u6765\uFF0C\u5723\u88D4\u4E4B\u8DEF\u5C31\u5728\u524D\u65B9\u7B49\u5F85\u7740\u6211\u4EEC\u3002"
  - Name: battle_4_1_1
    Text: "\u6211\u66FE\u8BFB\u5230\uFF0C\u8FD9\u6761\u5C71\u9698\u66FE\u662F\u8BD5\u70BC\u573A\u3002\u90A3\u4E9B\u6E34\u671B\u6210\u4E3A\u5723\u88D4\u7684\u4EBA\u5FC5\u987B\u72EC\u81EA\u8DCB\u6D89\uFF0C\u9762\u5BF9\u65E8\u5728\u8003\u9A8C\u4ED6\u4EEC\u529B\u91CF\u3001\u667A\u6167\u548C\u610F\u5FD7\u7684\u79CD\u79CD\u8BD5\u70BC\u3002\u53EA\u6709\u6781\u5C11\u6570\u4EBA\u80FD\u5B8C\u6210\u6311\u6218\uFF0C\u800C\u80FD\u591F\u6BEB\u53D1\u65E0\u635F\u5730\u6D3B\u7740\u56DE\u6765\u7684\u66F4\u662F\u5BE5\u5BE5\u65E0\u51E0\u3002"
  - Name: battle_4_1_2
    Text: "\u73B0\u5728\u8F6E\u5230\u4F60\u4E86\uFF0C\u867D\u7136\u4F60\u4E0D\u518D\u662F\u5B66\u751F\u4E86\u3002\u8FD9\u6761\u9053\u8DEF\u5E76\u672A\u5FD8\u8BB0\u5B83\u7684\u8981\u6C42\u3002\u8BA9\u6211\u4EEC\u770B\u770B\u4F60\u4E0E\u5143\u7D20\u56DE\u54CD\u7684\u8054\u7CFB\u53D1\u5C55\u5230\u4E86\u4EC0\u4E48\u7A0B\u5EA6\u3002\u8FD9\u6BB5\u65C5\u7A0B\u4E0D\u4EC5\u4F1A\u5851\u9020\u4E16\u754C\u2026\u2026\u5B83\u8FD8\u4F1A\u5851\u9020\u4F60\u3002"
  - Name: battle_4_5_1
    Text: "\u6211\u4E00\u76F4\u597D\u5947\uFF0C\u62C2\u6653\u8840\u76DF\u7684\u6210\u5458\u4EEC\u8D70\u4E0A\u8FD9\u6761\u9053\u8DEF\u65F6\uFF0C\u5185\u5FC3\u7A76\u7ADF\u4F5C\u4F55\u611F\u60F3\u3002\u6709\u4EBA\u8BF4\uFF0C\u72C2\u98CE\u9AA4\u8D77\uFF0C\u66B4\u98CE\u96E8\u8086\u8650\uFF0C\u4EFF\u4F5B\u76D6\u4E9A\u5973\u795E\u4EB2\u81EA\u5728\u8003\u9A8C\u4ED6\u4EEC\u7684\u51B3\u5FC3\u3002\u53F2\u518C\u8BB0\u8F7D\uFF0C\u62C2\u6653\u8840\u76DF\u7684\u6210\u5458\u4EEC\u6709\u7684\u88AB\u903C\u75AF\uFF0C\u6709\u7684\u88AB\u5E7B\u8C61\u51FB\u57AE\uFF0C\u6709\u7684\u751A\u81F3\u88AB\u81EA\u8EAB\u7684\u6050\u60E7\u538B\u57AE\u3002\u8FD9\u6761\u9053\u8DEF\u4E0D\u4EC5\u8003\u9A8C\u4F60\u7684\u529B\u91CF\uFF0C\u66F4\u4F1A\u5F7B\u5E95\u5256\u6790\u4F60\u7684\u7075\u9B42\u3002"
  - Name: battle_4_5_2
    Text: "\u5728\u5BFB\u627E\u76D6\u4E9A\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u6211\u5076\u7136\u53D1\u73B0\u4E86\u4E00\u5EA7\u57CB\u85CF\u5728\u5E9F\u5F03\u536B\u661F\u6DF1\u5904\u7684\u53E4\u8001\u5B9D\u5E93\u3002\u5728\u5B9D\u5E93\u91CC\uFF0C\u6211\u627E\u5230\u4E86\u4E00\u5F20\u661F\u56FE\uFF0C\u4E0A\u9762\u523B\u7740\u65E9\u5DF2\u4ECE\u5DF2\u77E5\u661F\u56FE\u4E0A\u6D88\u5931\u7684\u5750\u6807\uFF0C\u8FD8\u6709\u4E00\u4E2A\u6211\u4E4B\u524D\u53EA\u89C1\u8FC7\u4E00\u6B21\u7684\u7B26\u6587\uFF0C\u5B83\u51FA\u73B0\u5728\u4E0E\u7C73\u5C14\u514B\u76F8\u5173\u7684\u9884\u8A00\u4E2D\u3002\u9884\u8A00\u63CF\u8FF0\u4E86\u4E00\u5EA7\u6BD4\u5D29\u584C\u8FD8\u8981\u53E4\u8001\u5F97\u591A\u7684\u795E\u5E99\uFF0C\u751A\u81F3\u6BD4\u8054\u76DF\u672C\u8EAB\u8FD8\u8981\u53E4\u8001\u3002\u6211\u60F3\uFF0C\u6211\u4EEC\u6B63\u8D70\u5728\u901A\u5F80\u67D0\u79CD\u53E4\u8001\u2026\u2026\u800C\u795E\u5723\u4E4B\u7269\u7684\u9053\u8DEF\u4E0A\u3002"
  - Name: battle_4_10_1
    Text: "\u5728\u6211\u91CD\u65B0\u53D1\u73B0\u76D6\u4E9A\u4E4B\u524D\u4E0D\u4E45\uFF0C\u6211\u5F00\u59CB\u542C\u5230\u4E00\u4E9B\u4F4E\u8BED\u2014\u2014\u5173\u4E8E\u9ED1\u6697\u865A\u7A7A\u56DE\u5F52\u7684\u4F20\u95FB\u3002\u94F6\u6CB3\u7CFB\u8FB9\u7F18\u7684\u661F\u7403\u9010\u6E10\u9677\u5165\u9ED1\u6697\uFF0C\u4E00\u4E2A\u63A5\u4E00\u4E2A\u5730\u4ECE\u661F\u754C\u4FE1\u6807\u4E2D\u6D88\u5931\u3002\u4F46\u8FD9\u4E00\u6B21\uFF0C\u4E0D\u4EC5\u4EC5\u662F\u5143\u7D20\u6DF7\u6C8C\u2026\u2026\u5E78\u5B58\u8005\u4EEC\u8C08\u8BBA\u7740\u67D0\u79CD\u5F62\u6001\u3002\u67D0\u79CD\u5F62\u72B6\u3002\u4EFF\u4F5B\u865A\u7A7A\u5F00\u59CB\u6709\u4E86\u9762\u5B54\u3002"
  - Name: battle_4_10_2
    Text: "\u7B49\u6211\u4EEC\u5230\u8FBE\u7070\u70EC\u4E4B\u95E8\uFF0C\u518D\u7EC6\u8BF4\u5427\u3002\u8FD8\u6709\u5F88\u591A\u4E8B\u4F60\u5FC5\u987B\u77E5\u9053\u3002\u4F46\u73B0\u5728\uFF0C\u8FD9\u6761\u8DEF\u7684\u5C3D\u5934\u8FD8\u5728\u7B49\u7740\u6211\u4EEC\u3002\u6211\u62C5\u5FC3\uFF0C\u524D\u65B9\u7684\u6311\u6218\u6216\u8BB8\u6BD4\u6211\u4EEC\u8FC4\u4ECA\u4E3A\u6B62\u6240\u7ECF\u5386\u7684\u66F4\u52A0\u4E25\u5CFB\u3002"
  - Name: battle_5_1_1
    Text: "\u8FD9\u5EA7\u57CE\u9547\u4E0D\u4F1A\u6B22\u8FCE\u6211\u4EEC\u3002\u8FD9\u91CC\u6B8B\u5B58\u7684\u673A\u5668\u4F1A\u628A\u6211\u4EEC\u89C6\u4E3A\u5165\u4FB5\u8005\uFF0C\u800C\u975E\u76DF\u53CB\u3002\u5F88\u4E45\u4EE5\u524D\uFF0C\u8F9B\u5FB7\u76D6\u7279\u66FE\u662F\u5947\u8FF9\u4E4B\u5730\uFF0C\u662F\u673A\u68B0\u4E16\u754C\u7684\u4E2D\u5FC3\u3002\u673A\u5668\u4EBA\u66FE\u6709\u6761\u4E0D\u7D0A\u5730\u7A7F\u68AD\u4E8E\u8FD9\u4E9B\u8857\u9053\uFF1A\u8FCE\u63A5\u65C5\u4EBA\uFF0C\u4FEE\u7406\u98DE\u8239\uFF0C\u751A\u81F3\u534F\u52A9\u54E8\u5175\u8FDB\u884C\u5143\u7D20\u7814\u7A76\u3002"
  - Name: battle_5_1_2
    Text: "\u4F46\u5927\u5D29\u584C\u53D1\u751F\u540E\uFF0C\u4E00\u5207\u90FD\u53D8\u4E86\u3002\u4F20\u8BF4\u4E2D\uFF0C\u8BB0\u5FC6\u6E05\u9664\u51FA\u4E86\u5DEE\u9519\uFF0C\u673A\u5668\u5728\u6DF7\u4E71\u548C\u66B4\u529B\u4E2D\u53CD\u566C\u4E86\u5B83\u4EEC\u7684\u521B\u9020\u8005\u3002\u90A3\u4E9B\u65E0\u6CD5\u5173\u95ED\u7684\u7CFB\u7EDF\u88AB\u9057\u5F03\u2026\u2026\u4EFB\u5176\u8150\u673D\uFF0C\u5B88\u62A4\u7740\u4E00\u5EA7\u65E9\u5DF2\u5FD8\u8BB0\u5176\u5EFA\u9020\u521D\u8877\u7684\u57CE\u9547\u3002"
  - Name: battle_5_5_1
    Text: "\u6211\u597D\u50CF\u5728\u4E0A\u6B21\u6218\u6597\u7684\u6B8B\u9AB8\u91CC\u627E\u5230\u4E86\u4EC0\u4E48\u4E1C\u897F\u3002\u770B\u8D77\u6765\u50CF\u4E2A\u8BB0\u5FC6\u6838\u5FC3\u3002\u4FDD\u5B58\u5F97\u51FA\u5947\u5730\u5B8C\u597D\u3002\u5B83\u88AB\u52A0\u5BC6\u4E86\uFF0C\u4F46\u6211\u8BBE\u6CD5\u63D0\u53D6\u4E86\u4E00\u4E9B\u7247\u6BB5\u3002\u5F88\u5947\u602A\u2026\u2026\u611F\u89C9\u50CF\u662F\u7ED9\u5723\u88D4\u7528\u7684\u3002\u91CC\u9762\u7F16\u7801\u4E86\u4E00\u5F20\u5730\u56FE\uFF0C\u6307\u5F15\u6211\u4EEC\u7A7F\u8FC7\u4E00\u7247\u6CBC\u6CFD\uFF0C\u7136\u540E\u662F\u4E00\u7247\u5E7F\u88A4\u7684\u6C99\u6F20\uFF0C\u6700\u7EC8\u7ED5\u8FC7\u4E00\u5EA7\u770B\u8D77\u6765\u50CF\u706B\u5C71\u7684\u4E1C\u897F\u3002\u8FD9\u6216\u8BB8\u5C31\u662F\u6211\u4EEC\u4E00\u76F4\u5728\u5BFB\u627E\u7684\u8DEF\u2026\u2026\u5982\u679C\u8FD8\u6709\u66F4\u591A\u7C7B\u4F3C\u7684\u8BB0\u5FC6\u6838\u5FC3\uFF0C\u6211\u4EEC\u5F88\u53EF\u80FD\u4F1A\u5728\u9014\u4E2D\u627E\u5230\u66F4\u591A\u7B54\u6848\u3002"
  - Name: battle_5_5_2
    Text: "\u8FD8\u6709\u66F4\u591A\u3002\u6838\u5FC3\u4FDD\u5B58\u7740\u8F9B\u5FB7\u76D6\u7279\u672B\u65E5\u7684\u65E5\u5FD7\u3002\u5D29\u584C\u4E4B\u540E\uFF0C\u5C0F\u9547\u7684\u4E2D\u592E\u5904\u7406\u5668\u53D8\u6210\u4E86\u4E00\u4E2A\u540D\u4E3A\u201C\u516C\u7406\u201D\u7684\u6784\u9020\u4F53\uFF0C\u5B83\u542F\u52A8\u4E86\u4E00\u5957\u9632\u5FA1\u6027\u6E05\u9664\u534F\u8BAE\u3002\u5B83\u4EEC\u7684\u9996\u8981\u6307\u4EE4\u53D8\u6210\u4E86\u751F\u5B58\u548C\u5468\u8FB9\u63A7\u5236\u3002\u5931\u53BB\u4E86\u76EE\u6807\uFF0C\u5931\u53BB\u4E86\u4EBA\uFF0C\u5B83\u4EEC\u5F00\u59CB\u653B\u51FB\u4E00\u5207\uFF0C\u751A\u81F3\u4E92\u76F8\u6B8B\u6740\u3002\u8FD9\u5EA7\u5C0F\u9547\u5E76\u975E\u8F7B\u6613\u5D29\u584C\uFF0C\u800C\u662F\u81EA\u6211\u6BC1\u706D\u3002"
  - Name: battle_5_10_1
    Text: "\u4F60\u8FD8\u8BB0\u5F97\u6211\u8BF4\u8FC7\u865A\u7A7A\u56DE\u5F52\u5417\uFF1F\u55EF\u2026\u2026\u6211\u542C\u5230\u5916\u56F4\u661F\u533A\u4F20\u6765\u4E00\u4E9B\u98CE\u58F0\u3002\u4ED6\u4EEC\u8BF4\u865A\u7A7A\u73B0\u5728\u6709\u4E86\u9762\u5B54\u3002\u90A3\u4E9B\u66FE\u7ECF\u6F5C\u4F0F\u5728\u5783\u573E\u573A\u3001\u82DF\u5EF6\u6B8B\u5598\u7684\u866B\u5F62\u62FE\u8352\u8005\u2014\u2014\u5F17\u96F7\u57FA\u5C14\u4EBA\uFF0C\u5982\u4ECA\u53D8\u4E86\u3002\u6709\u4EBA\u8BF4\u4ED6\u4EEC\u878D\u5165\u4E86\u865A\u7A7A\u2026\u2026\u6216\u8005\u88AB\u865A\u7A7A\u541E\u566C\u4E86\u3002\u4E0D\u7BA1\u600E\u6837\uFF0C\u4ED6\u4EEC\u4E0D\u518D\u662F\u6211\u4EEC\u66FE\u7ECF\u601C\u60AF\u7684\u7EDD\u671B\u751F\u7269\u3002\u4ED6\u4EEC\u73B0\u5728\u53D8\u6210\u4E86\u522B\u7684\u4E1C\u897F\uFF0C\u67D0\u79CD\u5371\u9669\u7684\u5B58\u5728\u3002"
  - Name: battle_5_10_2
    Text: "\u5982\u679C\u4ED6\u4EEC\u7684\u9965\u997F\u611F\u4F9D\u7136\u9A71\u4F7F\u4ED6\u4EEC\uFF0C\u4ED6\u4EEC\u5C31\u4F1A\u5BFB\u627E\u76D6\u4E9A\uFF0C\u5C24\u5176\u662F\u5728\u4ED6\u4EEC\u611F\u77E5\u5230\u4F60\u7684\u89C9\u9192\u4E4B\u540E\u3002\u6211\u4EEC\u5FC5\u987B\u53D8\u5F97\u66F4\u5F3A\uFF0C\u66F4\u5FEB\u3002\u4F60\u7684\u89C9\u9192\u4E0D\u4EC5\u4EC5\u662F\u4E3A\u4E86\u593A\u56DE\u8FC7\u53BB\uFF0C\u540E\u88D4\u2026\u2026\u4F60\u4E5F\u662F\u4E3A\u4E86\u5B88\u62A4\u672A\u6765\u3002"
  - Name: battle_6_1_1
    Text: "\u8FD9\u91CC\u7EDD\u4E0D\u53EF\u80FD\u662F\u66FE\u7ECF\u80A5\u6C83\u7684\u76C6\u5730\u2026\u2026\u5149\u662F\u8FD9\u80A1\u6076\u81ED\u5C31\u8DB3\u4EE5\u628A\u94A2\u94C1\u4E0A\u7684\u6CB9\u6F06\u90FD\u718F\u6389\uFF01\u4EFF\u4F5B\u76D6\u4E9A\u4E0A\u6240\u6709\u5782\u6B7B\u7684\u751F\u7269\u90FD\u6765\u5230\u8FD9\u91CC\u8150\u70C2\uFF0C\u88AB\u6CBC\u6CFD\u541E\u566C\uFF0C\u6700\u7EC8\u88AB\u4EBA\u9057\u5FD8\u3002\u5C31\u7B97\u90A3\u4E9B\u751F\u7269\u6CA1\u8981\u4E86\u6211\u4EEC\u7684\u547D\uFF0C\u8FD9\u80A1\u6076\u81ED\u4E5F\u80AF\u5B9A\u4F1A\u8981\u4E86\u6211\u4EEC\u7684\u547D\u3002"
  - Name: battle_6_1_2
    Text: "\u5C0F\u5FC3\u884C\u4E8B\uFF0C\u540E\u88D4\u3002\u6211\u4EEC\u6BCF\u8D70\u4E00\u6B65\uFF0C\u5730\u9762\u90FD\u4F1A\u79FB\u52A8\uFF0C\u4EFF\u4F5B\u5B83\u5728\u6CE8\u89C6\u7740\u6211\u4EEC\u2026\u2026\u7B49\u5F85\u7740\u3002\u8FD9\u7247\u6CBC\u6CFD\u5E76\u4E0D\u6B22\u8FCE\u6211\u4EEC\u3002\u5B83\u4F1A\u547C\u5438\uFF0C\u4F1A\u503E\u542C\uFF0C\u4F1A\u94ED\u8BB0\u3002\u6211\u5BB3\u6015\u5B83\u77E5\u9053\u4F60\u662F\u8C01\u3002"
  - Name: battle_6_5_1
    Text: "\u4F60\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u8FD9\u91CC\u7684\u5143\u7D20\u2026\u2026\u5B83\u4EEC\u626D\u66F2\u7FFB\u817E\uFF0C\u4EFF\u4F5B\u88AB\u67D0\u79CD\u6BD2\u7269\u4FB5\u8680\u3002\u8FD9\u4E0D\u81EA\u7136\u3002\u4EFF\u4F5B\u865A\u7A7A\u5728\u8FD9\u91CC\u7559\u4E0B\u4E86\u4E00\u9053\u4F24\u53E3\uFF0C\u800C\u8FD9\u7247\u6CBC\u6CFD\u4ECE\u672A\u6108\u5408\u3002\u5C31\u8FDE\u56DE\u5E94\u4F60\u53EC\u5524\u7684\u5143\u7D20\u751F\u7269\u4E5F\u663E\u5F97\u72B9\u8C6B\u4E0D\u51B3\uFF0C\u4EFF\u4F5B\u5728\u8150\u5316\u7684\u8FF7\u96FE\u4E2D\u8270\u96BE\u8DCB\u6D89\u3002\u8868\u9762\u4E4B\u4E0B\uFF0C\u9690\u85CF\u7740\u67D0\u79CD\u4E0D\u7965\u4E4B\u5146\u3002"
  - Name: battle_6_5_2
    Text: "\u8FD9\u91CC\u4E5F\u6709\u4F4E\u8BED\uFF0C\u4E0D\u53EA\u662F\u82A6\u82C7\u95F4\u6C99\u6C99\u4F5C\u54CD\u7684\u90A3\u79CD\u3002\u8FD9\u662F\u4EBA\u58F0\u3002\u53E4\u8001\u7684\u4EBA\u58F0\u3002\u6216\u8BB8\u662F\u4EA1\u7075\uFF0C\u81EA\u5927\u5D29\u584C\u4EE5\u6765\u5C31\u88AB\u675F\u7F1A\u5728\u8FD9\u7247\u6DE4\u6CE5\u4E4B\u4E2D\u3002\u6211\u5206\u8FA8\u4E0D\u51FA\u5B83\u4EEC\u662F\u5728\u8B66\u544A\u6211\u4EEC\u2026\u2026\u8FD8\u662F\u5728\u5F15\u8BF1\u6211\u4EEC\u6C89\u6CA6\u3002\u65E0\u8BBA\u5982\u4F55\uFF0C\u5982\u679C\u6B7B\u8005\u6CA1\u6709\u771F\u6B63\u6B7B\u53BB\uFF0C\u6211\u5C31\u4E0D\u4FE1\u4EFB\u4ED6\u4EEC\u3002"
  - Name: battle_6_10_1
    Text: "\u65E9\u4E9B\u65F6\u5019\uFF0C\u6211\u5076\u7136\u53D1\u73B0\u4E86\u4E00\u4E9B\u50CF\u662F\u795E\u5E99\u77F3\u5757\u7684\u4E1C\u897F\u3002\u5B83\u4EEC\u88AB\u6DF9\u6CA1\u5728\u6C34\u4E2D\uFF0C\u5E03\u6EE1\u88C2\u7F1D\uFF0C\u88AB\u85E4\u8513\u548C\u82D4\u85D3\u4FB5\u8680\u4E86\u4E00\u534A\u3002\u4E0A\u9762\u7684\u7B26\u53F7\u9177\u4F3C\u53E4\u8001\u54E8\u5175\u7684\u5FBD\u7AE0\u3002\u8FD9\u91CC\u6216\u8BB8\u66FE\u7ECF\u77D7\u7ACB\u7740\u4E00\u5EA7\u5723\u6BBF\uFF0C\u65E9\u5DF2\u88AB\u4EBA\u9057\u5FD8\u3002\u5982\u679C\u771F\u662F\u5982\u6B64\uFF0C\u8FD9\u7247\u6CBC\u6CFD\u53EF\u80FD\u4E0D\u4EC5\u4EC5\u662F\u4E00\u7247\u5893\u5730\u3002\u60F3\u5230\u8FD9\u91CC\u66FE\u7ECF\u7684\u8F89\u714C\uFF0C\u4E0D\u7981\u4EE4\u4EBA\u4F24\u611F\u3002"
  - Name: battle_6_10_2
    Text: "\u6211\u60F3\u6211\u4EEC\u5DEE\u4E0D\u591A\u53EF\u4EE5\u79BB\u5F00\u8FD9\u91CC\u4E86\u3002\u5929\u6C14\u4F3C\u4E4E\u5F00\u59CB\u8FC5\u901F\u5E72\u71E5\uFF0C\u6C14\u6E29\u4E5F\u6025\u5267\u4E0A\u5347\u3002\u8FD9\u573A\u6700\u540E\u7684\u6218\u6597\u6216\u8BB8\u7EC8\u4E8E\u80FD\u8BA9\u6211\u4EEC\u547C\u5438\u5230\u65B0\u9C9C\u7A7A\u6C14\uFF0C\u8FD9\u8BDD\u53EF\u4E0D\u662F\u968F\u4FBF\u8BF4\u8BF4\u3002"
  - Name: battle_7_1_1
    Text: "\u4ECE\u714E\u9505\u5230\u5E73\u5E95\u9505\u3002\u8FD9\u91CC\u66FE\u7ECF\u662F\u6851\u62FF\u623F\uFF0C\u5982\u4ECA\u5374\u53EA\u662F\u70ED\u3002\u8FD9\u7247\u571F\u5730\u66FE\u88AB\u79F0\u4E3A\u7D22\u5C14\u7EF4\u7EB3\u4E4B\u6D77\uFF0C\u4E00\u7247\u91D1\u8272\u7684\u6C34\u57DF\u6D41\u6DCC\u5728\u6CE2\u5149\u7CBC\u7CBC\u3001\u661F\u5149\u7480\u74A8\u7684\u571F\u5730\u4E0A\u3002\u4F46\u81EA\u4ECE\u76D6\u4E9A\u4E0E\u661F\u8FB0\u9694\u7EDD\u540E\uFF0C\u5730\u8109\u65AD\u88C2\u3002\u6C34\u5E72\u6DB8\uFF0C\u6C99\u783E\u4FB5\u8680\uFF0C\u6B8B\u5B58\u7684\u751F\u547D\u2026\u2026\u51CB\u96F6\u67AF\u840E\u3002\u5982\u4ECA\uFF0C\u4EBA\u4EEC\u79F0\u4E4B\u4E3A\u76D6\u4E9A\u4E4B\u6B87\uFF0C\u5E76\u975E\u51FA\u4E8E\u6124\u6012\uFF0C\u800C\u662F\u51FA\u4E8E\u54C0\u60BC\u3002"
  - Name: battle_7_1_2
    Text: "\u5982\u679C\u6211\u4EEC\u80FD\u5230\u8FBE\u4E2D\u9014\uFF0C\u6211\u542C\u8BF4\u90A3\u91CC\u6709\u4E00\u4E9B\u5E9F\u589F\u53EF\u4EE5\u907F\u96BE\u3002\u8FD0\u6C14\u597D\u7684\u8BDD\uFF0C\u90A3\u91CC\u6216\u8BB8\u80FD\u627E\u5230\u4E00\u4E9B\u7EBF\u7D22\uFF0C\u544A\u8BC9\u6211\u4EEC\u4E0B\u4E00\u6B65\u8BE5\u53BB\u54EA\u91CC\u3002\u4E00\u5B9A\u8981\u7741\u5927\u773C\u775B\u3002\u8FD9\u91CC\u7684\u4E1C\u897F\u4E0D\u4F1A\u4E00\u76F4\u57CB\u85CF\u5728\u5730\u4E0B\uFF0C\u5C24\u5176\u662F\u8FC7\u53BB\u7684\u4E8B\u60C5\u3002"
  - Name: battle_7_5_1
    Text: "\u6211\u4EEC\u5F88\u5E78\u8FD0\u5730\u5728\u8FD9\u4E9B\u5E9F\u589F\u91CC\u627E\u5230\u4E86\u907F\u96BE\u6240\u3002\u6211\u60F3\u4E0A\u6B21\u7684\u6218\u6597\u63A8\u5012\u4E86\u4E00\u4E9B\u57CE\u5899\uFF0C\u5728\u5176\u4E2D\u4E00\u9762\u57CE\u5899\u540E\u9762\u2026\u2026\u53D1\u73B0\u4E86\u4E00\u4E9B\u5947\u602A\u7684\u4E1C\u897F\u3002\u4E00\u5F20\u53E4\u8001\u7684\u7F8A\u76AE\u7EB8\uFF0C\u53C8\u8106\u53C8\u7126\uFF0C\u4E0A\u9762\u63CF\u7ED8\u7740\u8FD9\u7247\u571F\u5730\u5728\u5E72\u6DB8\u4E4B\u524D\u7684\u666F\u8C61\uFF1A\u7FE0\u7EFF\u7684\u5C0F\u5F84\uFF0C\u873F\u8712\u7684\u5730\u8109\uFF0C\u4EE5\u53CA\u6B63\u4E2D\u592E\u2026\u2026\u4E00\u4E2A\u5DE8\u5927\u7684\u7EA2\u8272\u5706\u5708\u3002\u6839\u636E\u8FD9\u5F20\u7F8A\u76AE\u7EB8\u7684\u63CF\u8FF0\uFF0C\u5982\u679C\u6211\u4EEC\u7EE7\u7EED\u6CBF\u7740\u521A\u624D\u7684\u65B9\u5411\u8D70\uFF0C\u7136\u540E\u5728\u5C71\u810A\u5904\u53F3\u8F6C\uFF0C\u5C31\u4F1A\u5F84\u76F4\u8D70\u8FDB\u53BB\u3002"
  - Name: battle_7_5_2
    Text: "\u6709\u65F6\u6211\u4F1A\u60F3\uFF0C\u5148\u77E5\u9ED8\u514B\u662F\u5426\u5728\u6307\u5F15\u7740\u6211\u4EEC\u7684\u6BCF\u4E00\u6B65\u3002\u4ED6\u7684\u6559\u8BF2\u4E2D\u5E38\u5E38\u63D0\u53CA\u5143\u7D20\u7684\u6D41\u52A8\u548C\u672A\u77E5\u7684\u9053\u8DEF\u3002\u6211\u4E00\u76F4\u5BF9\u4ED6\u7684\u8BDD\u8BED\u62B1\u6709\u4E00\u4E1D\u4FE1\u5FF5\u3002\u5982\u679C\u4ED6\u7684\u7CBE\u795E\u6B64\u523B\u4E0E\u6211\u4EEC\u540C\u5728\uFF0C\u90A3\u4E48\u6216\u8BB8\u4ED6\u6B63\u5F15\u9886\u6211\u4EEC\u627E\u5230\u5BF9\u6297\u5373\u5C06\u5230\u6765\u7684\u9ED1\u6697\u6240\u9700\u7684\u529B\u91CF\u3002"
  - Name: battle_7_10_1
    Text: "\u6211\u4EEC\u5FEB\u8981\u6446\u8131\u8FD9\u80A1\u70ED\u6D6A\u4E86\u3002\u5E0C\u671B\u63A5\u4E0B\u6765\u7684\u8DEF\u7A0B\u51C9\u723D\u5F97\u591A\u3002\u6211\u5E94\u8BE5\u591A\u7814\u7A76\u4E00\u4E0B\u6C34\u5143\u7D20\uFF0C\u6216\u8BB8\u5C31\u80FD\u4ECE\u8FD9\u4E9B\u5E72\u67AF\u7684\u9AA8\u5934\u91CC\u6C72\u53D6\u4E00\u4E24\u6EF4\u6C34\u6765\u964D\u964D\u6E29\u4E86\u3002\u4E0D\u8FC7\uFF0C\u6211\u6CA1\u89C1\u4F60\u51FA\u6C57\uFF0CScion\u3002\u4F60\u603B\u662F\u90A3\u4E48\u6C89\u7740\u51B7\u9759\uFF0C\u4EFF\u4F5B\u6765\u81EA\u53E6\u4E00\u4E2A\u4E16\u754C\u3002"
  - Name: battle_7_10_2
    Text: "\u505A\u597D\u51C6\u5907\u3002\u6C99\u5B50\u5728\u79FB\u52A8\u2026\u2026\u6211\u4EEC\u811A\u4E0B\u6709\u4EC0\u4E48\u4E1C\u897F\u5728\u52A8\u3002\u6211\u53EA\u5E0C\u671B\u90A3\u4E0D\u662F\u9508\u8708\u86A3\u3002\u90A3\u4E9B\u8BA8\u538C\u7684\u5BB6\u4F19\uFF0C\u5DE8\u5927\u7684\u3001\u91D1\u5C5E\u5916\u58F3\u7684\u8708\u86A3\uFF0C\u80FD\u94BB\u900F\u77F3\u5934\u548C\u94A2\u94C1\u3002\u5B83\u4EEC\u4E0D\u6311\u5254\u3002\u53EA\u8981\u662F\u4F1A\u547C\u5438\u6216\u4F1A\u53D1\u5149\u7684\uFF0C\u5B83\u4EEC\u90FD\u4F1A\u541E\u566C\u3002\u6211\u4EEC\u8D76\u7D27\u7ED3\u675F\u8FD9\u573A\u6218\u6597\uFF0C\u7EE7\u7EED\u524D\u8FDB\u3002\u6CA1\u5FC5\u8981\u7B49\u7740\u90A3\u4E1C\u897F\u81EA\u5DF1\u627E\u4E0A\u95E8\u6765\u3002"
  - Name: battle_8_1_1
    Text: "\u5143\u7D20\u4F7F\u7136\uFF0C\u6211\u4EEC\u6C38\u8FDC\u4E5F\u5598\u4E0D\u8FC7\u6C14\u6765\u3002\u8FD9\u91CC\u53EA\u4F1A\u8D8A\u6765\u8D8A\u70ED\u3002\u6211\u731C\u60F3\u8FD9\u5C31\u662F\u7070\u70EC\u4E4B\u73AF\u3002\u6211\u8BFB\u5230\u8FC7\uFF0C\u8FD9\u91CC\u66FE\u7ECF\u662F\u4E00\u6761\u795E\u5723\u7684\u9053\u8DEF\u2026\u2026\u662F\u8D24\u8005\u4EEC\u7814\u4E60\u706B\u5143\u7D20\u7684\u671D\u5723\u4E4B\u8DEF\u3002\u5728\u7194\u5CA9\u7684\u7099\u70E4\u4E0B\uFF0C\u4ED6\u4EEC\u8981\u7ECF\u5386\u8010\u529B\u3001\u6280\u827A\u548C\u63A7\u5236\u529B\u7684\u8003\u9A8C\u3002\u5982\u4ECA\uFF0C\u6211\u53EA\u5E0C\u671B\u90A3\u4E9B\u706B\u5143\u7D20\u6C38\u8FDC\u6DF1\u57CB\u5728\u706B\u5C71\u7684\u6838\u5FC3\u6DF1\u5904\u3002"
  - Name: battle_8_1_2
    Text: "\u8FDC\u5904\uFF0C\u6211\u80FD\u770B\u5230\u6B8B\u7834\u7684\u5E99\u5B87\u5C16\u9876\u3002\u5982\u679C\u6211\u4EEC\u8DB3\u591F\u5E78\u8FD0\uFF0C\u90A3\u91CC\u6216\u8BB8\u85CF\u6709\u4E0E\u661F\u754C\u8054\u76DF\u76F8\u5173\u7684\u8BB0\u5F55\u6216\u7B26\u53F7\uFF0C\u751A\u81F3\u53EF\u80FD\u85CF\u6709\u7C73\u5C14\u514B\u672C\u4EBA\u7684\u8E2A\u8FF9\u3002\u6211\u4EEC\u4E00\u8DEF\u8FFD\u8E2A\u7740\u79D8\u5BC6\uFF0C\u6A2A\u8DE8\u4E86\u534A\u4E2A\u76D6\u4E9A\u5927\u9646\uFF0C\u5982\u679C\u8FD9\u4E9B\u5E9F\u589F\u80FD\u91CD\u73B0\u6614\u65E5\u7684\u8F89\u714C\uFF0C\u6216\u8BB8\u80FD\u5E2E\u52A9\u6211\u4EEC\u627E\u5230\u524D\u65B9\u7684\u8DEF\u3002"
  - Name: battle_8_1_3
    Text: "\u6211\u8FD8\u6CA1\u628A\u627E\u5230\u76D6\u4E9A\u7684\u5168\u90E8\u7ECF\u8FC7\u544A\u8BC9\u4F60\u3002\u6211\u7684\u7956\u5148\u662F\u54E8\u5175\uFF0C\u6CA1\u9519\uFF0C\u4F46\u6211\u4E00\u751F\u90FD\u5728\u8FFD\u5BFB\u795E\u8BDD\u3002\u5E9F\u5F03\u592A\u7A7A\u7AD9\u91CC\u7684\u4F4E\u8BED\uFF0C\u88AB\u9057\u5FD8\u7684\u65E5\u8BB0\u91CC\u6F66\u8349\u7ED8\u5236\u7684\u661F\u56FE\uFF0C\u5B83\u4EEC\u90FD\u6307\u5411\u8FD9\u91CC\u2014\u2014\u8FD9\u4E2A\u4E0E\u4E16\u9694\u7EDD\u7684\u5931\u843D\u4E16\u754C\u3002\u5927\u591A\u6570\u4EBA\u90FD\u5632\u7B11\u6211\u3002\u4F46\u5F53\u6211\u7B2C\u4E00\u6B21\u5728\u8FD9\u4E2A\u661F\u7CFB\u4E2D\u770B\u5230\u7834\u788E\u7684\u4F20\u9001\u95E8\u4FE1\u53F7\u65F6\u2026\u2026\u6211\u660E\u767D\u4E86\u3002\u67D0\u79CD\u53E4\u8001\u7684\u529B\u91CF\u4ECD\u5728\u8FD9\u91CC\u6D8C\u52A8\u3002\u800C\u73B0\u5728\uFF0C\u4F60\u9192\u4E86\uFF0C\u540E\u88D4\u3002\u8FD9\u4E0D\u662F\u75AF\u72C2\uFF0C\u8FD9\u662F\u547D\u8FD0\u3002"
  - Name: battle_8_5_1
    Text: "\u6211\u89C9\u5F97\u6211\u4EEC\u5728\u8FD9\u91CC\u627E\u4E0D\u5230\u4EC0\u4E48\u3002\u591A\u5E74\u6765\uFF0C\u8FD9\u91CC\u7684\u4E00\u5207\u4F3C\u4E4E\u90FD\u88AB\u7FFB\u4E86\u4E2A\u5E95\u671D\u5929\u3002\u76D7\u5893\u8005\u3001\u62FE\u8352\u8005\uFF0C\u751A\u81F3\u65F6\u95F4\u672C\u8EAB\uFF0C\u90FD\u66FE\u8F6E\u756A\u63A0\u593A\u8FD9\u5EA7\u795E\u5E99\u7684\u610F\u4E49\u3002\u6211\u4EEC\u5F97\u975E\u5E38\u5E78\u8FD0\u624D\u80FD\u627E\u5230\u4EFB\u4F55\u4E1C\u897F\u3002"
  - Name: battle_8_5_2
    Text: "\u7D22\u6797\u8F6C\u8EAB\u6B63\u8981\u79BB\u5F00\u65F6\uFF0C\u811A\u4E0B\u7684\u4E00\u5757\u677E\u52A8\u7684\u77F3\u677F\u53D1\u51FA\u6C89\u95F7\u7684\u649E\u51FB\u58F0\u3002\u4ED6\u8DEA\u4E0B\uFF0C\u62C2\u53BB\u79EF\u6512\u4E86\u51E0\u4E2A\u4E16\u7EAA\u7684\u5C18\u57C3\uFF0C\u9732\u51FA\u5730\u677F\u4E0A\u4E00\u4E2A\u6A21\u7CCA\u7684\u3001\u88AB\u70E7\u7126\u7684\u7B26\u6587\uFF1A\u706B\u7130\u87BA\u65CB\u73AF\u7ED5\u7740\u4E00\u4E2A\u95E8\u5F62\u56FE\u6848\u3002\u201C\u5929\u54EA\u2026\u2026\u8FD9\u53EF\u4E0D\u662F\u6211\u7814\u7A76\u8FC7\u7684\u4EFB\u4F55\u53E4\u8001\u795E\u6BBF\u56FE\u7EB8\u4E0A\u90FD\u6709\u7684\u3002\u201D\u4ED6\u6309\u4E0B\u7B26\u6587\uFF0C\u5899\u58C1\u7684\u4E00\u90E8\u5206\u53D1\u51FA\u547B\u541F\u5E76\u79FB\u52A8\uFF0C\u9732\u51FA\u4E00\u5E45\u70E7\u7126\u7684\u6D6E\u96D5\uFF1A\u4E00\u5E45\u58C1\u753B\u63CF\u7ED8\u4E86\u62C2\u6653\u8840\u76DF\u6210\u5458\u6CBF\u7740\u4E00\u6761\u9690\u79D8\u7684\u5C0F\u5F84\u6DF1\u5165\u706B\u5C71\u5E95\u90E8\uFF0C\u706B\u7130\u5728\u4ED6\u4EEC\u9762\u524D\u5206\u5F00\uFF0C\u4EFF\u4F5B\u706B\u5C71\u672C\u8EAB\u4E5F\u8BA4\u51FA\u4E86\u4ED6\u4EEC\u7684\u5B58\u5728\u3002"
  - Name: battle_8_5_3
    Text: "\u5C31\u5728\u706B\u5C71\u811A\u4E0B\u3002\u90A3\u53EF\u4E0D\u662F\u666E\u901A\u7684\u7194\u5CA9\u7BA1\u3002\u90A3\u662F\u4E00\u6761\u5C01\u95ED\u7684\u901A\u9053\uFF0C\u53EA\u6709\u8D24\u8005\u624D\u80FD\u5F00\u542F\u3002\u770B\u6765\u6211\u4EEC\u7684\u4E0B\u4E00\u4E2A\u8003\u9A8C\u4E0D\u5728\u706B\u5C71\u5468\u56F4\uFF0C\u800C\u662F\u5728\u70C8\u7130\u4E4B\u4E0B\u3002\u8D24\u8005\uFF0C\u505A\u597D\u51C6\u5907\u5427\u3002\u771F\u6B63\u7684\u8003\u9A8C\u73B0\u5728\u5F00\u59CB\u3002"
  - Name: battle_8_10_1
    Text: "\u201C\u6211\u60F3\u6211\u4EEC\u5E94\u8BE5\u5728\u8FD9\u91CC\uFF0C\u4F46\u6211\u4EC0\u4E48\u4E5F\u6CA1\u770B\u5230\u3002\u201D\u7D22\u6797\u4F4E\u58F0\u8BF4\u9053\uFF0C\u76EE\u5149\u626B\u8FC7\u706B\u5C71\u811A\u4E0B\u5D99\u5CCB\u7684\u9ED1\u66DC\u77F3\u5C71\u810A\u3002\u706B\u5C71\u7070\u5728\u707C\u70ED\u7684\u7A7A\u6C14\u4E2D\u7FFB\u817E\uFF0C\u5730\u9762\u5FAE\u5F31\u800C\u6709\u8282\u594F\u5730\u98A4\u52A8\u7740\uFF0C\u5982\u540C\u5C71\u4F53\u6DF1\u5904\u7684\u5FC3\u8DF3\u3002\u5C31\u5728\u8FD9\u65F6\uFF0C\u4F60\u5411\u524D\u8FC8\u4E86\u4E00\u6B65\u3002\u4F60\u62A4\u624B\u4E0A\u7684\u7B26\u6587\u5F00\u59CB\u5FAE\u5FAE\u53D1\u5149\uFF0C\u4EFF\u4F5B\u5728\u56DE\u5E94\u67D0\u79CD\u65E0\u5F62\u7684\u53EC\u5524\u3002"
  - Name: battle_8_10_2
    Text: "\u5927\u5730\u5F00\u59CB\u95EA\u70C1\uFF0C\u5E76\u975E\u56E0\u9AD8\u6E29\uFF0C\u800C\u662F\u56E0\u4E3A\u80FD\u91CF\u6D8C\u52A8\u3002\u4E00\u5708\u53E4\u8001\u7684\u7B26\u6587\uFF0C\u6DF1\u57CB\u4E8E\u5C18\u57C3\u548C\u70DF\u5C18\u4E4B\u4E0B\uFF0C\u6B64\u523B\u71C3\u8D77\u718A\u718A\u70C8\u7130\u3002\u706B\u7130\u4E0E\u5CA9\u77F3\u4EA4\u9519\u626D\u66F2\uFF0C\u88C2\u5F00\u4E00\u9053\u9053\u7531\u7126\u9ED1\u7684\u7384\u6B66\u5CA9\u7F1D\u5236\u800C\u6210\u7684\u9636\u68AF\uFF0C\u87BA\u65CB\u5411\u4E0B\u5EF6\u4F38\u81F3\u5C71\u4F53\u6DF1\u5904\u3002\u5C71\u4F53\u53D1\u51FA\u4F4E\u6C89\u7684\u547B\u541F\uFF0C\u5E76\u975E\u6297\u8BAE\uFF0C\u800C\u662F\u4EFF\u4F5B\u5728\u8FCE\u63A5\u4E00\u4F4D\u5F52\u6765\u7684\u7EE7\u627F\u4EBA\u3002"
  - Name: battle_8_10_3
    Text: "\u706B\u5143\u7D20\u751F\u7269\u6765\u88AD\uFF01\u6211\u4EEC\u5FC5\u987B\u51FB\u8D25\u5B83\u4EEC\u624D\u80FD\u7EE7\u7EED\u524D\u8FDB\u3002\u540E\u88D4\uFF0C\u8FD9\u662F\u4F60\u7684\u6218\u6597\uFF01\u5411\u5B83\u4EEC\u8BC1\u660E\u4F60\u5C31\u662F\u9884\u8A00\u4E2D\u7684\u540E\u88D4\uFF0C\u4F60\u5DF2\u7ECF\u5F52\u6765\uFF01"
  - Name: battle_9_1_1
    Text: "\u8FD9\u4E9B\u53F0\u9636\u4F3C\u4E4E\u6C38\u8FDC\u4E5F\u8D70\u4E0D\u5230\u5C3D\u5934\u3002\u6211\u770B\u4E0D\u5230\u5C3D\u5934\u3002\u53EA\u6709\u65E0\u5C3D\u7684\u53F0\u9636\u548C\u9ED1\u6697\u3002\u597D\u5728\u6BCF\u9694\u4E00\u6BB5\u8DDD\u79BB\u4F1A\u6709\u4E00\u4E2A\u5E73\u53F0\uFF0C\u6211\u4EEC\u53EF\u4EE5\u7A0D\u4F5C\u4F11\u606F\u3002"
  - Name: battle_9_1_2
    Text: "\u53E4\u8001\u7684\u5899\u58C1\u9690\u9690\u95EA\u70C1\u7740\u67D4\u548C\u7F25\u7F08\u7684\u5149\u8292\u3002\u954C\u523B\u7684\u58C1\u753B\u53D8\u5E7B\u95EA\u70C1\uFF0C\u63CF\u7ED8\u7740\u65E9\u5DF2\u6E6E\u6CA1\u7684\u5148\u7956\u4EEC\u66FE\u8D70\u8FC7\u8FD9\u6761\u9053\u8DEF\u3002\u90A3\u4E9B\u638C\u63E1\u5143\u7D20\u4E4B\u529B\u7684\u5148\u7956\u4EEC\u6B63\u7ECF\u5386\u7740\u6218\u6597\u4E0E\u8363\u8000\u7684\u4EA4\u950B\u3002\u6709\u4E9B\u9762\u5B54\u6E05\u6670\u53EF\u89C1\uFF0C\u9A84\u50B2\u800C\u80DC\u5229\uFF1B\u6709\u4E9B\u5219\u6A21\u7CCA\u4E0D\u6E05\uFF0C\u6216\u8BB8\u5DF2\u88AB\u9057\u5FD8\u2026\u2026\u6216\u5DF2\u88AB\u62B9\u53BB\u3002\u5E7B\u8C61\u4F4E\u8BED\u7740\u65E0\u8A00\u7684\u56DE\u54CD\uFF0C\u5F15\u9886\u5148\u7956\u4EEC\u77A5\u89C1\u90A3\u4E9B\u5DF2\u88AB\u65F6\u95F4\u63A9\u57CB\u7684\u8F89\u714C\u77AC\u95F4\u3002"
  - Name: battle_9_1_3
    Text: "\u4F46\u5598\u606F\u4E4B\u673A\u8F6C\u77AC\u5373\u901D\u3002\u5F53\u4F60\u8E0F\u4E0A\u7B2C\u4E00\u5904\u4F11\u61A9\u5E73\u53F0\uFF0C\u9634\u5F71\u5F00\u59CB\u6D8C\u52A8\u3002\u8FDC\u53E4\u8BD5\u70BC\u7684\u5316\u8EAB\uFF0C\u7531\u795E\u5E99\u610F\u5FD7\u5851\u9020\u7684\u751F\u7269\uFF0C\u8702\u62E5\u800C\u51FA\uFF0C\u610F\u56FE\u8003\u9A8C\u80C6\u6562\u8E0F\u5165\u6B64\u5730\u4E4B\u4EBA\u7684\u5B9E\u529B\u3002\u7D22\u6797\u6025\u5FD9\u62D4\u51FA\u6B66\u5668\u3002"
  - Name: battle_9_1_4
    Text: "\u5723\u6BBF\u6CE8\u89C6\u7740\u6211\u4EEC\uFF0C\u540E\u88D4\u3002\u6211\u4EEC\u5FC5\u987B\u8BC1\u660E\u81EA\u5DF1\u914D\u5F97\u4E0A\u8FD9\u4EFD\u8363\u8000\u3002"
  - Name: battle_9_5_1
    Text: "\u7EC8\u4E8E\uFF0C\u9177\u70ED\u7A0D\u7A0D\u7F13\u89E3\u4E86\u4E00\u4E9B\u3002\u6211\u60F3\u6211\u4EEC\u73B0\u5728\u79BB\u706B\u5C71\u5DF2\u7ECF\u8DB3\u591F\u8FDC\u4E86\u3002\u4E0D\u8FC7\u2026\u2026\u6211\u4EEC\u4E00\u8DEF\u4E0B\u5C71\uFF0C\u4E00\u4F1A\u513F\u5F80\u8FD9\u8FB9\u8D70\uFF0C\u4E00\u4F1A\u513F\u5F80\u90A3\u8FB9\u8D70\uFF0C\u76D8\u65CB\u800C\u4E0B\uFF0C\u4E00\u8DEF\u5BC2\u9759\u65E0\u58F0\uFF0C\u8FD9\u4E48\u957F\u65F6\u95F4\u4E0B\u6765\uFF0C\u6211\u4EEC\u73B0\u5728\u53EF\u80FD\u5DF2\u7ECF\u8EAB\u5904\u76D6\u4E9A\u5730\u5E95\u7684\u4EFB\u4F55\u5730\u65B9\u4E86\u3002\u7C73\u5C14\u514B\u628A\u8FD9\u6761\u8DEF\u85CF\u5F97\u771F\u597D\u3002\u6211\u53EA\u80FD\u597D\u5947\uFF0C\u8FD9\u697C\u68AF\u7684\u5C3D\u5934\u7A76\u7ADF\u662F\u4EC0\u4E48\u3002"
  - Name: battle_9_5_2
    Text: "\u5148\u77E5\u7C73\u5C14\u514B\u5F88\u5C11\u76F4\u767D\u5730\u5199\u4F5C\uFF0C\u4F46\u5728\u6211\u627E\u5230\u7684\u4E00\u6BB5\u6B8B\u7BC7\u4E2D\uFF0C\u4ED6\u63D0\u5230\u201C\u76D6\u4E9A\u5730\u8868\u4E4B\u4E0B\u6DF1\u5904\u7684\u5B9D\u5E93\uFF0C\u6C89\u9ED8\u662F\u5F00\u542F\u5B9D\u5E93\u7684\u94A5\u5319\uFF0C\u9884\u8A00\u5728\u6B64\u4E0E\u547D\u8FD0\u76F8\u9047\u201D\u3002\u6211\u76F8\u4FE1\u4ED6\u6307\u7684\u5C31\u662F\u8FD9\u91CC\u3002\u8FD9\u8D9F\u4E0B\u884C\u4E4B\u65C5\u5E76\u975E\u53EA\u662F\u4E00\u6761\u8DEF\uFF0C\u800C\u662F\u4E00\u79CD\u4EEA\u5F0F\u3002\u6211\u4EEC\u8D8A\u63A5\u8FD1\u795E\u6BBF\uFF0C\u6211\u5C31\u8D8A\u89C9\u5F97\u6211\u4EEC\u4EFF\u4F5B\u4E0D\u4EC5\u5728\u7A7F\u8D8A\u7A7A\u95F4\u2026\u2026\u66F4\u662F\u5728\u7A7F\u8D8A\u65F6\u95F4\u672C\u8EAB\u3002\u4F60\u7684\u89C9\u9192\uFF0C\u540E\u88D4\uFF0C\u6216\u8BB8\u6B63\u662F\u8FD9\u5386\u7ECF\u6570\u767E\u5E74\u915D\u917F\u7684\u9884\u8A00\u7684\u6700\u540E\u4E00\u5757\u62FC\u56FE\u3002"
  - Name: battle_9_10_1
    Text: "\u968F\u7740\u9636\u68AF\u5EF6\u4F38\u81F3\u4E00\u4E2A\u5DE8\u5927\u7684\u53E4\u8001\u623F\u95F4\uFF0C\u9634\u5F71\u6E10\u6E10\u6D88\u6563\uFF0C\u623F\u95F4\u7684\u7A79\u9876\u9690\u6CA1\u5728\u9ED1\u6697\u4E4B\u4E2D\u3002\u811A\u4E0B\u4F20\u6765\u4E00\u9635\u8F7B\u5FAE\u7684\u9686\u9686\u58F0\uFF0C\u77F3\u677F\u5730\u9762\u5F00\u59CB\u65CB\u8F6C\uFF0C\u9519\u7EFC\u590D\u6742\u7684\u5706\u73AF\u79FB\u52A8\uFF0C\u63ED\u793A\u51FA\u65B0\u7684\u6311\u6218\u3002\u4ECE\u65CB\u8F6C\u7684\u77F3\u5757\u4E2D\u6D6E\u73B0\u51FA\u626D\u66F2\u7684\u5B88\u62A4\u8005\uFF0C\u8FD9\u4E9B\u53E4\u8001\u7684\u751F\u7269\u8A93\u6B7B\u5B88\u62A4\u7740\u524D\u65B9\u7684\u4E00\u5207\u3002"
  - Name: battle_9_10_2
    Text: "\u770B\u6765\u6211\u4EEC\u5DF2\u7ECF\u5230\u8FBE\u4E86\u8FD9\u6BB5\u6F2B\u957F\u4E0B\u6F5C\u4E4B\u65C5\u7684\u7EC8\u70B9\u2026\u2026\u4F46\u5F53\u7136\uFF0C\u8FD8\u6709\u6700\u540E\u7684\u8003\u9A8C\u3002\u6211\u4EEC\u4E0E\u6F5C\u4F0F\u5728\u6DF1\u6E0A\u4E2D\u7684\u771F\u76F8\u4E4B\u95F4\uFF0C\u8FD8\u6709\u4E00\u573A\u6700\u7EC8\u7684\u6218\u6597\u3002\u201D\u7D22\u6797\u987F\u4E86\u987F\uFF0C\u7136\u540E\u9732\u51FA\u4E86\u4E00\u4E1D\u9A84\u50B2\u7684\u5FAE\u7B11\u3002"
  - Name: battle_9_10_3
    Text: "\u8FD9\u4E2A\u5730\u65B9\u2026\u2026\u8FD9\u6BB5\u65C5\u7A0B\u2026\u2026\u503C\u5F97\u62E5\u6709\u4E00\u4E2A\u540D\u5B57\u3002\u201C\u5723\u88D4\u964D\u4E34\u201D\u3002\u6CA1\u9519\uFF0C\u6211\u559C\u6B22\u8FD9\u4E2A\u540D\u5B57\u3002\u8BA9\u6240\u6709\u540E\u6765\u8005\u77E5\u6653\uFF0C\u5723\u88D4\u5DF2\u7136\u5F52\u6765\uFF0C\u5E76\u8C31\u5199\u4E86\u4E00\u6BB5\u4F20\u5947\u3002"
  - Name: battle_10_1_1
    Text: "\u5F53\u4E24\u4EBA\u8E0F\u5165\u6D1E\u7A74\u6DF1\u5904\u65F6\uFF0C\u4ED6\u4EEC\u77AA\u5927\u4E86\u773C\u775B\u3002\u773C\u524D\u662F\u4E00\u7247\u5E7F\u88A4\u7684\u5730\u4E0B\u7A7A\u95F4\uFF0C\u8DB3\u4EE5\u5BB9\u7EB3\u4E00\u4E2A\u5B8C\u6574\u7684\u6751\u5E84\uFF0C\u6D1E\u7A74\u9876\u90E8\u9576\u5D4C\u7740\u95EA\u95EA\u53D1\u5149\u7684\u6676\u4F53\uFF0C\u5C06\u7F25\u7F08\u7684\u5149\u8292\u6D12\u5728\u53E4\u8001\u7684\u77F3\u5899\u4E0A\u3002"
  - Name: battle_10_1_2
    Text: "\u8FD9\u4E2A\u5730\u65B9\u592A\u5927\u4E86\uFF01\u7C73\u5C14\u514B\u662F\u600E\u4E48\u628A\u8FD9\u4E2A\u5730\u65B9\u9690\u85CF\u4E86\u8FD9\u4E48\u591A\u5E74\uFF1F"
  - Name: battle_10_1_3
    Text: "\u90A3\u4E2A\u540D\u53EB\u7C73\u5C14\u514B\u7684\u4EBA\u2026\u2026\u4ED6\u5E76\u975E\u51E1\u4EBA\u3002\u4ED6\u9884\u77E5\u4E00\u5207\uFF0C\u6BCF\u4E00\u6B21\u5174\u8870\uFF0C\u6BCF\u4E00\u6B21\u88C2\u75D5\u4E0E\u6C89\u5BC2\u3002\u5343\u5E74\u7684\u547D\u8FD0\uFF0C\u6700\u7EC8\u6C47\u805A\u4E8E\u6B64\u3002"
  - Name: battle_10_1_4
    Text: "\u6CBF\u7740\u5E73\u5766\u873F\u8712\u7684\u5C0F\u8DEF\u8D70\u5411\u4E2D\u592E\u7684\u5BFA\u5E99\uFF0C\u4F60\u4F1A\u770B\u5230\u77F3\u5899\u4E0A\u7ED8\u6EE1\u4E86\u58C1\u753B\uFF0C\u867D\u7136\u6709\u4E9B\u892A\u8272\uFF0C\u5374\u4F9D\u7136\u6829\u6829\u5982\u751F\u3002\u8FD9\u4E9B\u58C1\u753B\u63CF\u7ED8\u4E86\u5386\u53F2\u4E0A\u7684\u573A\u666F\u2026\u2026\u6218\u4E89\u3001\u89C9\u9192\u3001\u5143\u7D20\u5347\u534E\u3002"
  - Name: battle_10_1_5
    Text: "\u7D22\u6797\u7A81\u7136\u505C\u4E0B\u811A\u6B65\uFF0C\u5C06\u624B\u653E\u5728\u4E00\u9762\u5899\u4E0A\u3002\u201C\u770B\u770B\u8FD9\u5E45\u753B\uFF01\u753B\u91CC\u662F\u6211\u2026\u2026\u5728\u6C38\u6052\u5E9F\u589F\u4E2D\u5524\u9192\u4F60\u3002\u8FD9\u4E2A\u5730\u65B9\u2026\u2026\u4E00\u5B9A\u5145\u6EE1\u4E86\u9884\u8A00\u3002\u6216\u8005\u8BF4\uFF0C\u8574\u542B\u7740\u6211\u4EEC\u65E0\u6CD5\u7406\u89E3\u7684\u9B54\u6CD5\u3002\u8FD9\u4E00\u5207\u90FD\u662F\u7C73\u5C14\u514B\u7B56\u5212\u7684\u3002\u800C\u6211\u4EEC\u73B0\u5728\u624D\u521A\u521A\u8D76\u4E0A\u3002\u201D"
  - Name: battle_10_5_1
    Text: "\u201C\u8FD9\u4E9B\u5899\u58C1\u2026\u2026\u201D\u7D22\u6797\u4F4E\u58F0\u8BF4\u9053\uFF0C\u624B\u6307\u62C2\u8FC7\u53E6\u4E00\u5E45\u4E0D\u65AD\u53D8\u5316\u7684\u58C1\u753B\uFF0C\u201C\u5B83\u4EEC\u63CF\u7ED8\u4E86\u6211\u4EEC\u4E00\u8DEF\u8D70\u6765\u7684\u5386\u7A0B\u3002\u4ECE\u5E9F\u589F\u5230\u68EE\u6797\uFF0C\u7A7F\u8D8A\u70C8\u706B\u4E0E\u6C99\u783E\u3002\u6211\u60F3\u77E5\u9053\uFF0C\u5F53\u6211\u4EEC\u5230\u8FBE\u4E2D\u5FC3\u65F6\uFF0C\u5B83\u4EEC\u4F1A\u5411\u6211\u4EEC\u5C55\u793A\u63A5\u4E0B\u6765\u4F1A\u53D1\u751F\u4EC0\u4E48\u5417\uFF1F\u201D"
  - Name: battle_10_5_2
    Text: "\u7D22\u6797\u505C\u4E0B\u811A\u6B65\uFF0C\u76EE\u5149\u7D27\u7D27\u76EF\u7740\u524D\u65B9\u8FDC\u5904\u8000\u773C\u7684\u5149\u8292\u3002\u201C\u867D\u7136\u8FD8\u6709\u4E00\u6BB5\u8DEF\u8981\u8D70\uFF0C\u4F46\u90A3\u5149\u8292\u2026\u2026\u7EDD\u975E\u666E\u901A\u7684\u706B\u7130\u3002\u6211\u60F3\u6211\u4EEC\u5DF2\u7ECF\u8D70\u4E86\u4E00\u534A\u7684\u8DEF\u4E86\u3002\u800C\u7B49\u5F85\u7740\u6211\u4EEC\u7684\uFF0C\u6216\u8BB8\u662F\u552F\u4E00\u80FD\u591F\u963B\u6B62\u5F17\u96F7\u57FA\u5C14\u4EBA\u62B5\u8FBE\u76D6\u4E9A\u7684\u529B\u91CF\u3002\u201D"
  - Name: battle_10_5_3
    Text: "\u5F53\u4F60\u7EE7\u7EED\u524D\u884C\uFF0C\u7A7F\u8FC7\u795E\u6BBF\u7684\u8D70\u5ECA\uFF0C\u7A7A\u6C14\u4E2D\u5F25\u6F2B\u7740\u9759\u8C27\u7684\u80FD\u91CF\u3002\u8D70\u5ECA\u5728\u4F60\u811A\u4E0B\u8F7B\u8F7B\u6447\u66F3\uFF0C\u4EFF\u4F5B\u6574\u5EA7\u5EFA\u7B51\u90FD\u62E5\u6709\u751F\u547D\uFF0C\u5BF9\u4F60\u7684\u5B58\u5728\u505A\u51FA\u56DE\u5E94\u3002\u6F02\u6D6E\u7684\u7B26\u6587\u7167\u4EAE\u524D\u8DEF\uFF0C\u95EA\u70C1\u7740\u65E9\u5DF2\u88AB\u9057\u5FD8\u7684\u5143\u7D20\u8272\u5F69\u3002\u5386\u4EE3\u62C2\u6653\u8840\u76DF\u6210\u5458\u7684\u96D5\u50CF\u6392\u5217\u5728\u5899\u58C1\u4E24\u4FA7\uFF0C\u6709\u4E9B\u66FE\u5728\u58C1\u753B\u4E2D\u51FA\u73B0\uFF0C\u6709\u4E9B\u5219\u5B8C\u5168\u964C\u751F\uFF0C\u6BCF\u5C0A\u96D5\u50CF\u90FD\u6301\u6709\u529B\u91CF\u4E0E\u9884\u8A00\u7684\u9057\u7269\u3002\u968F\u7740\u4F60\u4E00\u6B65\u6B65\u8D70\u5411\u795E\u6BBF\u5149\u8292\u56DB\u5C04\u7684\u6838\u5FC3\uFF0C\u547D\u8FD0\u7684\u6C89\u91CD\u611F\u4E5F\u6108\u53D1\u5F3A\u70C8\u3002"
  - Name: battle_10_10_1
    Text: "\u5C31\u662F\u73B0\u5728\uFF01\u6211\u4EEC\u7684\u6700\u7EC8\u51B3\u6218\u2026\u2026\u5723\u88D4\uFF0C\u6211\u77E5\u9053\u8FD9\u662F\u4E00\u6BB5\u6F2B\u957F\u7684\u65C5\u7A0B\uFF0C\u4F46\u6211\u4ECE\u4E00\u5F00\u59CB\u5C31\u76F8\u4FE1\u4F60\u3002\u6211\u4EEC\u6B64\u884C\u7684\u76EE\u7684\uFF0C\u5C31\u662F\u51FB\u8D25\u8FD9\u4E9B\u602A\u7269\uFF0C\u627E\u5230\u76D6\u4E9A\u672A\u6765\u7684\u5173\u952E\u3002\u9884\u8A00\u5728\u6B64\u7EC8\u7ED3\uFF0C\u6216\u8005\u8BF4\uFF0C\u5728\u6B64\u5F00\u542F\u3002"
  - Name: battle_10_10_2
    Text: "\u7D22\u6797\u5C06\u4E00\u53EA\u624B\u642D\u5728\u4F60\u7684\u80A9\u4E0A\uFF0C\u76EE\u5149\u575A\u5B9A\u800C\u6C89\u7A33\u3002\u201C\u6211\u4EEC\u7A7F\u8D8A\u4E86\u6C38\u6052\u5E9F\u589F\uFF0C\u6F2B\u6B65\u4E8E\u4F4E\u8BED\u68EE\u6797\u7684\u5E7D\u6697\u8352\u91CE\uFF0C\u5728\u7070\u70EC\u4E4B\u95E8\u89E3\u5F00\u4E86\u53E4\u8001\u7684\u673A\u68B0\uFF0C\u52C7\u6562\u5730\u9762\u5BF9\u4E86\u5893\u5730\u6CBC\u6CFD\u7684\u6076\u81ED\u548C\u4EA1\u7075\u3002\u6211\u4EEC\u8DE8\u8D8A\u4E86\u76D6\u4E9A\u7684\u60B2\u6078\uFF0C\u6500\u767B\u4E86\u7070\u70EC\u9668\u843D\u4E4B\u73AF\uFF0C\u5E76\u6DF1\u5165\u5230\u81EA\u5D29\u584C\u4EE5\u6765\u65E0\u4EBA\u6D89\u8DB3\u7684\u6DF1\u5904\u3002\u4F60\u5728\u6BCF\u4E00\u6B21\u8003\u9A8C\u4E2D\u90FD\u8BC1\u660E\u4E86\u81EA\u5DF1\u7684\u5B9E\u529B\u3002\u8FD9\u6700\u540E\u7684\u8BD5\u70BC\u4E0D\u4EC5\u4EC5\u662F\u4E00\u573A\u6218\u6597\uFF0C\u66F4\u662F\u6574\u4E2A\u94F6\u6CB3\u7CFB\u7FD8\u9996\u4EE5\u76FC\u7684\u6700\u7EC8\u51B3\u6218\u3002\u73B0\u5728\u2026\u2026\u8BA9\u6211\u4EEC\u5B8C\u6210\u7C73\u5C14\u514B\u672A\u7ADF\u7684\u4E8B\u4E1A\u3002\u201D"
  - Name: crystal_gate_event_title
    Text: "\u6570\u4E2A\u4E16\u7EAA\u524D\uFF0C\u5728\u661F\u754C\u8054\u76DF\u7684\u672B\u65E5\uFF0C\u76D6\u4E9A\u661F\u7403\u4E0A\u6700\u5927\u4E5F\u662F\u552F\u4E00\u7684\u661F\u754C\u4E4B\u95E8\u88AB\u6467\u6BC1\uFF0C\u4EE5\u963B\u6B62\u9ED1\u6697\u5143\u7D20\u541E\u566C\u661F\u7403\u7684\u6838\u5FC3\u5143\u7D20\u3002\u661F\u754C\u4E4B\u95E8\u7834\u788E\u65F6\uFF0C\u5176\u6C34\u6676\u788E\u7247\u5982\u96E8\u822C\u6563\u843D\u76D6\u4E9A\u5404\u5730\u3002\u51E0\u4E2A\u4E16\u7EAA\u4EE5\u6765\uFF0C\u8FD9\u4E9B\u788E\u7247\u2014\u2014\u5982\u4ECA\u88AB\u79F0\u4E3A\u201C\u661F\u754C\u6C34\u6676\u201D\u2014\u2014\u88AB\u5C01\u5370\u5728\u5B9D\u7BB1\u4E2D\u6216\u65E0\u4EBA\u95EE\u6D25\uFF0C\u4EBA\u4EEC\u8BA4\u4E3A\u5B83\u4EEC\u662F\u5D29\u584C\u65F6\u9057\u7559\u4E0B\u6765\u7684\u8BC5\u5492\u6B8B\u9AB8\u3002\u4F46\u968F\u7740\u5C81\u6708\u66F4\u8FED\uFF0C\u76D6\u4E9A\u7684\u5149\u8292\u91CD\u73B0\uFF0C\u8FD9\u4E9B\u6C34\u6676\u518D\u6B21\u5F00\u59CB\u5171\u9E23\uFF0C\u53D1\u51FA\u5FAE\u5F31\u7684\u55E1\u9E23\u58F0\uFF0C\u4EFF\u4F5B\u91CD\u83B7\u80FD\u91CF\u3002\u5982\u4ECA\uFF0C\u4E16\u754C\u5404\u5730\u7684\u5546\u4EBA\u90FD\u5728\u5BFB\u627E\u8FD9\u4E9B\u9057\u7269\uFF0C\u4ED6\u4EEC\u4EE5\u7A00\u4E16\u73CD\u5B9D\u6362\u53D6\u4EFB\u4F55\u80FD\u591F\u627E\u5230\u5B83\u4EEC\u7684\u540E\u88D4\u3002"
  - Name: crystal_gate_event_summary
    Text: "\u5728\u5723\u8BDE\u8282\u548C\u65B0\u5E74\u671F\u95F4\uFF0C\u73A9\u5BB6\u53EF\u4EE5\u6536\u96C6\u76D6\u4E9A\u7834\u788E\u7684\u661F\u754C\u4E4B\u95E8\u7684\u6B8B\u9AB8\u2014\u2014\u95E8\u6C34\u6676\u788E\u7247\uFF0C\u5E76\u901A\u8FC7\u6D3B\u52A8\u5546\u4EBA\u5151\u6362\u73CD\u8D35\u7684\u5956\u52B1\u3002"
