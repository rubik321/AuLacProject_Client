    Text: "\u63D0\u5347\u9632\u5FA1\u529B{0}%\uFF0C\u751F\u547D\u503C{1}%"
  - Name: skill_passive_name_4
    Text: "\u7A7F\u523A\u7CBE\u5EA6"
  - Name: skill_passive_detail_4
    Text: "\u653B\u51FB\u529B\u63D0\u53470%\uFF0C\u751F\u547D\u503C\u63D0\u53471%\u3002"
  - Name: skill_passive_name_5
    Text: "\u575A\u4E0D\u53EF\u6467\u7684\u5B88\u536B"
  - Name: skill_passive_detail_5
    Text: "\u5BF9\u524D\u5217\u654C\u4EBA\u7684\u653B\u51FB\u529B\u4E3A 0%\uFF0C\u6709
      1% \u7684\u51E0\u7387\u4F7F\u5176\u7729\u6655 2 \u56DE\u5408\u3002"
  - Name: skill_passive_name_6
    Text: "\u654F\u9510\u7684\u76F4\u89C9"
  - Name: skill_passive_detail_6
    Text: "\u5BF9\u540E\u6392\u654C\u4EBA\u53D1\u52A8{0}%\u653B\u51FB"
  - Name: skill_passive_name_7
    Text: "\u6218\u6597\u52BF\u5934"
  - Name: skill_passive_detail_7
