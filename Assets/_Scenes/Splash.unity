  - Name: starter_pack_title
    Text: "\u5192\u9669\u8005\u5165\u95E8\u5305"
  - Name: starter_pack_des
    Text: "\u5F00\u542F\u4F60\u7684\u53F2\u8BD7\u4E4B\u65C5\uFF0C\u62A2\u5360\u5148\u673A\uFF01\u5192\u9669\u5BB6\u65B0\u624B\u5305\u5185\u542B\u5F00\u542F\u4F20\u5947\u6240\u9700\u7684\u4E00\u5207\u5FC5\u5907\u7269\u54C1\u3002\u53EA\u9700\u4F4E\u4EF7\uFF0C\u5373\u53EF\u83B7\u5F97\u65B0\u82F1\u96C4\u6240\u9700\u7684\u4E00\u5207\u3002"
  - Name: starter_pack_monster
