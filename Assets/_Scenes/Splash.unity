  - Name: item_name_2507
    Text: "\u5965\u5E03\u897F\u6D1B\u514B\u788E\u7247"
  - Name: item_name_2508
    Text: "\u5965\u5E93\u62C9\u514B\u788E\u7247"
  - Name: item_name_2509
    Text: "\u7C73\u5C14\u6C83\u514B\u788E\u7247"
  - Name: item_name_2500
    Text: "\u70DF\u7070\u788E\u7247"
  - Name: item_name_2501
    Text: "\u5723\u5149\u788E\u7247"
  - Name: item_name_2502
    Text: "\u5854\u7D22\u514B\u788E\u7247"
  - Name: item_name_2503
    Text: "\u62C9\u7EF4\u5C14\xB7\u6C99\u5FB7"
  - Name: item_name_2504
    Text: "\u6BD2\u6DB2\u788E\u7247"
  - Name: item_name_2505
    Text: "\u51EF\u8389\u8299\u62C9\xB7\u6C99\u5FB7"
  - Name: item_name_2506
    Text: "\u5FB7\u96F7\u683C\u7C73\u5C14\u788E\u7247"
  - Name: item_name_2507
    Text: "\u5965\u5E03\u897F\u6D1B\u514B\u788E\u7247"
  - Name: item_name_2508
    Text: "\u5965\u5E93\u62C9\u514B\u788E\u7247"
  - Name: item_name_2509
    Text: "\u7C73\u5C14\u6C83\u514B\u788E\u7247"
  - Name: item_insufficient_1
    Text: "\u4F60\u7684\u91D1\u5E01\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_2
    Text: "\u4F60\u7684\u80FD\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_3
    Text: "\u4F60\u7684\u5B9D\u77F3\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_4
    Text: "\u4F60\u7684\u53EC\u5524\u4EE3\u5E01\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_5
    Text: "\u60A8\u7684\u8363\u8A89\u5E01\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_6
    Text: "\u4F60\u7684\u88C5\u5907\u77F3\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_7
    Text: "\u4F60\u7684\u7ECF\u9A8C\u73A9\u5BB6\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_8
    Text: "\u4F60\u7684\u666E\u901A\u53EC\u5524\u5238\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_9
    Text: "\u60A8\u7684\u9AD8\u7EA7\u53EC\u5524\u5238\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_10
    Text: "\u4F60\u7684\u7A76\u6781\u53EC\u5524\u5238\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_11
    Text: "\u60A8\u7684\u8089\u7C7B\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_12
    Text: "\u4F60\u6CA1\u6709\u8DB3\u591F\u7684\u661F\u754C\u4E4B\u95E8\u94A5\u5319
      {0}\uFF01"
  - Name: item_insufficient_13
    Text: "\u4F60\u7684\u65C5\u884C\u8005\u5B9D\u7BB1\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_14
    Text: "\u4F60\u7684\u9A91\u58EB\u5B9D\u7BB1\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_15
    Text: "\u4F60\u7684\u82F1\u96C4\u5B9D\u7BB1\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_16
    Text: "\u4F60\u7684\u6076\u9B54\u5B9D\u7BB1\u6570\u91CF\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_17
    Text: "\u4F60\u7684\u5B9D\u7BB1\u7CBE\u901A\u7ECF\u9A8C\u503C\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_insufficient_18
    Text: "\u4F60\u7684\u6218\u6597\u661F\u4E0D\u8DB3 {0}\uFF01"
  - Name: item_des_1
    Text: "\u8FD9\u662F\u6574\u4E2A\u738B\u56FD\u901A\u7528\u7684\u4E3B\u8981\u8D27\u5E01\u3002\u53EF\u7528\u4E8E\u5347\u7EA7\u82F1\u96C4\u3001\u8D2D\u4E70\u88C5\u5907\u6216\u4E0E\u5546\u4EBA\u8FDB\u884C\u4EA4\u6613\u3002"
  - Name: item_des_2
    Text: "\u6267\u884C\u4EFB\u52A1\u3001\u6218\u6597\u6216\u8FDB\u5165\u5730\u4E0B\u57CE\u65F6\u9700\u8981\u7528\u5230\u3002\u4F1A\u968F\u65F6\u95F4\u81EA\u52A8\u6062\u590D\uFF08\u6BCF30\u5206\u949F\u6062\u590D1\u70B9\uFF09\uFF0C\u4E5F\u53EF\u4EE5\u7528\u7279\u6B8A\u7269\u54C1\u8865\u5145\u3002"
  - Name: item_des_3
    Text: "\u4E00\u79CD\u80FD\u63D0\u632F\u58EB\u6C14\u7684\u5E86\u795D\u4F73\u80B4\u3002\u7528\u4E8E\u5728\u7279\u6B8A\u6D3B\u52A8\u4E2D\u6062\u590D\u4F53\u529B\u6216\u63D0\u5347\u4E0E\u89D2\u8272\u7684\u597D\u611F\u5EA6\u3002"
  - Name: item_des_4
    Text: "\u4E00\u79CD\u9AD8\u7EA7\u8D27\u5E01\u3002\u53EF\u7528\u4E8E\u53EC\u5524\u7A00\u6709\u82F1\u96C4\u3001\u8D2D\u4E70\u4E13\u5C5E\u7269\u54C1\u6216\u52A0\u901F\u6E38\u620F\u8FDB\u7A0B\u3002"
  - Name: item_des_5
    Text: "\u5728\u53EC\u5524\u796D\u575B\u4E0A\u4F7F\u7528\u7684\u795E\u79D8\u786C\u5E01\uFF0C\u53EF\u4EE5\u53EC\u5524\u6765\u81EA\u5F02\u754C\u7684\u82F1\u96C4\u6216\u751F\u7269\u3002"
  - Name: item_des_7
    Text: "\u901A\u8FC7PvP\u6218\u6597\u548C\u516C\u4F1A\u6D3B\u52A8\u83B7\u5F97\u3002\u53EF\u5151\u6362\u72EC\u7279\u5956\u52B1\u548C\u7CBE\u82F1\u89D2\u8272\u3002"
  - Name: item_des_8
    Text: "\u4E00\u5757\u8574\u542B\u953B\u9020\u80FD\u91CF\u7684\u9B54\u6CD5\u788E\u7247\u3002\u53EF\u7528\u4E8E\u5F3A\u5316\u6216\u6253\u9020\u82F1\u96C4\u7684\u88C5\u5907\u3002"
  - Name: item_des_9
    Text: "\u7ECF\u9A8C\u503C\u7528\u4E8E\u63D0\u5347\u82F1\u96C4\u7B49\u7EA7\u3002\u901A\u8FC7\u6218\u6597\u80DC\u5229\u83B7\u5F97\u3002"
  - Name: item_des_12
    Text: "\u4E00\u5F20\u57FA\u7840\u95E8\u7968\uFF0C\u53EF\u83B7\u5F97\u4E00\u4E2A\u968F\u673A\u788E\u7247\uFF0C\u6709\u5C0F\u6982\u7387\u83B7\u5F97\u66F4\u591A\u788E\u7247\u3002"
  - Name: item_des_13
    Text: "\u4E00\u5F20\u9AD8\u7EA7\u95E8\u7968\uFF0C\u5305\u542B\u5C11\u91CF\u788E\u7247\uFF0C\u5E76\u6709\u673A\u4F1A\u83B7\u5F97\u66F4\u4E30\u539A\u7684\u5956\u52B1\u3002"
  - Name: item_des_14
    Text: "\u7EC8\u6781\u53EC\u5524\u5238\uFF0C\u63D0\u4F9B\u5927\u91CF\u788E\u7247\uFF0C\u6709\u53EF\u80FD\u83B7\u5F97\u53F2\u4E0A\u6700\u4E30\u539A\u7684\u788E\u7247\u5956\u52B1\u3002"
  - Name: item_des_15
    Text: "\u8574\u542B\u795E\u79D8\u7CBE\u534E\u7684\u8089\uFF0C\u80FD\u591F\u6ECB\u517B\u91CE\u517D\u7684\u7075\u9B42\u3002\u5582\u7ED9\u4F60\u7684\u602A\u7269\u98DF\u7528\uFF0C\u5373\u53EF\u63D0\u5347\u7B49\u7EA7\uFF0C\u53D8\u5F97\u66F4\u5F3A\u3002"
  - Name: item_des_16
    Text: "\u89E3\u9501\u7279\u6B8A\u5730\u4E0B\u57CE\u3001\u9650\u65F6\u6D3B\u52A8\u6216\u9996\u9886\u6218\u7684\u6743\u9650\u3002\u83B7\u53D6\u9AD8\u7EA7\u6218\u5229\u54C1\u548C\u6311\u6218\u7684\u5FC5\u5907\u6761\u4EF6\u3002"
  - Name: item_des_17
    Text: "\u4E00\u4E2A\u7B80\u6613\u6728\u7BB1\uFF0C\u5185\u542B\u57FA\u7840\u6218\u5229\u54C1\uFF0C\u5305\u62EC\u5C11\u91CF\u91D1\u5E01\u3001\u88C5\u5907\u77F3\u548C\u602A\u7269\u788E\u7247\u3002\u975E\u5E38\u9002\u5408\u6E38\u620F\u521D\u671F\u4F7F\u7528\u3002"
  - Name: item_des_18
    Text: "\u666E\u901A\u5B9D\u7BB1\uFF0C\u5956\u52B1\u66F4\u4E30\u539A\u3002\u5185\u542B\u66F4\u591A\u91D1\u5E01\u3001\u5347\u7EA7\u7248\u88C5\u5907\u77F3\u548C\u602A\u7269\u788E\u7247\u3002"
  - Name: item_des_19
    Text: "\u4E00\u4E2A\u88C5\u6EE1\u5B9D\u7269\u7684\u73CD\u8D35\u5B9D\u7BB1\u3002\u53EF\u83B7\u5F97\u5927\u91CF\u91D1\u5E01\u3001\u9AD8\u7EA7\u88C5\u5907\u77F3\u548C\u602A\u7269\u788E\u7247\u3002"
  - Name: item_des_20
    Text: "\u9876\u7EA7\u5B9D\u7BB1\u3002\u5185\u542B\u5927\u91CF\u91D1\u5E01\u3001\u88C5\u5907\u77F3\u548C\u602A\u7269\u788E\u7247\u3002"
  - Name: item_des_21
    Text: "\u5F00\u542F\u5B9D\u7BB1\u53EF\u83B7\u5F97\u7ECF\u9A8C\u503C\u3002\u79EF\u7D2F\u7ECF\u9A8C\u5B9D\u7BB1\u53EF\u63D0\u5347\u4F60\u7684\u5B9D\u7BB1\u719F\u7EC3\u5EA6\u7B49\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u597D\u7684\u5B9D\u7BB1\u5956\u52B1\u3002"
  - Name: item_des_22
    Text: "\u8FD9\u4E9B\u95EA\u8000\u7684\u661F\u661F\u8C61\u5F81\u7740\u4F60\u5728\u6218\u6597\u4E2D\u7684\u82F1\u52C7\u2014\u2014\u6536\u96C6\u5B83\u4EEC\uFF0C\u63D0\u5347\u6218\u6597\u901A\u884C\u8BC1\u91CC\u7A0B\u7891\uFF0C\u8D62\u53D6\u4E13\u5C5E\u5B9D\u7269\u3002"
  - Name: item_des_23
    Text: "\u7528\u4E8E\u5728\u7ADE\u6280\u573A\u6311\u6218\u5BF9\u624B\u3002\u6BCF\u6B21\u6218\u6597\u6D88\u8017\u4E00\u5F20\u95E8\u7968\u3002\u95E8\u7968\u6BCF\u5C0F\u65F6\u81EA\u52A8\u6062\u590D\u3002"
  - Name: item_des_1000
    Text: "\u4E00\u5F20\u8574\u542B\u7740\u9F99\u9B54\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1001
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u7279\u6E29\u65AF\u62C9\u514B\u65AF\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1002
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u4E09\u773C\u602A\u7CBE\u9AD3\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u4E00\u65E0\u4E8C\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1003
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5E03\u9C81\u897F\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1004
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5E03\u62C9\u8FEA\u4E9A\u7279\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1005
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5E03\u9C81\u6258\u514B\u8428\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1006
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u6BDB\u7ED2\u52A8\u7269\u7CBE\u534E\u7684\u5361\u7247\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u53EA\u6709\u6301\u6709\u6B64\u5361\u7684\u4EBA\u624D\u80FD\u4E0E\u8FD9\u53EA\u602A\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1007
    Text: "\u4E00\u5F20\u8574\u542B\u7740\u70C8\u7130\u517D\u7CBE\u534E\u7684\u5361\u7247\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u8005\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1008
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u76AE\u7F57\u8BFA\u514B\u65AF\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1009
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u514B\u62C9\u683C\u8FC8\u7279\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1010
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u8428\u8BFA\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1011
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u8D1D\u5FB7\u62C9\u5E93\u5C14\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u7269\u4E3A\u4F60\u800C\u6218\u3002\u53EA\u6709\u6301\u6709\u6B64\u5361\u7684\u4EBA\u624D\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u5951\u7EA6\u3002"
  - Name: item_des_1500
    Text: "\u4E00\u5F20\u8574\u542B\u70DF\u5F71\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1501
    Text: "\u4E00\u5F20\u8574\u542B\u7740\u6208\u5229\u514B\u65AF\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1502
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5854\u7D22\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1503
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u62C9\u7EF4\u5C14\u7CBE\u534E\u7684\u5361\u7247\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u53EA\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u624D\u80FD\u4E0E\u8FD9\u53EA\u602A\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1504
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u7EF4\u8BFA\u6885\u5C14\u62C9\u7CBE\u534E\u7684\u5361\u7247\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u53EA\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u624D\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1505
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u51EF\u8389\u8299\u62C9\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1506
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5FB7\u96F7\u683C\u8FC8\u5C14\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1507
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u5965\u5E03\u897F\u6D1B\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1508
    Text: "\u4E00\u5F20\u8574\u542B\u7740\u5965\u5E93\u62C9\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_1509
    Text: "\u4E00\u5F20\u6CE8\u5165\u4E86\u7C73\u5C14\u6C83\u514B\u7CBE\u534E\u7684\u5361\u724C\u3002\u5C06\u5176\u732E\u796D\u4E8E\u53EC\u5524\u796D\u575B\uFF0C\u5373\u53EF\u53EC\u5524\u8FD9\u53EA\u72EC\u7279\u7684\u602A\u517D\u4E0E\u4F60\u5E76\u80A9\u4F5C\u6218\u3002\u552F\u6709\u6301\u6709\u6B64\u5361\u4E4B\u4EBA\uFF0C\u65B9\u80FD\u4E0E\u8FD9\u5934\u5DE8\u517D\u7F14\u7ED3\u7F81\u7ECA\u3002"
  - Name: item_des_2000
    Text: "\u4E00\u5757\u8574\u542B\u7740\u9F99\u65CF\u529B\u91CF\u788E\u7247\u7684\u77F3\u5757\u3002\u6536\u96C6\u8DB3\u591F\u7684\u77F3\u5757\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u9F99\u65CF\u5DE8\u517D\u3001\u53CC\u9F99\u6216\u4E09\u9F99\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2001
    Text: "\u4E00\u5757\u8574\u542B\u718A\u65CF\u529B\u91CF\u788E\u7247\u7684\u77F3\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u77F3\u7247\uFF0C\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5E03\u9C81\u897F\u514B\u3001\u5E03\u62C9\u8FEA\u4E9A\u7279\u6216\u5E03\u9C81\u6258\u514B\u8428\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2002
    Text: "\u4E00\u5757\u8574\u542B\u91D1\u725B\u5EA7\u7CBE\u795E\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u6BDB\u7ED2\u7ED2\u3001\u706B\u7130\u718A\u6216\u706B\u9F99\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2003
    Text: "\u4E00\u5757\u8574\u542B\u86DB\u5F62\u7EB2\u52A8\u7269\u7CBE\u534E\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u514B\u62C9\u683C\u8FC8\u7279\u3001\u8428\u8BFA\u514B\u6216\u8D1D\u5FB7\u62C9\u5E93\u5C14\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2004
    Text: "\u4E00\u5757\u8574\u542B\u72FC\u9B42\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u88C2\u989A\u3001\u5E03\u83B1\u56E0\u7259\u6216\u7459\u745F\u62C9\u514B\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2005
    Text: "\u4E00\u5757\u8574\u542B\u4ED9\u4EBA\u638C\u7CBE\u534E\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u74E6\u8BFA\u514B\u3001\u74E6\u8BFA\u5361\u6216\u74E6\u8BFA\u5361\u5C3C\u514B\u65AF\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2006
    Text: "\u4E00\u5757\u8574\u542B\u9F9F\u7CBE\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u5E03\u4F26\u6CF0\u5FB7\u3001\u5E03\u9C81\u56FE\u65AF\u514B\u6216\u5E03\u9C81\u5854\u739B\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2007
    Text: "\u4E00\u5757\u8574\u542B\u7740\u9F99\u65CF\u7CBE\u534E\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u65AF\u7279\u62C9\u585E\u514B\u65AF\u3001\u65AF\u7279\u62C9\u585E\u68EE\u6216\u65AF\u7279\u62C9\u585E\u514B\u8428\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2008
    Text: "\u4E00\u5757\u8574\u542B\u7740\u9F99\u65CF\u7CBE\u534E\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u5E03\u83B1\u5179\u3001\u5E03\u83B1\u5179\u6069\u6216\u5E03\u83B1\u4F50\u5C14\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2009
    Text: "\u4E00\u5757\u8574\u542B\u68EE\u6797\u7CBE\u7075\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u6D77\u5C14\u52A0\u3001\u6D77\u5C14\u5FB7\u6216\u80E1\u5C14\u5FB7\u62C9\u7684\u661F\u7EA7\uFF0C\u91CA\u653E\u5B83\u4EEC\u7684\u529B\u91CF\u3002"
  - Name: item_des_2500
    Text: "\u4E00\u5757\u8574\u542B\u7740\u70DF\u5F71\u529B\u91CF\u788E\u7247\u7684\u77F3\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2501
    Text: "\u4E00\u5757\u8574\u542B\u7740\u6208\u5229\u514B\u65AF\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2502
    Text: "\u4E00\u5757\u8574\u542B\u7740\u5854\u7D22\u514B\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2503
    Text: "\u4E00\u5757\u8574\u542B\u7740\u62C9\u7EF4\u5C14\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4EE5\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2504
    Text: "\u4E00\u5757\u8574\u542B\u7740\u7EF4\u8BFA\u6885\u5C14\u62C9\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2505
    Text: "\u4E00\u5757\u8574\u542B\u7740\u51EF\u8389\u8299\u62C9\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4EE5\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2506
    Text: "\u4E00\u5757\u8574\u542B\u7740\u5FB7\u96F7\u683C\u8FC8\u5C14\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2507
    Text: "\u4E00\u5757\u8574\u542B\u7740\u5965\u5E03\u897F\u6D1B\u514B\u90E8\u5206\u529B\u91CF\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2508
    Text: "\u4E00\u5757\u8574\u542B\u7740\u5965\u5E93\u62C9\u514B\u529B\u91CF\u788E\u7247\u7684\u77F3\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u77F3\u7247\u53EF\u4EE5\u8FDB\u5316\u6216\u63D0\u5347\u5176\u661F\u7EA7\uFF0C\u4ECE\u800C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: item_des_2509
    Text: "\u4E00\u5757\u8574\u542B\u7740\u7C73\u5C14\u6C83\u514B\u529B\u91CF\u788E\u7247\u7684\u788E\u7247\u3002\u6536\u96C6\u8DB3\u591F\u7684\u788E\u7247\u5373\u53EF\u8FDB\u5316\u6216\u63D0\u5347\u661F\u7EA7\uFF0C\u83B7\u5F97\u66F4\u5F3A\u5927\u7684\u529B\u91CF\u3002"
  - Name: stat_name_0
    Text: "\u653B\u51FB"
  - Name: stat_name_1
    Text: "\u9632\u5FA1"
  - Name: stat_name_2
    Text: "\u901F\u5EA6"
  - Name: stat_name_3
    Text: "\u5065\u5EB7"
  - Name: stat_name_4
    Text: "\u529B\u91CF"
  - Name: stat_des_0
    Text: "\u51B3\u5B9A\u5BF9\u654C\u4EBA\u9020\u6210\u7684\u4F24\u5BB3\u91CF\u3002"
  - Name: stat_des_1
    Text: "\u51CF\u5C11\u53D7\u5230\u7684\u654C\u65B9\u653B\u51FB\u4F24\u5BB3\u3002"
  - Name: stat_des_2
    Text: "\u51B3\u5B9A\u56DE\u54CD\u5728\u56DE\u5408\u4E2D\u7684\u653B\u51FB\u987A\u5E8F\u3002"
  - Name: stat_des_3
    Text: "\u51B3\u5B9A\u82F1\u96C4\u5728\u88AB\u51FB\u8D25\u524D\u80FD\u591F\u627F\u53D7\u591A\u5C11\u4F24\u5BB3\u3002"
  - Name: hero_stats_title
    Text: "\u82F1\u96C4\u5C5E\u6027"
  - Name: hero_stats_desc
    Text: "<b><sprite name=\"icon_might_flat\">\u529B\u91CF\uFF1A</b>\u51B3\u5B9A\u82F1\u96C4\u5728\u6218\u6597\u4E2D\u7684\u57FA\u7840\u4F24\u5BB3\u8F93\u51FA\u3002\r\n<b><sprite
      name=\"icon_hp_flat\">\u751F\u547D\u503C\uFF1A</b>\u63D0\u5347\u961F\u4F0D\u7684\u6700\u5927\u751F\u547D\u503C\uFF0C\u5E2E\u52A9\u4ED6\u4EEC\u66F4\u6301\u4E45\u5730\u751F\u5B58\u3002\r\n<b><sprite
      name=\"icon_spd_flat\">\u901F\u5EA6\uFF1A</b>\u63D0\u5347\u961F\u4F0D\u7684\u901F\u5EA6\uFF0C\u4F7F\u4ED6\u4EEC\u80FD\u591F\u5728\u6218\u6597\u4E2D\u5148\u53D1\u5236\u4EBA\u3002\r\n\r\n<b><size=80%>**\u751F\u547D\u503C\u548C\u901F\u5EA6\u4E0E\u9635\u5BB9\u4E2D\u7684\u6240\u6709\u602A\u7269\u5171\u4EAB\uFF0C\u4ECE\u800C\u589E\u5F3A\u6574\u4E2A\u961F\u4F0D\u3002**</size></b>"
