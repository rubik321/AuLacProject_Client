  - Name: passive_skill_detail
    Text: "\u88AB\u52A8\u6280\u80FD\u4F1A\u6839\u636E\u6761\u4EF6\u81EA\u52A8\u89E6\u53D1\u3002"
  - Name: active_skill_detail
    Text: "*\u4E3B\u52A8\u6280\u80FD\u4F1A\u5728\u80FD\u91CF\u5145\u6EE1\u4E14\u56DE\u5408\u5F00\u59CB\u65F6\u89E6\u53D1\u3002*"
