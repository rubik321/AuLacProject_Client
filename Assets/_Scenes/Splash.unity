    Text: "\u7B2C{0}\u5929"
  - Name: portal_title
    Text: "\u661F\u754C\u4E4B\u95E8"
  - Name: portal_des
    Text: "\u5728\u53E4\u8001\u7684{0}\u5927\u9646\u4E0A\uFF0C\u4E00\u9053\u540D\u4E3A\u661F\u754C\u4E4B\u95E8\u7684\u5929\u754C\u88C2\u9699\u82CF\u9192\u2014\u2014\u8FD9\u662F\u4E00\u6247\u8FDE\u63A5\u4E0D\u540C\u9886\u57DF\u7684\u95E8\u6237\uFF0C\u65F6\u95F4\u672C\u8EAB\u90FD\u4E3A\u4E4B\u98A4\u6296\u3002\u5B83\u7531\u88AB\u9057\u5FD8\u7684\u661F\u5EA7\u5B55\u80B2\u800C\u751F\uFF0C\u5E76\u7531\u8FDC\u53E4\u5B88\u62A4\u8005\u5C01\u5370\uFF0C\u56DE\u8361\u7740\u65E0\u6570\u65E9\u5DF2\u6E6E\u6CA1\u4E8E\u5386\u53F2\u957F\u6CB3\u4E2D\u7684\u4E16\u754C\u7684\u56DE\u54CD\u3002\u5F53\u661F\u754C\u4E4B\u95E8\u5F00\u542F\uFF0C\u200B\u200B\u5929\u7A7A\u88AB\u5149\u8292\u7167\u4EAE\uFF0C\u5B88\u95E8\u4EBA\u4ECE\u4E2D\u73B0\u8EAB\u2014\u2014\u4E00\u4E2A\u7531\u661F\u5149\u4E0E\u9634\u5F71\u953B\u9020\u800C\u6210\u7684\u5B58\u5728\uFF0C\u6CE8\u5B9A\u8981\u8003\u9A8C\u6240\u6709\u80C6\u6562\u9760\u8FD1\u4E4B\u4EBA\u7684\u52C7\u6C14\u3002\u6BCF\u4E00\u6B21\u653B\u51FB\u90FD\u4F1A\u5728\u865A\u7A7A\u4E2D\u56DE\u8361\uFF0C\u8FD9\u4E0D\u4EC5\u662F\u5BF9\u529B\u91CF\u7684\u8003\u9A8C\uFF0C\u66F4\u662F\u5BF9\u51B3\u5FC3\u7684\u8BD5\u70BC\u3002"
  - Name: portal_unknow_local
    Text: "\u9ED8\u514B"
  - Name: portal_guide
    Text: "\u8FDE\u63A5\u4E24\u4E2A\u4E16\u754C\u7684\u795E\u79D8\u4F20\u9001\u95E8\u3002\u95E8\u5185\u6F5C\u4F0F\u7740\u5B88\u95E8\u4EBA\u2014\u2014\u4E00\u4F4D\u5A01\u80C1\u7740\u4F60\u9886\u57DF\u7684\u5F3A\u5927\u5B88\u62A4\u8005\u3002\u5B88\u95E8\u4EBA\u8D8A\u5F3A\u5927\uFF0C\u6311\u6218\u5C31\u8D8A\u5927\u2026\u2026\u5956\u52B1\u4E5F\u8D8A\u4E30\u539A\u3002\r\n<size=70%><size=70%><sprite
      name=\"icon_portal_brown\"></size> </size>\u8981\u8FDB\u5165\uFF0C\u4F60\u5FC5\u987B\u4F7F\u7528<b>\u661F\u754C\u4E4B\u95E8\u94A5\u5319</b>\u3002<b>\u661F\u754C\u4E4B\u95E8\u94A5\u5319</b>\u6BCF\u65E5<b>00:00
      (GMT+0)</b>\u6062\u590D3\u628A\u3002</b>\u672A\u4F7F\u7528\u7684\u94A5\u5319<b>\u65E0\u6CD5\u4FDD\u7559</b>\u81F3\u7B2C\u4E8C\u5929\u3002\r\n<size=70%><sprite
      name=\"icon_portal_brown\"></size>\u5927\u95E8\u4E00\u65E6\u5F00\u542F\uFF0C<b>\u6301\u7EED24\u5C0F\u65F6</b>\u3002\r\n<size=70%><sprite
      name=\"icon_portal_brown\"></size>\u6BCF\u6B21\u6311\u6218\u5C1D\u8BD5<b>\u6BCF\u5C0F\u65F6\u6062\u590D</b>\uFF0C<b>\u6700\u591A\u53EF\u5B58\u50A820\u6B21\u5C1D\u8BD5</b>\u3002\r\n<size=70%><sprite
      name=\"icon_portal_brown\"></size>\u5927\u95E8\u5173\u95ED1\u5C0F\u65F6\u540E\u53EF<b>\u91CD\u65B0\u5F00\u542F</b>\u3002\r\n<size=70%><sprite
      name=\"icon_portal_brown\"></size> <b>\u51FB\u8D25\u5B88\u95E8\u4EBA\u540E\uFF0C\u5956\u52B1\u5C06\u901A\u8FC7\u90AE\u4EF6\u53D1\u9001</b>\u3002\r\n<size=70%><sprite
      name=\"icon_portal_brown\"></size> <b>\u6218\u6597\u6392\u540D\u51B3\u5B9A\u4F60\u7684\u6700\u7EC8\u5B9D\u85CF</b>
