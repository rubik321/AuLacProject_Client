  m_EditorClassIdentifier: 
  ID: 21
  uiText: {fileID: 757664301549254576}
  letterDelay: 0.01
  fullText: "These Echoes are not mindless beasts. They were once allies, companions\u2026
    guardians. But the Great Collapse twisted the bond. Many now wander lost, consumed
    by elemental chaos.  Now you must fight, and collect their essence and then train
    them to fight by your side once more. "
